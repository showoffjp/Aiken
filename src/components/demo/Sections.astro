---
// Renders the list of content sections for a concept, in order.
import Icon from '../Icon.astro';
import Seal from './Seal.astro';
import { title, sectionId, srcset, isScenic, cinematicHero, tint, type Demo, type Img } from '../../lib/demos';
interface Props { demo: Demo }
const { demo } = Astro.props;
const cine = !!demo.cinematic;
// A story with no photo gets the business's round seal beside it, so the section is never a lone column of text.
const sealTop = demo.short || demo.name;
const sealBottom = [demo.town.replace(/,?\s*SC$/i, ', South Carolina'), demo.established ? `Est. ${demo.established}` : ''].filter(Boolean).join(' · ');
const pad = (n: number) => String(n).padStart(2, '0');
// Cinematic galleries: up to five screen-filling photos become pinned scenes;
// the rest go into a parallax mosaic, and everything into a scrolling reel.
const heroSrc = cine ? cinematicHero(demo)?.src : undefined;
const split = (imgs: Img[]) => {
  const scenes = imgs.filter((i) => isScenic(i) && i.src !== heroSrc).slice(0, 5);
  const rest = imgs.filter((i) => !scenes.includes(i));
  const cols: Img[][] = [[], [], []];
  rest.forEach((img, k) => cols[k % 3].push(img));
  return { scenes, rest, cols };
};
// One statement section per page in a deep gradient of the theme colours:
// reviews or steps if there are any, else a later section, never the first
// (it follows the facts band) and never the closing band.
const kinds = demo.sections.map((s) => s.type);
const pick = (t: string[]) => kinds.findIndex((k, j) => t.includes(k) && j > 0);
let deepIdx = demo.sections.length < 3 ? -1 : [pick(['quotes', 'steps']), pick(['columns', 'faq', 'story']), pick(['services', 'menu'])].find((j) => j > 0) ?? -1;
// Short pages: the first section, unless the facts band right above is already deep.
if (deepIdx < 0 && kinds.length >= 2 && (demo.style?.facts || !demo.facts?.length) && ['services', 'columns', 'story', 'menu', 'steps', 'quotes'].includes(kinds[0])) deepIdx = 0;
// Cinematic pages are dark-led already.
if (cine) deepIdx = -1;
---
{demo.sections.map((s, i) => {
  const id = sectionId(s, i);
  const alt = `${i % 2 === 1 ? 'alt' : ''} ${i === deepIdx ? 'fx-deep' : ''}`;
  if (s.type === 'services') return (
    <section class={`section ${alt}`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
          {s.intro && <p>{s.intro}</p>}
        </div>
        {s.style === 'list' ? (
          <ul class="rows">
            {s.items.map((it) => (
              <li>
                <Icon name={it.icon || 'check'} size={22} />
                <div><h3>{it.title}</h3>{it.text && <p>{it.text}</p>}</div>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="cards" style={`--cols:${s.columns || 3}`}>
            {s.items.map((it) => (
              <li class="card">
                {it.icon && <div class="badge"><Icon name={it.icon} size={24} /></div>}
                <h3>{it.title}</h3>
                {it.text && <p>{it.text}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  );
  if (s.type === 'story') return (
    <section class={`section story ${alt} ${s.flip ? 'flip' : ''} ${s.image ? '' : 'solo'} ${s.image?.width && s.image?.height && s.image.width / s.image.height > 2.3 ? 'pano' : ''}`} id={id}>
      <div class="wrap">
        {s.image && (
          <div class="story-media" data-par="">
            <img style={tint(s.image)} src={s.image.src} srcset={srcset(s.image)} sizes="(max-width: 860px) 92vw, 46vw" alt={s.image.alt} width={s.image.width} height={s.image.height} class={s.image.fit === 'contain' ? 'contain' : ''} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="body">
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
          {s.body.map((p) => <p>{p}</p>)}
          {s.list && (
            <ul class="ticks">
              {s.list.map((l) => <li><Icon name="check" size={20} stroke={2.4} /><span>{l}</span></li>)}
            </ul>
          )}
          {s.quote && <blockquote class="pull">{s.quote.text}{s.quote.by && <cite>{s.quote.by}</cite>}</blockquote>}
        </div>
        {!s.image && (
          <div class="story-seal" aria-hidden="true">
            <span class="story-glow"></span>
            <Seal top={sealTop} bottom={sealBottom} icon={demo.icon} id={`seal-${demo.slug}-${i}`} />
          </div>
        )}
      </div>
    </section>
  );
  if (s.type === 'menu') {
    // Long menus get a row of chips to jump between groups (it sticks under the header on phones),
    // and any menu or price list of five or more items can be printed on its own.
    const items = s.groups.reduce((n, g) => n + g.items.length, 0);
    const food = demo.group === 'Food & Drink';
    const priced = s.groups.some((g) => g.items.some((it) => it.price));
    const printable = items >= 5 && (food || priced);
    return (
    <section class={`section ${alt} menu-sec`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
          {s.intro && <p>{s.intro}</p>}
        </div>
        {s.groups.length >= 3 && (
          <nav class="menu-jump" aria-label={`${s.nav || 'Menu'} sections`} data-menu-jump>
            {s.groups.map((g, k) => <a href={`#${id}-g${k}`}>{g.title}</a>)}
          </nav>
        )}
        <div class={`menu-groups${s.groups.length === 1 ? ' solo' : ''}`}>
          {s.groups.map((g, k) => (
            <div class="menu-group" id={`${id}-g${k}`}>
              <h3>{g.title}{g.note && <small>{g.note}</small>}</h3>
              <ul>
                {g.items.map((it) => (
                  <li>
                    <div class="line"><span>{it.name}</span>{it.price && <><i></i><span class="price">{it.price}</span></>}</div>
                    {it.desc && <p>{it.desc}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {s.footnote && <p class="footnote">{s.footnote}</p>}
        {printable && <p class="menu-print"><button class="chip" type="button" data-print-menu><Icon name="printer" size={17} stroke={2.1} />{food ? 'Print the menu' : 'Print these prices'}</button></p>}
      </div>
    </section>
    );
  }
  if (s.type === 'gallery' && cine && split(s.images).scenes.length >= 2) {
    const { scenes, rest, cols } = split(s.images);
    return (
      <section class="cine-gallery" id={id}>
        <div class="wrap">
          <div class="section-head" data-label={s.nav || ''}>
            {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
            <h2 set:html={title(s.title)} />
            {s.intro && <p>{s.intro}</p>}
          </div>
        </div>
        <div class="cine-track" style={`--n:${scenes.length}`} data-cine-track>
          {scenes.map((img, k) => (
            <figure class="scene">
              <div class="scene-inner">
                <img style={tint(img)} src={img.src} srcset={srcset(img)} sizes="100vw" alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
                <div class="scene-veil" aria-hidden="true"></div>
              </div>
              <figcaption><span class="scene-num" aria-hidden="true">{pad(k + 1)} / {pad(scenes.length)}</span><span class="scene-cap">{img.alt}</span></figcaption>
            </figure>
          ))}
        </div>
        {rest.length > 0 && (
          <div class="wrap">
            <div class="cine-mosaic" data-par>
              {cols.map((col, c) => (
                <div class="mosaic-col" style={`--speed:${[-1, 0.6, -0.4][c]}`}>
                  {col.map((img) => <figure><img style={tint(img)} src={img.src} srcset={srcset(img)} sizes="(max-width: 760px) 46vw, 30vw" alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" /></figure>)}
                </div>
              ))}
            </div>
          </div>
        )}
        <div class="cine-reel" aria-hidden="true" data-par>
          <div class="reel-row">{[...s.images, ...s.images].map((img) => <img style={tint(img)} src={img.src} srcset={srcset(img)} sizes="240px" alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />)}</div>
        </div>
      </section>
    );
  }
  if (s.type === 'gallery') return (
    <section class={`section ${alt}`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
          {s.intro && <p>{s.intro}</p>}
        </div>
        <div class="gallery">
          {s.images.map((img, n) => {
            const ratio = img.width && img.height ? img.width / img.height : 1;
            const shape = ratio > 1.55 && n % 3 === 0 ? 'wide' : ratio < 0.72 ? 'tall' : '';
            return <figure class={shape} data-par=""><img style={tint(img)} src={img.src} srcset={srcset(img)} sizes={shape === 'wide' ? '(max-width: 760px) 92vw, 46vw' : '(max-width: 760px) 46vw, 23vw'} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" /></figure>;
          })}
        </div>
      </div>
    </section>
  );
  if (s.type === 'steps') return (
    <section class={`section ${alt}`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
          {s.intro && <p>{s.intro}</p>}
        </div>
        <ol class="steps" style="list-style:none;margin:0;padding:0">
          {s.items.map((it) => <li><h3>{it.title}</h3><p>{it.text}</p></li>)}
        </ol>
      </div>
    </section>
  );
  if (s.type === 'quotes') return (
    <section class={`section ${alt}`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
        </div>
        <div class="quotes">
          {s.items.map((q) => <figure><blockquote>{q.text}</blockquote>{q.by && <figcaption>{q.by}</figcaption>}</figure>)}
        </div>
      </div>
    </section>
  );
  if (s.type === 'faq') return (
    <section class={`section ${alt}`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
        </div>
        <div class="faq">
          {s.items.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>
  );
  if (s.type === 'columns') return (
    <section class={`section ${alt}`} id={id}>
      <div class="wrap">
        <div class="section-head" data-label={s.nav || ''}>
          {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
          <h2 set:html={title(s.title)} />
          {s.intro && <p>{s.intro}</p>}
        </div>
        <div class="cols">
          {s.columns.map((c) => <div><h3>{c.title}</h3><ul>{c.items.map((x) => <li>{x}</li>)}</ul></div>)}
        </div>
      </div>
    </section>
  );
  if (s.type === 'band') return (
    <section class="band" id={id}>
      <div class="wrap">
        <div><h2 set:html={title(s.title)} />{s.text && <p>{s.text}</p>}</div>
        {s.cta && <a class="btn" href={s.cta.href}>{s.cta.label}<Icon name="arrow-right" size={18} stroke={2.2} /></a>}
      </div>
    </section>
  );
})}
