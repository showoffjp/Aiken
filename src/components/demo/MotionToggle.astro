---
// Pause or play every animation on the page (WCAG 2.2.2: moving content that
// starts by itself and lasts more than five seconds needs a way to stop it).
// All toggles on the page share one setting, remembered on this device.
interface Props { variant?: 'icon' | 'link' }
const { variant = 'icon' } = Astro.props;
---
{variant === 'icon' ? (
  <button class="motion-btn" type="button" data-motion-toggle aria-pressed="false" aria-label="Pause animations" title="Pause animations">
    <svg class="mi-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
    <svg class="mi-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
  </button>
) : (
  <button class="motion-link" type="button" data-motion-toggle aria-pressed="false">Pause animations</button>
)}
