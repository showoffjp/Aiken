---
// The living background behind a hero: a slow mesh gradient in the concept's
// own colours, a glow that follows the pointer, film grain, sparkles, and
// glassy badges carrying the business's own service icons that float at
// different depths (parallax on scroll and pointer). Purely decorative.
import Icon from '../Icon.astro';
import { brandIcons, type Demo } from '../../lib/demos';
interface Props { demo: Demo; tone?: 'light' | 'dark'; kind?: string }
const { demo, tone = 'light', kind = 'split' } = Astro.props;
const icons = brandIcons(demo, 5);
// Depth per badge: bigger numbers move more, negative ones drift the other way.
const depth = [0.55, -0.35, 0.3, 0.75, -0.2];
const size = [30, 26, 22, 34, 20];
const spark = 'M12 1.5c.6 5.2 3.3 8 8.5 8.6-5.2.6-7.9 3.3-8.5 8.5-.6-5.2-3.3-7.9-8.5-8.5 5.2-.6 7.9-3.4 8.5-8.6z';
---
<div class={`fx fx-${tone}`} data-fx data-kind={kind} aria-hidden="true">
  <div class="fx-mesh"></div>
  <div class="fx-glow"></div>
  <div class="fx-grain"></div>
  <span class="fx-ring g1" style="--z:.25"></span>
  <span class="fx-ring g2" style="--z:-.18"></span>
  <span class="fx-dots" style="--z:.12"></span>
  {icons.map((ic, k) => (
    <span class={`fx-tok t${k}`} style={`--z:${depth[k]}`}><i style={`--d:${k * -1.3}s`}><Icon name={ic} size={size[k]} stroke={1.6} /></i></span>
  ))}
  {[0, 1, 2, 3, 4].map((k) => (
    <svg class={`fx-spark s${k}`} style={`--z:${[0.4, -0.3, 0.6, 0.2, -0.5][k]};--d:${k * -0.9}s`} viewBox="0 0 24 24"><path d={spark} /></svg>
  ))}
</div>
