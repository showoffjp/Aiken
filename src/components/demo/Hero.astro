---
// Distinct hero compositions, chosen per concept with style.hero, so concepts
// do not all open the same way. Every variant uses only the concept's own
// content: title, lede, calls to action, points, facts, contact, menu or services.
import Icon from '../Icon.astro';
import Decor from './Decor.astro';
import { ratio } from '../../lib/contrast';
import { title, telHref, offerWords, brandIcons, type Demo } from '../../lib/demos';
interface Props { demo: Demo; kind: string }
const { demo, kind } = Astro.props;
const { hero, contact } = demo;
const short = demo.short || demo.name;
const town = demo.town.replace(/,\s*SC$/i, '');

// Words for marquees and lists, from what the business actually offers.
const services = (demo.sections.find((s: any) => s.type === 'services') as any)?.items?.map((i: any) => i.title) || [];
const menuGroup = (demo.sections.find((s: any) => s.type === 'menu') as any)?.groups?.[0];
const words: string[] = offerWords(demo, 8);
const board: { name: string; price?: string }[] = menuGroup?.items?.slice(0, 6).map((i: any) => ({ name: i.name, price: i.price })) || (services.length ? services : words).slice(0, 6).map((n: string) => ({ name: n }));
const boardTitle = menuGroup?.title || 'On the board';
const hours = contact.hours?.slice(0, 2) || [];
// The bento scene's orbiting icons: the business's own, minus its emblem.
const orbit = [...brandIcons(demo, 6), 'sparkles', 'heart', 'star', 'map-pin'].filter((v, k, a) => a.indexOf(v) === k && v !== demo.icon).slice(0, 4);
const facts = demo.facts || [];
// Floating decor is light glass on dark grounds, tinted glass on light ones.
const onDarkPrimary = ratio('#ffffff', demo.colors.primary) >= ratio('#111111', demo.colors.primary);
const est = demo.established ? `Est. ${demo.established}` : '';
// A factual fallback for the masthead: the street the business is on.
const street = (demo.contact.address?.[0] || '').replace(/^\d+[A-Za-z]?\s+/, '').trim();

// Giant type sized to the words it has to hold: the longest word always fits
// the page width, so a long name never runs off the edge.
const UPPER: Record<string, number> = { unbounded: 0.98, anybody: 0.8, syne: 0.8, archivo: 0.74, 'space-grotesk': 0.72, 'bricolage-grotesque': 0.7, fredoka: 0.7, outfit: 0.7, oswald: 0.56, 'big-shoulders-display': 0.52 };
const LOWER: Record<string, number> = { cormorant: 0.46, unbounded: 0.8, anybody: 0.62, syne: 0.64 };
const plain = (t: string) => t.replace(/\*/g, '');
const words_ = (t: string) => plain(t).split(/\s+/).filter(Boolean);
const longest = (t: string) => Math.max(...words_(t).map((w) => w.length));
const fit = (chars: number, cw: number) => `calc(min(100vw - 2 * var(--gutter), var(--wrap)) / ${(chars * cw * 1.06).toFixed(2)})`;
const cwU = UPPER[demo.fonts.display] ?? 0.72, cwL = LOWER[demo.fonts.display] ?? 0.56;
const tl = plain(hero.title).length;
const megaCap = tl <= 20 ? 9 : tl <= 34 ? 7 : 5.6;
// On phones a long poster title is capped lower, so the call to action still shows on the first screen.
const megaPhone = tl <= 20 ? 4.4 : tl <= 34 ? 3.4 : 2.7;
const mega = `--mega: min(${megaCap}rem, ${fit(longest(hero.title), cwU)}); --mega-ph: min(${megaPhone}rem, ${fit(longest(hero.title), cwU)})`;
// The masthead also gives way on short laptop screens, so the headline and buttons stay in view.
const mast = `--mh-one: min(10rem, 15vh, ${fit(short.length, cwL)}); --mh-wrap: min(3.1rem, ${fit(longest(short), cwL)})`;
---
{kind === 'poster' && (
  <section class="hero hx hx-poster" id="top">
    <Decor demo={demo} kind="poster" tone={onDarkPrimary ? 'dark' : 'light'} />
    <div class="wrap">
      <div class="hx-top">{hero.eyebrow && <span class="hx-tag">{hero.eyebrow}</span>}<span class="hx-meta">{[est, town].filter(Boolean).join(' · ')}</span></div>
      <h1 class="hx-mega" style={mega} set:html={title(hero.title)} />
      <div class="hx-foot">
        <p class="lede">{hero.lede}</p>
        <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
      </div>
    </div>
    {words.length > 0 && (
      <div class="hx-marquee" aria-hidden="true"><div class="hx-track">{[...words, ...words, ...words, ...words].map((w) => <span>{w}<Icon name="sparkle" size={20} /></span>)}</div></div>
    )}
  </section>
)}

{kind === 'bento' && (
  <section class="hero hx hx-bento" id="top">
    <Decor demo={demo} kind="bento" tone={'light'} />
    <div class="wrap">
      <div class="bento">
        <div class="b-main">
          {hero.eyebrow && <div class="eyebrow">{hero.eyebrow}</div>}
          <h1 set:html={title(hero.title)} />
          <p class="lede">{hero.lede}</p>
          <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
        </div>
        <div class={`b-scene${contact.phone ? '' : ' tall'}`} aria-hidden="true">
          <span class="b-mesh"></span>
          <span class="b-ring r1"></span><span class="b-ring r2"></span><span class="b-ring r3"></span>
          <span class="b-orbit">{orbit.map((ic, k) => <i class={`o${k}`}><Icon name={ic} size={18} stroke={1.8} /></i>)}</span>
          <span class="b-emblem"><Icon name={demo.icon} size={52} stroke={1.5} /></span>
          <span class="b-spark s0"></span><span class="b-spark s1"></span><span class="b-spark s2"></span>
          <span class="b-caption">{demo.category}</span>
        </div>
        {contact.phone && (
          <a class="b-call" href={telHref(contact.phone)}>
            <span class="b-stripes" aria-hidden="true"></span>
            <span class="b-ph" aria-hidden="true"><Icon name="phone" size={20} stroke={2.2} /></span>
            <small>Call us</small><strong>{contact.phone}</strong><em>Tap to call</em>
            <span class="b-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={22} /></span>
          </a>
        )}
        {hours.length > 0 && <div class="b-hours"><small>Hours</small>{hours.map(([d, t]) => <span><b>{d}</b><em class="b-t">{t.split(/\s+·\s+/).map((part) => <i>{part}</i>)}</em></span>)}</div>}
        {contact.address && (
          <div class="b-where">
            <span class="b-map" aria-hidden="true"><i class="road h1"></i><i class="road h2"></i><i class="road v1"></i><i class="road v2"></i><i class="pin"><Icon name="map-pin" size={22} stroke={2.2} /></i></span>
            <small>Find us</small><span>{contact.address[0]}</span><span>{contact.address[1] || town}</span>
          </div>
        )}
        {facts[0] && <div class="b-fact"><span class="b-fact-icon" aria-hidden="true"><Icon name={orbit[1] || demo.icon} size={22} /></span><strong>{facts[0].value}</strong><span>{facts[0].label}</span></div>}
      </div>
    </div>
  </section>
)}

{kind === 'board' && (
  <section class="hero hx hx-board" id="top">
    <Decor demo={demo} kind="board" tone={'dark'} />
    <div class="wrap">
      <div class="hx-copy">
        {hero.eyebrow && <div class="hx-hand">{hero.eyebrow}</div>}
        <h1 set:html={title(hero.title)} />
        <p class="lede">{hero.lede}</p>
        <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
      </div>
      <div class="hx-slate">
        <p class="hx-hand hx-slate-title">{boardTitle}</p>
        <ul>{board.map((b) => <li><span>{b.name}</span><i></i>{b.price && <b>{/^\d/.test(b.price) ? `$${b.price}` : b.price}</b>}</li>)}</ul>
        <p class="hx-hand hx-slate-sign">— {short}</p>
      </div>
    </div>
  </section>
)}

{kind === 'collage' && (
  <section class="hero hx hx-collage" id="top">
    <Decor demo={demo} kind="collage" tone={'light'} />
    <div class="hx-shapes" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="wrap">
      <div class="hx-copy">
        {hero.eyebrow && <div class="hx-sticker">{hero.eyebrow}</div>}
        <h1 set:html={title(hero.title)} />
        <p class="lede">{hero.lede}</p>
        <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
      </div>
      <div class="hx-blob-wrap" aria-hidden="true">
        <div class="hx-blob">
          <span class="hx-blob-ring"></span>
          <span class="hx-blob-sats">{orbit.slice(0, 3).map((ic, k) => <i class={`o${k}`}><Icon name={ic} size={18} stroke={1.8} /></i>)}</span>
          <Icon name={demo.icon} size={96} stroke={1.4} />
          <span class="b-spark s0"></span><span class="b-spark s1"></span><span class="b-spark s2"></span>
        </div>
        {words.slice(0, 4).map((w, k) => <span class={`hx-chip c${k}`}>{w}</span>)}
      </div>
    </div>
    <svg class="hx-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C 240 90 480 -10 720 40 S 1200 90 1440 40 V80 H0 Z" /></svg>
  </section>
)}

{kind === 'blueprint' && (
  <section class="hero hx hx-blueprint" id="top">
    <Decor demo={demo} kind="blueprint" tone={'dark'} />
    <div class="wrap">
      <div class="hx-copy">
        <div class="hx-code">{[short.toUpperCase(), town.toUpperCase(), est.toUpperCase()].filter(Boolean).join(' / ')}</div>
        <h1 set:html={title(hero.title)} />
        <p class="lede">{hero.lede}</p>
        <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
      </div>
      <div class="hx-plan" aria-hidden="true">
        <span class="hx-dim">{est ? est.toUpperCase() : `${town.toUpperCase()}, SC`}</span>
        <span class="hx-scan"></span>
        <span class="hx-compass"></span>
        <div class="hx-draw"><Icon name={demo.icon} size={180} stroke={0.9} /></div>
        <span class="tick t1"></span><span class="tick t2"></span><span class="tick t3"></span><span class="tick t4"></span>
        {words.slice(0, 3).map((w, k) => <span class={`hx-note n${k}`}><i></i>{w}</span>)}
      </div>
      {facts.length > 0 && (
        <dl class="hx-spec">{facts.slice(0, 3).map((f, k) => <div><dt>SPEC {String(k + 1).padStart(2, '0')}</dt><dd><b>{f.value}</b>{f.label}</dd></div>)}</dl>
      )}
    </div>
  </section>
)}

{kind === 'magazine' && (
  <section class="hero hx hx-magazine" id="top">
    <Decor demo={demo} kind="magazine" tone={'light'} />
    <div class="wrap">
      <div class="hx-mast-line"><span>{est || street || demo.group}</span><span>{demo.category}</span><span>{town}, South Carolina</span></div>
      <p class="hx-masthead" aria-hidden="true" style={mast}>{short}</p>
      <div class="hx-cols">
        <p class="lede hx-drop">{hero.lede}</p>
        <div class="hx-head">
          {hero.eyebrow && <div class="eyebrow">{hero.eyebrow}</div>}
          <h1 data-long={tl > 30 ? '' : undefined} set:html={title(hero.title)} />
          <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
        </div>
        {facts.length > 0 && <ul class="hx-side">{facts.slice(0, 3).map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}</ul>}
      </div>
    </div>
  </section>
)}

{kind === 'diagonal' && (
  <section class="hero hx hx-diagonal" id="top">
    <Decor demo={demo} kind="diagonal" tone={'light'} />
    <div class="hx-plane" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hx-copy">
        {hero.eyebrow && <div class="eyebrow">{hero.eyebrow}</div>}
        <h1 set:html={title(hero.title)} />
        <p class="lede">{hero.lede}</p>
        <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
        {hero.points && <ul class="points">{hero.points.map((p) => <li><Icon name="check" size={18} stroke={2.6} />{p}</li>)}</ul>}
      </div>
      <div class="hx-orbit" aria-hidden="true">
        <span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span>
        <span class="hx-sats">{orbit.map((ic, k) => <i class={`o${k}`}><Icon name={ic} size={20} stroke={1.8} /></i>)}</span>
        <div class="hx-core"><Icon name={demo.icon} size={84} stroke={1.5} /></div>
        <span class="b-spark s0"></span><span class="b-spark s1"></span><span class="b-spark s2"></span>
        {words[0] && <span class="hx-label l0">{words[0]}</span>}
        {words[1] && <span class="hx-label l1">{words[1]}</span>}
      </div>
    </div>
  </section>
)}

{kind === 'spotlight' && (
  <section class="hero hx hx-spotlight" id="top">
    <Decor demo={demo} kind="spotlight" tone={'light'} />
    <div class="hx-glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hx-badge" aria-hidden="true"><Icon name={demo.icon} size={34} stroke={1.6} /></div>
      {hero.eyebrow && <div class="eyebrow">{hero.eyebrow}</div>}
      <h1 set:html={title(hero.title)} />
      <p class="lede">{hero.lede}</p>
      <div class="actions">{hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}{hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}</div>
      {words.length > 0 && <ul class="hx-pills">{words.slice(0, 5).map((w) => <li>{w}</li>)}</ul>}
    </div>
  </section>
)}
