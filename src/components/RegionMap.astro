---
// Every concept on a map (data/regionmap.json, from scripts/regionmap.mjs):
// the region around Aiken and a close-up of downtown, with a dot for each
// business in its own colour. Pointing at or tapping near a dot opens a card
// with a link to the concept. The concept list above is the keyboard and
// screen-reader route to the same pages, so the dots themselves aren't tab stops.
import { readFileSync } from 'node:fs';
import path from 'node:path';

type Pin = { slug: string; name: string; town: string; category: string; color: string; x: number; y: number };
type Frame = { w: number; h: number; water: string; green: string; waterway: string; major: string; mid: string; minor: string; labels: { name: string; x: number; y: number; big?: boolean }[]; pins: Pin[] };
let data: { region: Frame; downtown: Frame; box: { x: number; y: number; w: number; h: number } | null } | null = null;
try { data = JSON.parse(readFileSync(path.join(process.cwd(), 'data', 'regionmap.json'), 'utf8')); } catch { /* no map yet */ }
const frames = data ? [
  { key: 'region', title: 'Around Aiken', f: data.region, r: 7 },
  { key: 'downtown', title: 'Downtown Aiken', f: data.downtown, r: 9 },
] : [];
---
{data && (
  <section class="mapsec" id="map">
    <div class="wrap">
      <div class="mapsec-head">
        <h2>On the <em>map</em></h2>
        <p>Each dot is a business with a concept here, in its own colors. Point at a dot, or tap near one, to open it.</p>
      </div>
      <div class="rm-grid">
        {frames.map(({ key, title, f, r }) => (
          <figure class={`rm rm-${key}`} data-rm>
            <figcaption>{title}<span data-rm-count data-total={f.pins.length}>{f.pins.length} businesses</span></figcaption>
            <div class="rm-box">
              <svg viewBox={`0 0 ${f.w} ${f.h}`} role="img" aria-label={`Map of ${title.toLowerCase()} with ${f.pins.length} businesses that have a concept`} preserveAspectRatio="xMidYMid meet">
                <rect class="rm-land" width={f.w} height={f.h} />
                {f.green && <path class="rm-green" d={f.green} />}
                {f.water && <path class="rm-water" d={f.water} />}
                {f.waterway && <path class="rm-waterway" d={f.waterway} />}
                {f.minor && <path class="rm-minor" d={f.minor} />}
                {f.mid && <path class="rm-mid" d={f.mid} />}
                {f.major && <path class="rm-major" d={f.major} />}
                {key === 'region' && data!.box && <rect class="rm-inset" x={data!.box.x} y={data!.box.y} width={data!.box.w} height={data!.box.h} rx="6" />}
                <g class="rm-pins">{f.pins.map((p, i) => <circle class="rm-pin" cx={p.x} cy={p.y} r={r} style={`--pc:${p.color}`} data-i={i} data-slug={p.slug} />)}</g>
                {f.labels.map((l) => <text class:list={['rm-place', { big: l.big }]} x={l.x} y={l.y} text-anchor="middle">{l.name}</text>)}
              </svg>
              <div class="rm-card" data-rm-card hidden><strong data-rm-name></strong><span data-rm-meta></span><a data-rm-link href="#">See the concept<span aria-hidden="true"> →</span></a></div>
            </div>
            <script type="application/json" data-rm-pins set:html={JSON.stringify(f.pins.map(({ slug, name, town, category, x, y }) => ({ slug, name, town, category, x, y })))} />
          </figure>
        ))}
      </div>
      <p class="rm-credit">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors, tiles by OpenFreeMap.</p>
    </div>
  </section>
)}

<script is:inline>
  (() => {
    document.querySelectorAll('[data-rm]').forEach((fig) => {
      const svg = fig.querySelector('svg');
      const box = fig.querySelector('.rm-box');
      const card = fig.querySelector('[data-rm-card]');
      const pins = JSON.parse(fig.querySelector('[data-rm-pins]').textContent);
      const dots = [...svg.querySelectorAll('.rm-pin')];
      let current = -1, pinned = false;
      // Screen position of every dot, relative to the map box.
      const place = () => {
        const m = svg.getScreenCTM(); const b = box.getBoundingClientRect();
        return pins.map((p) => { const pt = new DOMPoint(p.x, p.y).matrixTransform(m); return [pt.x - b.left, pt.y - b.top]; });
      };
      const nearest = (cx, cy, reach) => {
        const b = box.getBoundingClientRect(); const pts = place();
        let best = -1, bd = reach;
        pts.forEach(([x, y], i) => { if (dots[i].classList.contains('dim')) return; const d = Math.hypot(x - (cx - b.left), y - (cy - b.top)); if (d < bd) { bd = d; best = i; } });
        return best;
      };
      const show = (i) => {
        if (i === current) return;
        dots[current]?.classList.remove('on');
        current = i;
        if (i < 0) { card.hidden = true; return; }
        const p = pins[i], [x, y] = place()[i];
        dots[i].classList.add('on');
        card.querySelector('[data-rm-name]').textContent = p.name;
        card.querySelector('[data-rm-meta]').textContent = `${p.category} · ${p.town}`;
        card.querySelector('[data-rm-link]').href = `/${p.slug}/`;
        card.hidden = false;
        const w = box.clientWidth, cw = card.offsetWidth, ch = card.offsetHeight;
        card.style.left = `${Math.max(8, Math.min(w - cw - 8, x - cw / 2))}px`;
        card.style.top = `${y - ch - 14 < 8 ? y + 16 : y - ch - 14}px`;
      };
      box.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse' && !pinned) show(nearest(e.clientX, e.clientY, 22)); });
      box.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !pinned) show(-1); });
      box.addEventListener('click', (e) => {
        if (card.contains(e.target)) return;
        const i = nearest(e.clientX, e.clientY, 36);
        pinned = i >= 0; show(-1); show(i);
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { pinned = false; show(-1); } });
      addEventListener('resize', () => { const i = current; current = -1; if (i >= 0) show(i); });
      // Follow the concept list's filter and search: fade the businesses it hides.
      const count = fig.querySelector('[data-rm-count]');
      document.addEventListener('concepts:filter', (e) => {
        const { all, slugs } = e.detail; let n = 0;
        dots.forEach((dot) => { const on = all || slugs.has(dot.dataset.slug); dot.classList.toggle('dim', !on); if (on) n++; });
        if (current >= 0 && dots[current].classList.contains('dim')) { pinned = false; show(-1); }
        count.textContent = all ? `${count.dataset.total} businesses` : `${n} of ${count.dataset.total} shown`;
      });
    });
  })();
</script>
