---
// A one-page summary to leave behind on an in-person visit: the concept on a
// computer and a phone, its measured before and after, what we noticed, what
// the concept changes, and a QR code to open it. Laid out for a Letter page
// (scripts/leave-behind.mjs prints it to outreach/print/one-page/<slug>.pdf);
// on screen it shows the same sheet.
import { client } from '../../lib/client';
import { existsSync } from 'node:fs';
import { assetUrl } from '../../lib/asset-url';
import path from 'node:path';
import QRCode from 'qrcode';
import { demos, fonts, type Demo } from '../../lib/demos';
import { site } from '../../lib/site';
import { measures } from '../../lib/measures';
import { accessible } from '../../lib/contrast';
import { builtIn } from '../../lib/features';

export function getStaticPaths() {
  if (client) return []; // a launched site has no checkup, SEO report or leave-behind
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}
interface Props { demo: Demo }
const { demo } = Astro.props;

const pub = path.join(process.cwd(), 'public');
const shot = (name: string) => assetUrl(`shots/${name}.jpg`);
const after = shot(`${demo.slug}-after`);
const phone = shot(`${demo.slug}-after-phone`);
const host = new URL(demo.source.url).hostname.replace(/^www\./, '');
const conceptUrl = `${site.url || ''}/${demo.slug}/`;
const shortUrl = conceptUrl.replace(/^https?:\/\//, '');
const qr = await QRCode.toString(conceptUrl, { type: 'svg', margin: 0, color: { dark: '#14181a', light: '#00000000' } });
const nums = measures(demo);
const noticed = demo.source.before.slice(0, 3);
const changes = (demo.source.after || []).slice(0, 4);
// With no numbers to show (a first website), the space goes to what's built in.
const extras = nums.length ? [] : builtIn(demo).slice(0, 6);
const tone = accessible(demo.colors);
const display = fonts['bricolage-grotesque'], body = fonts.inter;
const fontCss = [display, body].map((f) => `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}`).join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{`One-page summary: ${demo.name}`}</title>
    <style set:html={fontCss} />
  </head>
  <body style={`--deep:${tone['--deep']};--deep2:${tone['--deep2']};--accent:${tone['--accent-on-deep']}`}>
    <main class="sheet">
      <header class="band">
        <div>
          <p class="kicker">A website concept for</p>
          <h1>{demo.name}</h1>
          <p class="sub">{demo.category} · {demo.town}</p>
        </div>
        <p class="studio">{site.name}</p>
      </header>

      <section class="top">
        <figure class="shots">
          {after && <img class="desk" src={after} alt={`The concept for ${demo.name} on a computer`} width="1120" height="753" />}
          {phone && <img class="phone" src={phone} alt="The same concept on a phone" width="540" height="1169" />}
        </figure>
        <div class="scan">
          <div class="qr" set:html={qr} role="img" aria-label={`QR code that opens ${shortUrl}`}></div>
          <p class="scan-say">Scan to open the concept on your phone</p>
          <p class="url">{shortUrl}</p>
          <p class="free">It’s a real, working page: free to look at, with no obligation.</p>
        </div>
      </section>

      {nums.length > 0 && (
        <section class="nums">
          <h2>By the numbers <span>{host} today, and the concept, measured the same way</span></h2>
          <table>
            <thead><tr><th scope="col">Test</th><th scope="col">Today</th><th scope="col">Concept</th></tr></thead>
            <tbody>{nums.map((m) => <tr><th scope="row">{m.label}</th><td class="old">{m.today}</td><td class="new">{m.concept}</td></tr>)}</tbody>
          </table>
        </section>
      )}

      <section class="cols">
        <div>
          <h2>{demo.source.none ? 'Today' : 'What we noticed'}</h2>
          <ul class="warn">{noticed.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div>
          <h2>What the concept changes</h2>
          <ul class="good">{changes.map((b) => <li>{b}</li>)}</ul>
        </div>
      </section>

      {extras.length > 0 && (
        <section class="built">
          <h2>Built in for your customers</h2>
          <ul class="good">{extras.map((b) => <li>{b}</li>)}</ul>
        </section>
      )}

      <footer class="foot">
        <p class="talk">Like it? Talk to {site.name}: <b>{site.contactPhone}</b>{site.contactEmail && <> · <b>{site.contactEmail}</b></>}</p>
        <p class="fine">The full checkup is at {shortUrl}report/. Words and photos come from {demo.source.none ? `the public listing for ${demo.name.replace(/\.$/, '')}` : `${demo.name.replace(/\.$/, '')}’s own public pages`} and would be confirmed with the owner before anything goes live. {site.name} is not affiliated with {demo.name.replace(/\.$/, '')}.</p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  @page { size: Letter; margin: 0; }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: #e9e6df; }
  body { margin: 0; color: #14181a; font: 400 11pt/1.45 "Inter", system-ui, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .sheet { width: 8.5in; min-height: 11in; margin: 24px auto; padding: 0.4in 0.5in 0.32in; background: #fff; box-shadow: 0 20px 50px -20px rgb(0 0 0 / .35); display: flex; flex-direction: column; gap: 0.16in; }
  h1, h2 { font-family: "Bricolage Grotesque", "Inter", sans-serif; letter-spacing: -.02em; margin: 0; }
  p { margin: 0; }
  .band { display: flex; justify-content: space-between; align-items: flex-end; gap: 0.3in; padding: 0.2in 0.28in; border-radius: 14px; color: #fff; background: linear-gradient(135deg, var(--deep), var(--deep2)); }
  .band .kicker { font-size: 8.5pt; font-weight: 650; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .band h1 { font-size: 22pt; line-height: 1.05; margin-top: 4px; }
  .band .sub { margin-top: 5px; font-size: 10pt; color: rgb(255 255 255 / .85); }
  .band .studio { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 11pt; white-space: nowrap; }
  .top { display: grid; grid-template-columns: 1fr 1.85in; gap: 0.25in; align-items: center; }
  .shots { position: relative; margin: 0; padding-right: 0.55in; }
  .shots img { display: block; border-radius: 8px; border: 1px solid #ddd8cd; box-shadow: 0 10px 24px -14px rgb(0 0 0 / .45); }
  .shots .desk { width: 100%; height: auto; }
  .shots .phone { position: absolute; right: 0; bottom: -0.12in; width: 1.15in; height: auto; border-radius: 12px; border: 3px solid #14181a; }
  .scan { text-align: center; }
  .qr { width: 1.55in; height: 1.55in; margin: 0 auto; }
  .qr svg { width: 100%; height: 100%; display: block; }
  .scan-say { margin-top: 8px; font-weight: 650; font-size: 9.5pt; line-height: 1.3; }
  .url { margin-top: 4px; font-size: 8pt; color: #4f5a60; overflow-wrap: anywhere; }
  .free { margin-top: 8px; font-size: 8.5pt; color: #4f5a60; line-height: 1.35; }
  h2 { font-size: 13pt; margin-bottom: 6px; }
  h2 span { display: block; font-family: "Inter", sans-serif; font-size: 8.5pt; font-weight: 500; letter-spacing: 0; color: #4f5a60; margin-top: 1px; }
  .nums table { width: 100%; border-collapse: collapse; font-size: 9.5pt; font-variant-numeric: tabular-nums; }
  .nums th, .nums td { text-align: left; padding: 4px 8px; border-bottom: 1px solid #e7e3da; }
  .nums thead th { font-size: 8pt; font-weight: 650; color: #4f5a60; text-transform: uppercase; letter-spacing: .08em; }
  .nums tbody th { font-weight: 600; }
  .nums td { font-weight: 700; white-space: nowrap; }
  .nums td.old { color: #9a3f12; }
  .nums td.new { color: #0b6b4c; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0.3in; }
  .cols ul { list-style: none; margin: 0; padding: 0; font-size: 9.5pt; line-height: 1.4; }
  .cols li { position: relative; padding-left: 16px; margin-bottom: 5px; }
  .cols li::before { content: ""; position: absolute; left: 1px; top: .5em; width: 7px; height: 7px; border-radius: 50%; }
  .built ul { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 0.3in; font-size: 9.5pt; line-height: 1.4; }
  .built li { position: relative; padding-left: 16px; margin-bottom: 6px; break-inside: avoid; }
  .built li::before { content: ""; position: absolute; left: 1px; top: .5em; width: 7px; height: 7px; border-radius: 50%; background: #1f8a62; }
  .warn li::before { background: #c46a2a; }
  .good li::before { background: #1f8a62; }
  .foot { margin-top: auto; padding-top: 0.14in; border-top: 1px solid #e7e3da; }
  .talk { font-size: 10.5pt; }
  .fine { margin-top: 5px; font-size: 7.5pt; color: #5b6468; line-height: 1.4; }
  @media print { html { background: #fff; } .sheet { margin: 0; box-shadow: none; height: 11in; overflow: hidden; } }
  @media screen and (max-width: 8.6in) { .sheet { width: auto; min-height: 0; margin: 0; padding: 20px 16px; box-shadow: none; } .top, .cols { grid-template-columns: 1fr; } .band { flex-direction: column; align-items: flex-start; } }
</style>
