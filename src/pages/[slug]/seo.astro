---
// The full SEO & social media report for one business: every number we
// measured, how it compares with local competitors, and what to fix first.
// Data: data/seo.json (scripts/seo.mjs), data/rankings.json (scripts/rankings.mjs,
// optional), data/lighthouse.json. Made to be sent as a link or saved as a PDF.
import { readFileSync } from 'node:fs';
import path from 'node:path';
import Icon from '../../components/Icon.astro';
import { demos, fonts, type Demo } from '../../lib/demos';
import { site } from '../../lib/site';
import '../../styles/report.css';
import { accessible } from '../../lib/contrast';
import { existsSync } from 'node:fs';

export function getStaticPaths() {
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}
interface Props { demo: Demo }
const { demo } = Astro.props;
const root = process.cwd();
const key = demo.prospect || demo.slug;
const read = (f: string) => { try { return JSON.parse(readFileSync(path.join(root, 'data', f), 'utf8')); } catch { return {}; } };
const seo: any = read('seo.json')[key] || null;
const ranks: any = read('rankings.json')[key] || null;
const s = seo?.site && !seo.site.error ? seo.site : null;
const h = s?.home;
const checked = seo?.checked ? new Date(`${seo.checked}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '';
const lh = seo?.performance;
const clh = seo?.conceptPerformance;
const band = (n: number) => (n >= 90 ? 'good' : n >= 50 ? 'ok' : 'poor');

// ---- scorecard
const gauges = [
  seo?.scores?.seo != null && { label: 'SEO health', value: seo.scores.seo, note: 'Our checklist for local search, below' },
  lh && { label: 'Google Lighthouse SEO', value: lh.seo, note: "Google's own SEO check" },
  lh && { label: 'Speed on a phone', value: lh.performance, note: 'Lighthouse performance' },
  seo && { label: 'Social presence', value: seo.scores.social, note: 'Profiles, links and share previews' },
].filter(Boolean) as { label: string; value: number; note: string }[];

// ---- technical checklist
type Check = { ok: boolean | null; label: string; detail: string; why: string; fix?: string; weight: number };
const checks: Check[] = s ? [
  { ok: s.https, label: 'Secure connection (HTTPS)', detail: s.https ? 'The site loads over HTTPS.' : 'The site loads over plain HTTP.', why: 'Browsers mark plain-HTTP sites "Not secure", and Google prefers secure pages.', fix: 'Install a free SSL certificate and redirect every page to HTTPS.', weight: 9 },
  { ok: h.viewport, label: 'Built for phones', detail: h.viewport ? 'The page adapts to phone screens.' : 'No mobile viewport: phones show a zoomed-out desktop page.', why: 'Google ranks the phone version of your site.', fix: 'Rebuild the layout to adapt to phones.', weight: 9 },
  { ok: !!h.title && h.title.length >= 20 && h.title.length <= 65, label: 'Page title', detail: h.title ? `"${h.title}" (${h.title.length} characters)` : 'No title.', why: 'The title is the blue link in Google results. 20–65 characters shows in full.', fix: 'Write a title with your main service and town, under 65 characters.', weight: 8 },
  { ok: !!h.description && h.description.length >= 70 && h.description.length <= 170, label: 'Search description', detail: h.description ? `${h.description.length} characters` : 'No meta description: Google picks some text from the page instead.', why: 'The two lines under the link in Google. A good one gets more clicks.', fix: 'Write a 120–160 character description with your service, town and a reason to call.', weight: 7 },
  { ok: h.h1Count === 1, label: 'One main heading (H1)', detail: h.h1Count === 1 ? `"${h.h1[0]}"` : h.h1Count === 0 ? 'No H1 heading on the home page.' : `${h.h1Count} H1 headings on the home page.`, why: 'Search engines and screen readers use the H1 to understand what the page is about.', fix: 'Use exactly one H1 that says what you do and where.', weight: 6 },
  { ok: !h.noindex && !s.robots.blocksAll, label: 'Allowed in search results', detail: h.noindex ? 'The home page tells search engines not to index it.' : s.robots.blocksAll ? 'robots.txt blocks all search engines.' : 'Search engines are allowed to index the site.', why: 'A blocked page cannot appear in Google at all.', fix: 'Remove the noindex tag or the robots.txt block.', weight: 10 },
  { ok: !!h.canonical, label: 'Canonical address', detail: h.canonical ? h.canonical : 'No canonical tag.', why: 'Tells Google which version of a page is the real one, so ranking signals are not split.', fix: 'Add a canonical tag to every page.', weight: 4 },
  { ok: s.robots.found, label: 'robots.txt', detail: s.robots.found ? 'Present.' : 'Missing.', why: 'The file search engines read first: where to crawl and where the sitemap is.', fix: 'Add a robots.txt that points to the sitemap.', weight: 3 },
  { ok: !!s.sitemap, label: 'XML sitemap', detail: s.sitemap ? `${s.sitemap.pages} pages listed` : 'No sitemap found.', why: 'A sitemap helps Google find every page, including new ones.', fix: 'Publish a sitemap.xml and submit it in Google Search Console and Bing Webmaster Tools.', weight: 5 },
  { ok: h.schemaLocal, label: 'Business details for Google (structured data)', detail: h.schemaLocal ? `Found: ${h.schemaTypes.filter((t: string) => !/WebPage|WebSite|ImageObject|SearchAction|BreadcrumbList|ListItem|ReadAction|EntryPoint|Person|Article|ContactPoint|OpeningHoursSpecification|PostalAddress|GeoCoordinates|GeoShape|AdministrativeArea|Offer|city/i.test(t)).slice(0, 3).join(', ') || 'business markup'}` : 'No LocalBusiness markup.', why: 'Structured data hands Google your name, address, phone and hours directly, which feeds the map results and knowledge panel.', fix: 'Add LocalBusiness JSON-LD with address, phone, hours and geo coordinates.', weight: 8 },
  { ok: !!(h.og.title && h.og.image), label: 'Share preview (Open Graph)', detail: h.og.title && h.og.image ? 'Title and image set.' : h.og.title ? 'Title set, but no preview image.' : 'No Open Graph tags.', why: 'Controls the picture and headline people see when your link is shared on Facebook, in texts and in email.', fix: 'Add og:title, og:description and a 1200×630 og:image.', weight: 5 },
  { ok: h.images === 0 || h.imagesNoAlt / h.images <= 0.1, label: 'Image descriptions (alt text)', detail: `${h.imagesNoAlt} of ${h.images} images on the home page have no description.`, why: 'Google Images and screen readers rely on alt text.', fix: 'Describe every meaningful image in a few words.', weight: 5 },
  { ok: s.links.brokenCount === 0, label: 'Broken links', detail: s.links.brokenCount ? `${s.links.brokenCount} broken internal link${s.links.brokenCount === 1 ? '' : 's'} found.` : `None found in ${s.links.internalChecked} links checked.`, why: 'Dead ends frustrate visitors and waste the crawl time Google gives your site.', fix: 'Fix or remove each broken link listed below.', weight: 5 },
  { ok: s.crawl.missingDescription === 0, label: 'Descriptions on every page', detail: `${s.crawl.missingDescription} of ${s.crawl.pages} pages crawled have no search description.`, why: 'Each page can rank on its own, and each needs its own description.', fix: 'Add a unique description to every page.', weight: 3 },
  { ok: s.crawl.dupTitles === 0, label: 'Unique page titles', detail: s.crawl.dupTitles ? `${s.crawl.dupTitles} duplicate title${s.crawl.dupTitles === 1 ? '' : 's'}.` : 'Every page crawled has its own title.', why: 'Duplicate titles make pages compete with each other.', fix: 'Give every page a distinct title.', weight: 3 },
  { ok: h.favicon, label: 'Site icon (favicon)', detail: h.favicon ? 'Present.' : 'Missing.', why: 'Shown in browser tabs and next to your result in Google on phones.', fix: 'Add a favicon.', weight: 2 },
  { ok: !!h.lang, label: 'Language declared', detail: h.lang ? `lang="${h.lang}"` : 'No language set.', why: 'Helps search engines and screen readers.', fix: 'Set lang="en" on the page.', weight: 1 },
  ...(lh ? [{ ok: lh.lcp <= 2500, label: 'Main content appears quickly', detail: `About ${(lh.lcp / 1000).toFixed(1)} seconds on a mid-range phone on a slow connection.`, why: "Largest Contentful Paint is one of Google's Core Web Vitals; under 2.5 seconds is good.", fix: 'Serve images sized for phones and cut heavy scripts.', weight: 7 }] : []),
] : [];
const passed = checks.filter((c) => c.ok).length;

// ---- recommendations: failed checks, heaviest first, plus a few from other sections
const recs: { title: string; text: string }[] = [];
if (!s) recs.push({ title: seo?.siteState === 'No website' ? 'Get a website of your own' : 'Get the website back online', text: 'Without a working site, search engines rely on directories and social pages you do not control. A site at your own address is the foundation for everything else here.' });
for (const c of [...checks].filter((c) => !c.ok && c.fix).sort((a, b) => b.weight - a.weight)) recs.push({ title: c.label, text: c.fix! });
const cites = seo?.citations || [];
if (cites.some((c: any) => c.phoneMatch === false || c.websiteMatch === false)) recs.push({ title: 'Make your directory listings match', text: 'Some listings show a different phone number or web address than your site. Consistent name, address and phone across the web is a core local-ranking signal.' });
const social = seo?.social || { onSite: {}, listed: {} };
const platforms = ['Facebook', 'Instagram', 'Google Business Profile', 'YouTube', 'TikTok', 'LinkedIn', 'X (Twitter)', 'Pinterest', 'Yelp', 'Nextdoor', 'TripAdvisor'];
const anyProfile = (p: string) => social.onSite?.[p] || social.listed?.[p];
if (!anyProfile('Google Business Profile')) recs.push({ title: 'Claim and link your Google Business Profile', text: 'It is what shows in Google Maps and the map pack. Link it from your site so customers can find your reviews and directions.' });
if (s && !Object.keys(social.onSite || {}).length && Object.keys(social.listed || {}).length) recs.push({ title: 'Link your social profiles from the website', text: 'Your profiles exist but the site does not point to them, so visitors and search engines cannot connect the two.' });
if (s?.placeholderSocial?.length) recs.unshift({ title: 'Fix the social icons on your site', text: `They still link to the website builder's or designer's own accounts (${s.placeholderSocial.join(', ')}), not to yours, so visitors who tap them land on someone else's page.` });
if (s && h && !Object.values(h.tags || {}).some(Boolean)) recs.push({ title: 'Measure your visitors', text: 'No analytics found. Free tools like Google Analytics or Vercel Analytics show how people find you and which pages lead to calls.' });
const svc = ranks?.keywords?.find((k: any) => k.kind === 'service');
if (svc && !svc.google) recs.unshift({ title: `Show up when people search "${svc.keyword}"`, text: `On a phone in Aiken, your site is not in Google's top ${svc.googleDepth || 20} for that search${svc.maps ? '' : ', and the business is not in the top 20 on Google Maps'}. A fast site built around your service and town, plus a complete Google Business Profile, is how local businesses climb.` });
const kws = seo?.keywords || [];
for (const k of kws) if (!k.title && !k.h1) recs.push({ title: `Use "${k.term}" where Google looks`, text: `Searchers type your service and town. "${k.term}" is not in the home page title or main heading.` });

// ---- competitors
const me = s ? {
  name: demo.name, website: seo.site.home.url, state: 'ok', https: s.https, mobile: h.viewport, description: !!h.description, schema: h.schemaLocal, og: !!(h.og.title && h.og.image),
  performance: lh?.performance ?? null, pageMB: null, a11ySerious: null, facebook: !!anyProfile('Facebook'), instagram: !!anyProfile('Instagram'), domainYears: seo.domain?.years ?? null, me: true,
} : { name: demo.name, website: '', state: seo?.siteState === 'No website' ? 'none' : 'down', facebook: !!anyProfile('Facebook'), instagram: !!anyProfile('Instagram'), me: true };
let weightsAll: any = {}, a11yAll: any = {};
try { weightsAll = JSON.parse(readFileSync(path.join(root, 'data', 'weights.json'), 'utf8')); a11yAll = JSON.parse(readFileSync(path.join(root, 'data', 'a11y.json'), 'utf8')); } catch {}
if (s) {
  (me as any).pageMB = weightsAll[key]?.site?.bytes ? +(weightsAll[key].site.bytes / 1048576).toFixed(1) : null;
  const ax = a11yAll[key]?.site; (me as any).a11ySerious = ax && !ax.error ? ax.critical + ax.serious : null;
}
const comps: any[] = seo?.competitors || [];
const tick = (v: boolean | null | undefined) => (v === null || v === undefined ? '–' : v ? 'Yes' : 'No');
const hostOf = (u = '') => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return ''; } };

const display = fonts['bricolage-grotesque'];
const body = fonts.inter;
const fontCss = [display, body].map((f) => `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}`).join('');
const host = s ? s.host : hostOf(demo.source.url);
// Deep grounds in the business's own colours for the banner (white text at 7:1+).
const tone = accessible(demo.colors);
const heroThumb = existsSync(path.join(process.cwd(), 'public', 'shots', 'thumbs', `${demo.slug}.webp`)) ? `/shots/thumbs/${demo.slug}.webp` : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`SEO & social media report: ${demo.name}`}</title>
    <meta name="description" content={`Search, speed, listings, social media and competitors for ${demo.name}.`} />
    <meta property="og:title" content={`SEO & social media report: ${demo.name}`} />
    {site.url && <meta property="og:image" content={`${site.url}/cards/${demo.slug}.jpg`} />}
    <link rel="preload" href={display.normal} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="rp sr" style={`--t1:${demo.colors.primary};--t2:${demo.colors.accent};--deep:${tone["--deep"]};--deep2:${tone["--deep2"]};--accent-on-deep:${tone["--accent-on-deep"]}`}>
    <header class="rp-top">
      <div class="rp-wrap">
        <a href="/" class="rp-brand"><span class="rp-glyph"><svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path d="M7 24 16 7l9 17" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg><i class="rp-glint" aria-hidden="true"></i></span>{site.name}</a>
        <span>SEO & social media report{checked && ` · checked ${checked}`}</span>
      </div>
    </header>

    <main>
      <section class="rp-hero">
        <div class="rp-hero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="rp-wrap rp-hero-in">
          <div class="rp-hero-copy">
            <p class="rp-kicker">{demo.category} · {demo.town}</p>
            <h1>{demo.name}</h1>
            <p class="rp-lede">How {s ? <a href={seo.site.home.url} target="_blank" rel="noopener nofollow">{host}</a> : demo.name} shows up in search and on social media, how it compares with nearby competitors, and what to fix first.</p>
            <div class="sr-actions">
              <button type="button" class="rp-btn" data-print><Icon name="printer" size={18} /> Save as PDF</button>
              <a class="sr-link" href={`/${demo.slug}/report/`}><Icon name="arrow-left" size={16} /> Website checkup</a>
              <a class="sr-link" href={`/${demo.slug}/`}>See the concept <Icon name="arrow-right" size={16} /></a>
            </div>
          </div>
          {heroThumb && <a class="rp-hero-shot" href={`/${demo.slug}/`} aria-label={`Open the concept for ${demo.name}`}><img src={heroThumb} alt="" width="440" height="296" /><span>The concept</span></a>}
        </div>
        <svg class="rp-hero-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C 240 80 480 0 720 34 S 1200 80 1440 26 V70 H0 Z" /></svg>
      </section>
      <div class="rp-wrap">

      {!seo && <p class="rp-note">This report has not been generated yet.</p>}

      {gauges.length > 0 && (
        <section>
          <h2>Scorecard</h2>
          <div class="sr-gauges">
            {gauges.map((g) => (
              <figure class={`rp-gauge sr-g ${band(g.value)}`} style={`--v:${g.value}`}>
                <strong>{g.value}</strong>
                <figcaption><b>{g.label}</b><span>{g.note}</span></figcaption>
              </figure>
            ))}
          </div>
          {s && <p class="rp-note">{passed} of {checks.length} technical checks pass.{clh ? ` For comparison, the concept we built scores ${clh.performance} for speed and ${clh.accessibility} for accessibility in the same Lighthouse test.` : ''}</p>}
          {!s && <p class="rp-note">{seo?.siteState === 'No website' ? `${demo.name} has no website of its own, so the search checks below are about listings, social media and competitors.` : `The website could not be loaded when we checked (${seo?.siteState || 'unavailable'}), so the search checks are limited to listings, social media and competitors.`}</p>}
        </section>
      )}

      {ranks && ranks.keywords?.length > 0 && (
        <section>
          <h2>Where you show up in search</h2>
          <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Table (scrolls sideways on small screens)">
            <table class="sr-table">
              <thead><tr><th>Search</th><th>Google</th><th>Google Maps</th><th>Bing</th><th>Top Google result</th></tr></thead>
              <tbody>
                {ranks.keywords.map((k: any) => (
                  <tr>
                    <td><b>{k.keyword}</b><br /><small>{k.kind === 'name' ? 'Your business name' : 'What a new customer types'}</small></td>
                    {k.kind === 'name'
                      ? <td class={k.panel || k.google ? 'good' : 'poor'}>{k.panel ? (k.panelSite ? 'Business panel with your website' : 'Business panel shown') : k.google ? `#${k.google}` : 'Not found'}{k.panel && k.google ? <><br /><small>site also #{k.google}</small></> : ''}</td>
                      : <td class={k.google ? (k.google <= 3 ? 'good' : k.google <= 10 ? 'ok' : 'poor') : 'poor'}>{k.google ? `#${k.google}` : `Not in top ${k.googleDepth || 20}`}</td>}
                    {k.mapsDepth ? <td class={k.maps ? (k.maps <= 3 ? 'good' : 'ok') : 'poor'}>{k.maps ? `#${k.maps}` : `Not in top ${k.mapsDepth}`}</td> : <td>–</td>}
                    {k.bingDepth ? <td class={k.bing ? (k.bing <= 3 ? 'good' : k.bing <= 10 ? 'ok' : 'poor') : 'poor'}>{k.bing ? `#${k.bing}` : `Not in top ${k.bingDepth}`}</td> : <td>–</td>}
                    <td>{k.top || '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="rp-note">Positions from DataForSEO, a licensed search-data service, on {ranks.checked}, searching from {ranks.location || 'Aiken, SC'} on a phone. The business panel is the box Google shows above the results when it recognises a business by name; on phones, that is where your website link appears. Positions on the main search can change noticeably from one search to the next and differ by person and place, so treat them as a snapshot.</p>
        </section>
      )}

      {s && (
        <section>
          <h2>How you look on Google and when shared</h2>
          <div class="rp-cols sr-previews">
            <div class="sr-serp">
              <span class="sr-cap"><Icon name="search" size={15} /> Google result</span>
              <cite>{host}</cite>
              <h3>{h.title || 'Untitled page'}</h3>
              <p>{h.description || <i>No description: Google will pick text from the page.</i>}</p>
            </div>
            <div class="sr-share">
              <span class="sr-cap"><Icon name="share-2" size={15} /> Link shared on Facebook or in a text</span>
              <div class="sr-share-card">
                <div class="sr-share-img">{h.og.image ? <img src={h.og.image} alt="" width="1200" height="628" loading="lazy" referrerpolicy="no-referrer" onerror="this.parentElement.innerHTML='<span>Preview image would not load</span>'" /> : <span>No preview image</span>}</div>
                <div class="sr-share-body"><cite>{host}</cite><b>{h.og.title || h.title || host}</b><span>{h.og.description || h.description || ''}</span></div>
              </div>
            </div>
          </div>
        </section>
      )}

      {checks.length > 0 && (
        <section>
          <h2>Technical SEO checklist</h2>
          <ul class="sr-checks">
            {checks.map((c) => (
              <li class={c.ok ? 'pass' : 'fail'}>
                <Icon name={c.ok ? 'circle-check' : 'circle-x'} size={22} />
                <div><b>{c.label}</b><span>{c.detail}</span><small>{c.why}</small></div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {kws.length > 0 && (
        <section>
          <h2>Keywords where Google looks</h2>
          <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Table (scrolls sideways on small screens)">
            <table class="sr-table">
              <thead><tr><th>Term</th><th>Page title</th><th>Main heading</th><th>Description</th><th>First paragraph</th><th>Times on page</th></tr></thead>
              <tbody>
                {kws.map((k: any) => (
                  <tr><td><b>{k.term}</b></td>{[k.title, k.h1, k.description, k.firstWords].map((v) => <td class={v ? 'good' : 'poor'}>{v ? 'Yes' : 'No'}</td>)}<td>{k.count}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="rp-note">Local searchers type a service and a town. These are the places search engines weigh most when matching a page to that search.</p>
        </section>
      )}

      {s && (
        <section>
          <h2>What a search engine finds</h2>
          <dl class="rp-glance sr-stats">
            <div><dt>Pages crawled</dt><dd>{s.crawl.pages}</dd></div>
            <div><dt>Pages in sitemap</dt><dd>{s.sitemap ? s.sitemap.pages : 'No sitemap'}</dd></div>
            <div><dt>Words on home page</dt><dd>{h.words.toLocaleString()}</dd></div>
            <div><dt>Headings (H2 / H3)</dt><dd>{h.h2} / {h.h3}</dd></div>
            <div><dt>Thin pages (under 250 words)</dt><dd>{s.crawl.thin}</dd></div>
            <div><dt>Images without descriptions</dt><dd>{s.crawl.imagesNoAlt} of {s.crawl.images}</dd></div>
            <div><dt>Broken links</dt><dd>{s.links.brokenCount}</dd></div>
            <div><dt>Click-to-call link</dt><dd>{h.tel ? 'Yes' : 'No'}</dd></div>
          </dl>
          {s.links.broken.length > 0 && (
            <details class="sr-details">
              <summary>Broken links ({s.links.brokenCount})</summary>
              <ul>{s.links.broken.map((b: any) => <li><code>{b.url.replace(/^https?:\/\/(www\.)?/, '')}</code> <span>{b.status ? `HTTP ${b.status}` : 'no response'}</span>{b.from && <small> linked from {b.from.replace(/^https?:\/\/(www\.)?/, '')}</small>}</li>)}</ul>
            </details>
          )}
          <details class="sr-details">
            <summary>Pages crawled ({s.crawl.sample.length})</summary>
            <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Table (scrolls sideways on small screens)"><table class="sr-table small">
              <thead><tr><th>Page</th><th>Title</th><th>Description</th><th>H1</th><th>Words</th></tr></thead>
              <tbody>{s.crawl.sample.map((p: any) => <tr><td><code>{p.url.replace(/^https?:\/\/[^/]+/, '') || '/'}</code></td><td>{p.title || <i>none</i>}</td><td class={p.description ? '' : 'poor'}>{p.description ? `${p.description} chars` : 'none'}</td><td class={p.h1 === 1 ? '' : 'poor'}>{p.h1}</td><td>{p.words}</td></tr>)}</tbody>
            </table></div>
          </details>
        </section>
      )}

      {cites.length > 0 && (
        <section>
          <h2>Local directory listings</h2>
          <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Table (scrolls sideways on small screens)">
            <table class="sr-table">
              <thead><tr><th>Directory</th><th>Name listed</th><th>Phone</th><th>Website</th></tr></thead>
              <tbody>
                {cites.map((c: any) => (
                  <tr>
                    <td>{c.url ? <a href={c.url} target="_blank" rel="noopener nofollow">{c.source}</a> : c.source}</td>
                    <td>{c.name}</td>
                    <td class={c.phoneMatch === false ? 'poor' : c.phoneMatch ? 'good' : ''}>{c.phone || 'none'}{c.phoneMatch === false && ' (differs from site)'}</td>
                    <td class={c.websiteMatch === false ? 'poor' : c.websiteMatch ? 'good' : ''}>{c.website ? hostOf(c.website) || c.website : 'none'}{c.websiteMatch === false && (c.website ? ' (differs)' : '')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="rp-note">Google cross-checks your name, address and phone across the web. Matching listings help you rank in the map results; mismatches cost calls.</p>
        </section>
      )}

      {seo && (
        <section>
          <h2>Social media profile</h2>
          <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Table (scrolls sideways on small screens)">
            <table class="sr-table">
              <thead><tr><th>Platform</th><th>Profile</th><th>Linked from website</th><th>In directory listings</th></tr></thead>
              <tbody>
                {platforms.filter((p) => anyProfile(p) || ['Facebook', 'Instagram', 'Google Business Profile'].includes(p)).map((p) => (
                  <tr>
                    <td><b>{p}</b></td>
                    <td>{anyProfile(p) ? <a href={anyProfile(p)} target="_blank" rel="noopener nofollow">{String(anyProfile(p)).replace(/^https?:\/\/(www\.)?/, '').slice(0, 48)}</a> : <span class="muted">None found</span>}</td>
                    <td class={social.onSite?.[p] ? 'good' : s ? 'poor' : ''}>{social.onSite?.[p] ? 'Yes' : s ? 'No' : '–'}</td>
                    <td class={social.listed?.[p] ? 'good' : ''}>{social.listed?.[p] ? 'Yes' : 'No'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {s && (
            <dl class="rp-glance sr-stats">
              {Object.entries(h.tags || {}).map(([k, v]) => <div class={v ? 'ok' : ''}><dt>{k}</dt><dd>{v ? 'Installed' : 'Not found'}</dd></div>)}
              <div><dt>Map on the site</dt><dd>{h.mapEmbed ? 'Yes' : 'No'}</dd></div>
            </dl>
          )}
          <p class="rp-note">Follower counts and post activity are only visible to the account owner (or through paid social tools), so this profile covers what is public: which platforms you are on, whether your website and listings point to them, and whether links to your site share well.</p>
        </section>
      )}

      {seo?.domain && (
        <section>
          <h2>Your web address</h2>
          <dl class="rp-glance sr-stats">
            <div><dt>Domain</dt><dd>{seo.domain.name}</dd></div>
            <div><dt>Registered</dt><dd>{seo.domain.created ? `${seo.domain.created.slice(0, 4)} (${seo.domain.years} years)` : 'unknown'}</dd></div>
            <div><dt>Renews or expires</dt><dd>{seo.domain.expires || 'unknown'}</dd></div>
            <div><dt>Registrar</dt><dd>{seo.domain.registrar || 'unknown'}</dd></div>
          </dl>
          <p class="rp-note">An established domain is an asset: search engines trust older addresses. Keep it on auto-renew so it never lapses.</p>
        </section>
      )}

      {comps.length > 0 && (
        <section>
          <h2>How you compare with nearby competitors</h2>
          <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Table (scrolls sideways on small screens)">
            <table class="sr-table sr-comp">
              <thead><tr><th>Business</th><th>Speed (Lighthouse)</th><th>Home page size</th><th>Serious accessibility issues</th><th>Phone-ready</th><th>HTTPS</th><th>Google description</th><th>Business markup</th><th>Share preview</th><th>Facebook</th><th>Instagram</th></tr></thead>
              <tbody>
                {[me, ...comps].map((c: any) => (
                  <tr class={c.me ? 'me' : ''}>
                    <td><b>{c.name}</b>{c.me && <span class="sr-you">You</span>}<br /><small>{c.website ? hostOf(c.website) : c.state === 'none' ? 'no website' : 'site down'}</small></td>
                    <td class={c.performance == null ? '' : band(c.performance)}>{c.performance ?? '–'}</td>
                    <td>{c.pageMB != null ? `${c.pageMB} MB` : '–'}</td>
                    <td>{c.a11ySerious ?? '–'}</td>
                    {[c.mobile, c.https, c.description, c.schema, c.og, c.facebook, c.instagram].map((v) => <td class={v === true ? 'good' : v === false ? 'poor' : ''}>{tick(v)}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="rp-note">Competitors are other {demo.town.split(',')[0]}-area businesses listed in the same or a related category in local directories, put through the same checks on their home pages. A dash means that check could not be run.</p>
        </section>
      )}

      {recs.length > 0 && (
        <section>
          <h2>What to fix first</h2>
          <ol class="sr-recs">{recs.slice(0, 10).map((r) => <li><b>{r.title}</b><span>{r.text}</span></li>)}</ol>
          <p class="rp-note">The <a href={`/${demo.slug}/`}>concept site</a> already handles the technical items on this list: phone-first layout, HTTPS, titles and descriptions, business markup, share previews, image descriptions and speed.</p>
        </section>
      )}

      <section class="rp-cta">
        <div>
          <h2>Want this fixed?</h2>
          <p>The concept for {demo.short || demo.name} is ready to look at, and every item above can be part of the new site.</p>
        </div>
        <a class="rp-btn" href={`/${demo.slug}/`}>Open the concept <Icon name="arrow-right" size={18} /></a>
      </section>

      <p class="rp-fine">
        How this was checked: {s ? `we crawled ${s.crawl.pages} pages of ${host} the way a search engine does, read its robots.txt and sitemap, checked ${s.links.internalChecked} internal links, and ran Google Lighthouse on a simulated phone. ` : ''}Directory listings come from the Aiken and North Augusta chambers of commerce, Visit Aiken and Aiken Downtown Development. Social profiles are the ones linked from the website or listed in those directories. Domain details come from the public domain registry (RDAP).
        Nothing was logged into and nothing was changed. This is an unsolicited review from {site.name}, which is not affiliated with {demo.name.replace(/\.$/, '')}.
      </p>
      </div>
    </main>
    <script is:inline>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
      // Printed copies show every detail section open.
      addEventListener('beforeprint', () => document.querySelectorAll('details').forEach((d) => { d.open = true; }));
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && !navigator.webdriver) {
        document.body.classList.add('rp-motion');
        const countUp = (el) => {
          const end = Number(el.textContent); const t0 = performance.now();
          const step = (t) => { const k = Math.min(1, (t - t0 - 200) / 1500); el.textContent = String(Math.round(end * (1 - Math.pow(1 - Math.max(0, k), 3)))); if (k < 1) requestAnimationFrame(step); };
          el.textContent = '0'; requestAnimationFrame(step);
        };
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in'); io.unobserve(e.target);
          e.target.querySelectorAll('.rp-gauge strong').forEach(countUp);
        }), { rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.rp main > section, .rp-fine').forEach((el) => { el.classList.add('rp-reveal'); io.observe(el); });
      }
    </script>
  </body>
</html>
