---
// A one-page, plain-English "website checkup" for each business that has a
// concept: what its current site looks like, what we noticed, and what the
// concept changes. Made to be sent as a link or printed.
import { existsSync, readFileSync, statSync } from 'node:fs';
import path from 'node:path';
import Icon from '../../components/Icon.astro';
import { demos, fonts, type Demo } from '../../lib/demos';
import { site } from '../../lib/site';
import QRCode from 'qrcode';

export function getStaticPaths() {
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}
interface Props { demo: Demo }
const { demo } = Astro.props;

const root = process.cwd();
const shot = (name: string) => (existsSync(path.join(root, 'public', 'shots', `${name}.jpg`)) ? `/shots/${name}.jpg` : '');
const before = shot(`${demo.prospect || demo.slug}-before`);
const after = shot(`${demo.slug}-after`);
const host = new URL(demo.source.url).hostname.replace(/^www\./, '');

type Row = { slug: string; siteState: string; platform: string; mobileReady: boolean | null; https: boolean | null; copyrightYear: number | null; tier: string; phone?: string; listedPhone?: string; phoneNote?: string };
let row: Row | undefined;
let checked = '';
try {
  const rows: Row[] = JSON.parse(readFileSync(path.join(root, 'data', 'prospects.json'), 'utf8'));
  row = rows.find((r) => r.slug === (demo.prospect || demo.slug));
  checked = statSync(path.join(root, 'data', 'audit.json')).mtime.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
} catch {}

const online = row?.siteState === 'Online';

// Page weight, measured as a phone loads each page (scripts/weigh.mjs).
type Weight = { bytes: number; requests: number };
let weight: { site?: Weight; concept?: Weight } = {};
try { weight = JSON.parse(readFileSync(path.join(root, 'data', 'weights.json'), 'utf8'))[demo.prospect || demo.slug] || {}; } catch {}
const mb = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);
const showWeight = !!(weight.site?.bytes && weight.concept?.bytes && weight.site.bytes > weight.concept.bytes * 1.3);
const lighter = showWeight ? Math.round(weight.site!.bytes / weight.concept!.bytes) : 0;
// Time to download everything on the slow mobile connection Google's
// Lighthouse uses for its phone tests (1.6 Mbps).
const secs = (b: number) => (b * 8) / 1.6e6;
const say = (t: number) => (t < 1 ? 'under a second' : t < 90 ? `about ${Math.round(t)} seconds` : `about ${Math.round(t / 60)} minutes`);

const phoneShot = shot(`${demo.slug}-after-phone`);
const card = existsSync(path.join(root, 'public', 'cards', `${demo.slug}.jpg`)) ? `/cards/${demo.slug}.jpg` : '';

// Automated accessibility check (scripts/a11y.mjs, axe-core WCAG 2.1 AA rules).
type A11y = { issues: number; critical: number; serious: number; rules: number; top?: { id: string; help: string; nodes: number; impact: string }[] };
let a11y: { site?: A11y; concept?: A11y } = {};
try { a11y = JSON.parse(readFileSync(path.join(root, 'data', 'a11y.json'), 'utf8'))[demo.prospect || demo.slug] || {}; } catch {}
const showA11y = !!(a11y.site && typeof a11y.site.issues === 'number' && a11y.site.issues > 0 && a11y.concept && typeof a11y.concept.issues === 'number' && a11y.concept.issues < a11y.site.issues);
const HELP: Record<string, string> = {
  'color-contrast': 'Text too faint to read against its background',
  'image-alt': 'Images with no description for screen readers',
  'link-name': 'Links with no readable name',
  'button-name': 'Buttons with no readable name',
  'label': 'Form fields with no label',
  'html-has-lang': 'Page does not declare its language',
  'meta-viewport': 'Zooming is blocked on phones',
  'document-title': 'Page has no title',
  'heading-order': 'Headings out of order',
  'list': 'Lists built incorrectly',
  'listitem': 'List items outside a list',
  'aria-hidden-focus': 'Hidden items that keyboards can still reach',
  'frame-title': 'Embedded frames with no title',
  'duplicate-id': 'Repeated element IDs',
  'nested-interactive': 'Clickable items nested inside each other',
  'link-in-text-block': 'Links that only differ from text by colour',
  'region': 'Content outside page landmarks',
};
const conceptUrl = `${site.url || ''}/${demo.slug}/`;
const qr = await QRCode.toString(conceptUrl, { type: 'svg', margin: 0, color: { dark: '#143d2f', light: '#00000000' } });
const glance = [
  row && { label: 'Site status', value: row.siteState.replace(/ - verify$/, ''), good: online },
  online && row?.mobileReady !== null && { label: 'Adapts to phones', value: row!.mobileReady ? 'Yes' : 'No', good: !!row!.mobileReady },
  online && row?.https !== null && { label: 'Secure connection (HTTPS)', value: row!.https ? 'Yes' : 'No', good: !!row!.https },
  online && row?.platform && { label: 'Built with', value: row.platform, good: null },
  online && row?.copyrightYear && { label: 'Year in the footer', value: String(row.copyrightYear), good: row.copyrightYear >= new Date().getFullYear() - 1 },
].filter(Boolean) as { label: string; value: string; good: boolean | null }[];

const changes = demo.source.after || [
  'Designed phone-first: reads and taps comfortably on any screen',
  'One-tap call, directions and email from every page',
  'Served over HTTPS with no plugins to patch or break',
  'Loads in well under a second: static pages, optimised images, self-hosted fonts',
  'Clear headings, alt text and contrast for accessibility and for Google',
  'Hours, address and services in one obvious place',
];
const display = fonts['bricolage-grotesque'];
const body = fonts.inter;
const fontCss = [display, body].map((f) => `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}`).join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`Website checkup: ${demo.name}`}</title>
    <meta name="description" content={`What we noticed about ${host}, and a concept for what it could be.`} />
    <meta property="og:title" content={`Website checkup: ${demo.name}`} />
    <meta property="og:description" content={`What we noticed about ${host}, and a concept for what it could be.`} />
    {site.url && (card || after) && <meta property="og:image" content={`${site.url}${card || after}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={display.normal} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="rp">
    <header class="rp-top">
      <div class="rp-wrap">
        <a href="/" class="rp-brand">{site.name}</a>
        <span>Website checkup{checked && ` · ${checked}`}</span>
      </div>
    </header>

    <main class="rp-wrap">
      <p class="rp-kicker">{demo.category} · {demo.town}</p>
      <h1>{demo.name}</h1>
      {demo.source.none
        ? <p class="rp-lede">{demo.name} has no website of its own today. Here is what customers find now, and a working concept for a first site.</p>
        : <p class="rp-lede">A plain-English look at <a href={demo.source.url} target="_blank" rel="noopener nofollow">{host}</a>, and a working concept for what it could be.</p>}

      <section class="rp-shots">
        <figure>
          <figcaption><span class="rp-pill rp-old">Today</span>{demo.source.none ? 'no website' : host}</figcaption>
          {before
            ? <img src={before} alt={`${demo.name}'s current website`} width="1120" height="753" />
            : <div class="rp-none"><Icon name="triangle-alert" size={30} /><p>{demo.source.none ? 'No website: a search leads to a social page or a directory listing' : row?.siteState.replace(/ - verify$/, '') || 'The current site could not be loaded'}</p></div>}
        </figure>
        <figure>
          <figcaption><span class="rp-pill rp-new">The concept</span>ready to open</figcaption>
          {after && <a href={`/${demo.slug}/`} class="rp-after"><img src={after} alt={`Concept redesign for ${demo.name}`} width="1120" height="753" />{phoneShot && <img class="rp-phone" src={phoneShot} alt={`The concept on a phone`} width="540" height="1169" loading="lazy" />}</a>}
        </figure>
      </section>

      {before && after && (
        <section class="rp-compare-wrap">
          <h2>Slide to compare</h2>
          <div class="rp-compare" style="--pos:50%">
            <img src={after} alt={`Concept redesign for ${demo.name}`} width="1120" height="753" loading="lazy" />
            <img class="rp-compare-before" src={before} alt={`${demo.name}'s current website`} width="1120" height="753" loading="lazy" />
            <span class="rp-compare-line" aria-hidden="true"></span>
            <span class="rp-tag rp-tag-l" aria-hidden="true">Today</span>
            <span class="rp-tag rp-tag-r" aria-hidden="true">Concept</span>
            <input type="range" min="0" max="100" value="50" aria-label="Show more of today's site or of the concept" data-compare />
          </div>
        </section>
      )}

      {glance.length > 0 && (
        <section>
          <h2>At a glance</h2>
          <dl class="rp-glance">
            {glance.map((g) => (
              <div class={g.good === null ? '' : g.good ? 'ok' : 'bad'}>
                <dt>{g.label}</dt>
                <dd>{g.good !== null && <Icon name={g.good ? 'circle-check' : 'circle-alert'} size={18} stroke={2.2} />}{g.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {showWeight && (
        <section>
          <h2>How heavy each page is on a phone</h2>
          <div class="rp-weight">
            <div><span>Today</span><strong>{mb(weight.site!.bytes)}</strong><em>{weight.site!.requests} files</em><i style={`--w:100%`}></i></div>
            <div class="new"><span>The concept</span><strong>{mb(weight.concept!.bytes)}</strong><em>{weight.concept!.requests} files</em><i style={`--w:${Math.max(3, Math.round((weight.concept!.bytes / weight.site!.bytes) * 100))}%`}></i></div>
          </div>
          <p class="rp-note">The concept's first screen downloads about {lighter > 1 ? `${lighter} times` : 'a third'} less data. On a slow phone connection (1.6 Mbps, the speed Google's Lighthouse uses to test mobile pages), downloading everything takes {say(secs(weight.site!.bytes))} for today's page and {say(secs(weight.concept!.bytes))} for the concept. That is the difference between a page that appears and one people give up on.</p>
        </section>
      )}

      {showA11y && (
        <section>
          <h2>Accessibility check</h2>
          <div class="rp-weight">
            <div><span>Today</span><strong>{a11y.site!.issues}</strong><em>issues{a11y.site!.critical + a11y.site!.serious > 0 && `, ${a11y.site!.critical + a11y.site!.serious} serious`}</em><i style="--w:100%"></i></div>
            <div class="new"><span>The concept</span><strong>{a11y.concept!.issues}</strong><em>issues</em><i style={`--w:${Math.max(2, Math.round((a11y.concept!.issues / a11y.site!.issues) * 100))}%`}></i></div>
          </div>
          {a11y.site!.top?.length ? <ul class="rp-a11y">{a11y.site!.top.slice(0, 4).map((t) => <li><b>{t.nodes}×</b> {HELP[t.id] || t.help}</li>)}</ul> : null}
          <p class="rp-note">Found with axe, the standard automated accessibility checker, using WCAG 2.1 AA rules. Automated tools catch only part of what a person would, so treat this as a starting point. Accessible sites work better for older customers and anyone on a phone outdoors, and they lower the risk of an ADA complaint.</p>
        </section>
      )}

      {row?.listedPhone && (
        <section class="rp-flag">
          <h2>{/typo/.test(row.phoneNote || '') ? 'A likely typo in your directory listing' : 'Two different phone numbers'}</h2>
          <p>A local business directory lists <strong>{row.listedPhone}</strong>, but your website shows <strong>{row.phone}</strong>. Customers who find you through the directory may be calling a number that doesn't reach you. Worth a two-minute fix either way.</p>
        </section>
      )}

      <section class="rp-cols">
        <div>
          <h2>What we noticed</h2>
          <ul class="rp-list rp-warn">{demo.source.before.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div>
          <h2>What the concept changes</h2>
          <ul class="rp-list rp-good">{changes.map((b) => <li>{b}</li>)}</ul>
        </div>
      </section>

      <section class="rp-cta">
        <div>
          <h2>See it for yourself</h2>
          <p>The concept is a real, working page. Open it on your phone and tap around.</p>
        </div>
        <div class="rp-qr" set:html={qr} aria-label={`QR code for ${conceptUrl}`} role="img"></div>
        <p class="rp-actions">
          <a class="rp-btn" href={`/${demo.slug}/`}>Open the concept<Icon name="arrow-right" size={18} stroke={2.2} /></a>
          {site.contactEmail && <a class="rp-btn rp-ghost" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
        </p>
      </section>

      <p class="rp-fine">
        How this was checked: {demo.source.none ? `a search of local business directories${checked ? ` in ${checked}` : ''} found no website for this business, only a listing or a social page.` : `an automated look at the public home page of ${host}${checked ? ` in ${checked}` : ''}, plus a read-through of the pages a visitor can reach.`}{' '}
        Nothing was logged into and nothing was changed. This is an unsolicited review from {site.name}, which is not affiliated with {demo.name.replace(/\.$/, '')}.
        Found something we got wrong? Tell us and we will correct it.
      </p>
    </main>
    <script is:inline>
      // Before/after slider: the range input sets how much of today's site shows.
      for (const input of document.querySelectorAll('[data-compare]')) {
        const box = input.closest('.rp-compare');
        input.addEventListener('input', () => box.style.setProperty('--pos', `${input.value}%`));
      }
    </script>
  </body>
</html>

<style is:global>
  .rp { --bg: #faf8f3; --surface: #fff; --ink: #14181a; --muted: #5b6468; --line: #e3ded2; --green: #143d2f; --green-2: #1f6a50; --warn: #b4541a; margin: 0; background: var(--bg); color: var(--ink); font: 400 1.03rem/1.6 "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
  .rp *, .rp *::before, .rp *::after { box-sizing: border-box; }
  .rp h1, .rp h2 { font-family: "Bricolage Grotesque", "Inter", system-ui, sans-serif; letter-spacing: -.025em; line-height: 1.08; margin: 0; text-wrap: balance; }
  .rp h1 { font-size: clamp(2.1rem, 5.4vw, 3.8rem); font-weight: 700; letter-spacing: -.04em; }
  .rp h2 { font-size: 1.35rem; font-weight: 650; margin-bottom: 16px; }
  .rp p { margin: 0; }
  .rp a { color: inherit; }
  .rp img { display: block; width: 100%; height: auto; }
  .rp ul { list-style: none; margin: 0; padding: 0; }
  .rp-wrap { width: min(100% - 40px, 1080px); margin-inline: auto; }
  .rp main { padding-block: clamp(36px, 6vw, 72px) 64px; }
  .rp section { margin-top: clamp(36px, 5vw, 56px); }
  .rp-top { border-bottom: 1px solid var(--line); font-size: .9rem; color: var(--muted); }
  .rp-top .rp-wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 16px; }
  .rp-brand { font-weight: 700; color: var(--ink); text-decoration: none; font-family: "Bricolage Grotesque", sans-serif; }
  .rp-kicker { font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--green-2); margin-bottom: 14px; }
  .rp-lede { font-size: clamp(1.08rem, 1.5vw, 1.25rem); color: var(--muted); margin-top: 16px; max-width: 40em; }
  .rp-shots { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .rp-shots figure { margin: 0; }
  .rp-shots figcaption { display: flex; align-items: center; gap: 10px; font-size: .9rem; color: var(--muted); margin-bottom: 10px; }
  .rp-shots img, .rp-none { border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 14px 34px -20px rgb(0 0 0 / .3); background: var(--surface); }
  .rp-none { aspect-ratio: 1120 / 753; display: grid; place-content: center; justify-items: center; gap: 10px; color: var(--warn); text-align: center; padding: 24px; font-weight: 600; }
  .rp-pill { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; color: #fff; }
  .rp-old { background: var(--warn); }
  .rp-new { background: var(--green-2); }
  .rp-glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 0; }
  .rp-glance div { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
  .rp-glance dt { font-size: .8rem; color: var(--muted); }
  .rp-glance dd { margin: 6px 0 0; font-weight: 650; display: flex; align-items: center; gap: 8px; line-height: 1.3; }
  .rp-glance .ok dd svg { color: var(--green-2); }
  .rp-glance .bad dd { color: var(--warn); }
  .rp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); }
  .rp-list li { position: relative; padding: 12px 0 12px 26px; border-top: 1px solid var(--line); }
  .rp-list li::before { content: ""; position: absolute; left: 2px; top: 1.25em; width: 10px; height: 10px; border-radius: 50%; }
  .rp-warn li::before { background: #d7a13b; }
  .rp-good li::before { background: #2f9e62; }
  .rp-cta { background: var(--green); color: #eef3ef; border-radius: 20px; padding: clamp(24px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
  .rp-cta h2 { margin-bottom: 6px; font-size: 1.6rem; }
  .rp-cta p { color: rgb(238 243 239 / .8); }
  .rp-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .rp-btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 22px; border-radius: 999px; background: #f3e9c9; color: var(--green) !important; font-weight: 650; text-decoration: none; }
  .rp-btn.rp-ghost { background: transparent; color: #fff !important; border: 1px solid rgb(255 255 255 / .4); }
  .rp-fine { margin-top: 36px !important; font-size: .84rem; color: var(--muted); max-width: 62em; }
  .rp-after { position: relative; display: block; }
  .rp-phone { position: absolute; right: -14px; bottom: -22px; width: 26% !important; border-radius: 16px !important; border: 4px solid #14181a !important; box-shadow: 0 18px 30px -12px rgb(0 0 0 / .45) !important; }
  .rp-weight { display: grid; gap: 12px; }
  .rp-weight div { position: relative; display: grid; grid-template-columns: 120px auto 1fr; align-items: baseline; gap: 14px; padding: 14px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .rp-weight span { font-size: .85rem; color: var(--muted); }
  .rp-weight strong { font: 700 1.5rem/1 "Bricolage Grotesque", sans-serif; letter-spacing: -.02em; }
  .rp-weight em { font-style: normal; color: var(--muted); font-size: .9rem; }
  .rp-weight i { position: absolute; left: 0; bottom: 0; height: 4px; width: var(--w); background: var(--warn); }
  .rp-weight .new i { background: var(--green-2); }
  .rp-a11y { margin-top: 12px !important; display: grid; gap: 6px; font-size: .95rem; }
  .rp-a11y li { padding-left: 4px; }
  .rp-a11y b { color: var(--warn); font-variant-numeric: tabular-nums; }
  .rp-note { color: var(--muted); font-size: .95rem; margin-top: 12px !important; max-width: 52em; }
  .rp-flag { background: #fff7ec; border: 1px solid #f0d3a8; border-radius: 16px; padding: 22px 24px; }
  .rp-flag h2 { color: var(--warn); margin-bottom: 8px; }
  .rp-qr { width: 104px; height: 104px; background: #f3e9c9; padding: 10px; border-radius: 12px; flex: none; }
  .rp-qr svg { width: 100%; height: 100%; display: block; }
  @media (max-width: 760px) { .rp-shots, .rp-cols { grid-template-columns: 1fr; } .rp-weight div { grid-template-columns: 1fr auto; } .rp-weight em { display: none; } .rp-qr { display: none; } }
  .rp-compare { position: relative; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 14px 34px -20px rgb(0 0 0 / .3); background: var(--surface); }
  .rp-compare img { display: block; width: 100%; height: auto; }
  .rp-compare-before { position: absolute; inset: 0; height: 100% !important; object-fit: cover; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .rp-compare-line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; box-shadow: 0 0 0 1px rgb(0 0 0 / .25); pointer-events: none; }
  .rp-compare-line::after { content: "⟷"; position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--green); font-weight: 700; box-shadow: 0 4px 14px rgb(0 0 0 / .3); }
  .rp-tag { position: absolute; bottom: 12px; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; color: #fff; pointer-events: none; }
  .rp-tag-l { left: 12px; background: var(--warn); }
  .rp-tag-r { right: 12px; background: var(--green-2); }
  .rp-compare input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .rp-compare:has(input:focus-visible) { outline: 3px solid var(--green-2); outline-offset: 3px; }
  @media print { .rp-compare-wrap { display: none; } }
  @media print { .rp-qr { display: block; } @page { margin: 14mm; } .rp section { break-inside: avoid; } }
  @media print { .rp { background: #fff; } .rp-cta { background: #fff; color: var(--ink); border: 1px solid var(--line); } .rp-cta p { color: var(--muted); } .rp-btn { border: 1px solid var(--ink); } }
</style>
