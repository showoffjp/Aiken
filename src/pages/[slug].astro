---
// One redesign concept per business: /<slug>/
import '../styles/demo.css';
import { assetUrl } from '../lib/asset-url';
import '../styles/personality.css';
import '../styles/vivid.css';
import '../styles/features.css';
import '../styles/backdrops.css';
import Icon from '../components/Icon.astro';
import Seal from '../components/demo/Seal.astro';
import Sections from '../components/demo/Sections.astro';
import Hero from '../components/demo/Hero.astro';
import Decor from '../components/demo/Decor.astro';
import StreetMap from '../components/demo/StreetMap.astro';
import MotionToggle from '../components/demo/MotionToggle.astro';
import { streetMap } from '../lib/streets';
import { demos, fonts, telHref, title, sectionId, srcset, cinematicHero, offerWords, vcardFile, tint, coverSizes, type Demo } from '../lib/demos';
import { site } from '../lib/site';
import { businessLd, openingHours } from '../lib/schema';
import { builtIn } from '../lib/features';
import { measures } from '../lib/measures';
import { appName } from '../lib/appicon';
import QRCode from 'qrcode';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { accessible, ratio } from '../lib/contrast';

export function getStaticPaths() {
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}
interface Props { demo: Demo }
const { demo } = Astro.props;
const { contact, hero, colors } = demo;

const display = fonts[demo.fonts.display];
const body = fonts[demo.fonts.body];
const accentFont = demo.fonts.accent ? fonts[demo.fonts.accent] : undefined;
const faces = [...new Map([display, body, accentFont].filter(Boolean).map((f) => [f!.family, f!])).values()];
const fontCss = faces.map((f) =>
  `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}` +
  (f.italic ? `@font-face{font-family:"${f.family}";src:url(${f.italic}) format("woff2");font-weight:100 900;font-style:italic;font-display:swap}` : '')
).join('');
const safe = accessible(colors);
const vars = [
  `--bg:${colors.bg}`, `--surface:${colors.surface}`, `--ink:${colors.ink}`, `--muted:${colors.muted}`,
  `--primary:${colors.primary}`, `--on-primary:${colors.onPrimary}`, `--accent:${colors.accent}`, `--line:${colors.line}`,
  `--radius:${demo.radius ?? 10}px`,
  `--font-display:"${display.family}",${display.fallback}`, `--font-body:"${body.family}",${body.fallback}`,
  ...(accentFont ? [`--font-accent:"${accentFont.family}",${accentFont.fallback}`] : []),
  ...Object.entries(safe).map(([k, v]) => `${k}:${v}`),
].join(';');

const nav = [
  ...demo.sections.map((s, i) => ('nav' in s && s.nav ? { label: s.nav, href: `#${sectionId(s, i)}` } : null)).filter(Boolean),
  { label: 'Contact', href: '#visit' },
] as { label: string; href: string }[];
const variant = hero.variant || (hero.image ? 'split' : 'banner');
// Cinematic concepts (photo-heavy) get a full-screen, scroll-driven hero.
const cine = !!demo.cinematic;
// A small, wide hero photo would be blown up to fill the tall frame: give it a landscape frame instead.
const lowResWide = !!hero.image && !!hero.image.width && !!hero.image.height && hero.image.width < 900 && hero.image.width / hero.image.height > 1.4;
// Personality: a hero archetype and section treatments chosen per concept.
const st = demo.style || {};
const archetype = !cine ? st.hero : undefined;
// A moving background behind the hero and the call-to-action band (backdrops.css): chosen by
// the concept's style, or spread evenly across concepts by a hash of the slug.
const BACKDROPS = ['bokeh', 'contour', 'beams', 'ripple'];
const backdrop = st.backdrop || BACKDROPS[[...demo.slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7) % BACKDROPS.length];
// The blueprint and magazine heroes already set out the key facts.
const factsInHero = archetype === 'blueprint' || archetype === 'magazine';
const cineImg = cine ? cinematicHero(demo) : undefined;
// A slanted ribbon of what they offer, in their colours (the poster hero and the
// facts ticker already scroll, so they skip it).
const ribbonWords = offerWords(demo, 6);
const ribbon = ribbonWords.length >= 2 && archetype !== 'poster' && st.facts !== 'ticker';
const short = demo.short || demo.name;
// Measured before-and-after for the "What changed?" panel (src/lib/measures.ts).
const nums = measures(demo);
const sealBottom = [demo.town.replace(/,?\s*SC$/i, ', South Carolina'), demo.established ? `Est. ${demo.established}` : ''].filter(Boolean).join(' · ');
const mapSrc = contact.mapQuery ? `https://www.google.com/maps?q=${encodeURIComponent(contact.mapQuery)}&output=embed` : '';
// A drawn street map (OpenStreetMap data) shows first; Google's interactive
// map loads only when someone asks for it.
const streets = streetMap(demo.slug);
const directions = contact.mapQuery ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(contact.mapQuery)}` : '';
const sourceHost = new URL(demo.source.url).hostname.replace(/^www\./, '');
// Before-and-after shots for the slider in "What changed?" (made by scripts/shots.mjs).
const shotPath = (name: string) => assetUrl(`shots/${name}.jpg`);
const beforeShot = demo.source.none ? '' : shotPath(`${demo.prospect || demo.slug}-before`);
const afterShot = shotPath(`${demo.slug}-after`);
const after = demo.source.after || [
  'Designed phone-first: reads and taps comfortably on any screen',
  'One-tap call, directions and email from every page',
  'Served over HTTPS with no plugins to patch or break',
  'Loads in well under a second: static pages, optimised images, self-hosted fonts',
  'Clear headings, alt text and contrast for accessibility and for Google',
  'Hours, address and services in one obvious place',
];
const year = new Date().getFullYear();
// Long headlines step down a size so the buttons stay on the first screen.
const longTitle = hero.title.replace(/\*/g, '').length > 28 ? '' : undefined;

// The business details Google reads (schema.org). Part of what the real site would ship.
const ld = businessLd(demo, site.url);
// Opening hours in a form the page can check against the clock in Aiken ("Open now").
const hoursSpec = openingHours(contact.hours);
const hasPhotos = demo.sections.some((s) => s.type === 'gallery' || (s.type === 'story' && s.image));
const vcardName = `${vcardFile(demo)}.vcf`;
// On a computer: a code to scan, so the page (call button, directions) opens on the visitor's phone.
const pageUrl = `${site.url}/${demo.slug}/`;
const phoneQr = await QRCode.toString(pageUrl, { type: 'svg', margin: 0, color: { dark: '#111111', light: '#00000000' } });
const vcard = `/${demo.slug}/${vcardName}`;
// Facts are sized on phones so the longest word always fits its column.
const factCh = (v: string) => Math.max(...v.split(/\s+/).map((w) => w.length));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try { if (localStorage.getItem('motion') === 'paused') document.documentElement.classList.add('motion-paused'); } catch {}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${demo.name} — website concept`}</title>
    <meta name="description" content={`A redesign concept for ${demo.name} in ${demo.town}. Not the business's official website.`} />
    <meta name="theme-color" content={colors.primary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${demo.name}: a website concept`} />
    <meta property="og:description" content={hero.lede} />
    {site.url && <meta property="og:url" content={`${site.url}/${demo.slug}/`} />}
    {site.url && <meta property="og:image" content={`${site.url}/shots/${demo.slug}-after.jpg`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="${colors.primary}"/><text x="16" y="22" font-size="17" font-family="Georgia,serif" font-weight="700" text-anchor="middle" fill="${colors.onPrimary}">${short.replace(/^the\s+/i, '').charAt(0)}</text></svg>`)}`} />
    <link rel="apple-touch-icon" href={`/${demo.slug}/icon-180.png`} />
    <link rel="manifest" href={`/${demo.slug}/manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content={appName(demo)} />
    <link rel="preload" href={display.normal} as="font" type="font/woff2" crossorigin />
    {body.normal !== display.normal && <link rel="preload" href={body.normal} as="font" type="font/woff2" crossorigin />}
    <style set:html={fontCss} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="demo" data-look={demo.look} data-cinematic={demo.cinematic ? '' : undefined} data-hero={archetype} data-frame={st.frame} data-flip={st.flip ? '' : undefined} data-services={st.services} data-facts={st.facts} data-pattern={st.pattern} data-divider={st.divider} data-heads={st.heads} data-motion={st.motion} data-buttons={st.buttons} data-backdrop={backdrop} data-hours={hoursSpec ? JSON.stringify(hoursSpec) : undefined} style={vars}>
    <a class="skip" href="#main">Skip to content</a>

    <aside class="concept" aria-label="About this preview">
      <div class="wrap">
        <span class="dot"></span>
        <span class="grow"><b>Concept<span class="long"> preview</span>.</b> <span class="long">{demo.source.none ? `A first-website idea for ${demo.name}, which has no site of its own yet.` : `A redesign idea for ${demo.name}, not their live website (${sourceHost}).`}</span><span class="short">Not the live site.</span></span>
        <button type="button" data-tour-start><span class="long">Take the tour</span><span class="short">Tour</span></button>
        <button type="button" data-open-notes>What changed?</button>
        <a class="studio" href="/">{site.name}</a>
      </div>
    </aside>

    <header class="site-head" data-head>
      <div class="wrap">
        <a class="brand" href="#top" aria-label={`${demo.name} home`}>
          {demo.logo
            ? <span class="logo" style={`--logo:url(${demo.logo.src})`}><img src={demo.logo.src} alt={demo.logo.alt} width={demo.logo.width} height={demo.logo.height} /><span class="glint" aria-hidden="true"></span></span>
            : <><span class="mark"><Icon name={demo.icon} size={22} /><span class="glint" aria-hidden="true"></span></span><span class="word">{short}<small>{demo.town}</small></span></>}
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}<Icon name="chevron-right" size={18} class="nav-go" /></a>)}
          {(contact.phone || directions) && (
            <div class="nav-extra">
              <p class="open-now" data-open-now hidden></p>
              {contact.phone && <a class="btn" href={telHref(contact.phone)}><Icon name="phone" size={18} stroke={2.2} />Call {contact.phone}</a>}
              {directions && <a class="btn ghost" href={directions} target="_blank" rel="noopener" data-directions={contact.mapQuery}><Icon name="navigation" size={18} stroke={2.2} />Directions</a>}
            </div>
          )}
        </nav>
        {contact.phone && (
          <a class="head-cta" href={telHref(contact.phone)} aria-label={`Call ${contact.phone}`}>
            <Icon name="phone" size={18} stroke={2.2} /><span class="long">Call </span><span class="num">{contact.phone}</span>
          </a>
        )}
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" data-menu><Icon name="menu" size={22} class="i-open" /><Icon name="x" size={22} class="i-close" /></button>
      </div>
      <span class="head-progress" aria-hidden="true"></span>
    </header>

    <div class="print-head" aria-hidden="true"><strong>{demo.name}</strong>{[contact.phone, contact.address?.join(', ')].filter(Boolean).map((x) => <span>{x}</span>)}</div>
    <main id="main">
      {archetype ? <Hero demo={demo} kind={archetype} /> : cine && cineImg ? (
        <section class="cine-hero" id="top" data-cine-hero>
          <div class="cine-stick">
            <img class="cine-bg" style={tint(cineImg)} src={cineImg.src} srcset={srcset(cineImg)} sizes="100vw" alt="" width={cineImg.width} height={cineImg.height} fetchpriority="high" />
            <div class="cine-wash" aria-hidden="true"></div>
            <div class="cine-grain" aria-hidden="true"></div>
            <div class="wrap cine-copy">
              {hero.eyebrow && <div class="cine-eyebrow">{hero.eyebrow}</div>}
              <h1 data-long={longTitle} set:html={title(hero.title)} />
              <p class="lede">{hero.lede}</p>
              <div class="actions">
                {hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}
                {hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}
              </div>
            </div>
            <a class="cine-cue" href="#main-content" aria-label="Scroll to the content"><span>Scroll</span><i></i></a>
          </div>
        </section>
      ) : (
      <section class="hero" id="top" data-variant={variant}>
        <Decor demo={demo} kind={variant} tone={variant === 'photo' || (variant === 'banner' && ratio('#ffffff', colors.primary) >= ratio('#111111', colors.primary)) ? 'dark' : 'light'} />
        {/* Behind a dark overlay on phones, so the 640px copy is plenty: a 50vw hint makes high-density phones pick it. */}
        {variant === 'photo' && hero.image && <img class="bg" style={tint(hero.image)} src={hero.image.src} srcset={srcset(hero.image)} sizes="(max-width: 860px) 50vw, 100vw" alt="" width={hero.image.width} height={hero.image.height} fetchpriority="high" />}
        <div class="wrap">
          <div>
            {hero.eyebrow && <div class="eyebrow">{hero.eyebrow}</div>}
            <h1 data-long={longTitle} set:html={title(hero.title)} />
            <p class="lede">{hero.lede}</p>
            <div class="actions">
              {hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}
              {hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}
            </div>
            {hero.points && (
              <ul class="points">
                {hero.points.map((p) => <li><Icon name="check" size={18} stroke={2.6} />{p}</li>)}
              </ul>
            )}
          </div>
          {variant !== 'photo' && (
            <div class={`hero-visual${lowResWide ? ' wide-frame' : ''}`}>
              {hero.image ? (
                <>
                  <div class={`frame ${hero.image.fit === 'contain' ? 'contain' : ''}`}>
                    <img style={tint(hero.image)} src={hero.image.src} srcset={srcset(hero.image)} sizes={coverSizes(hero.image, lowResWide ? 1.6 : 4 / 4.4, [85, 42], 860, true)} alt={hero.image.alt} width={hero.image.width} height={hero.image.height} fetchpriority="high" />
                  </div>
                  {demo.established && (
                    <div class="chip"><Icon name="award" size={26} /><span><strong>Since {demo.established}</strong>{demo.town}</span></div>
                  )}
                </>
              ) : (
                <div class="panel"><Seal top={short} bottom={sealBottom} icon={demo.icon} id={`seal-${demo.slug}`} /></div>
              )}
            </div>
          )}
        </div>
      </section>
      )}

      <span id="main-content"></span>
      {ribbon && (
        <div class="fx-ribbon-wrap">
        <div class="fx-ribbon" aria-hidden="true">
          <div class="fx-band b2"><div class="fx-track">{[...ribbonWords, ...ribbonWords, ...ribbonWords, ...ribbonWords].map((w) => <span>{w}<svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.2 3.3 8 8.5 8.6-5.2.6-7.9 3.3-8.5 8.5-.6-5.2-3.3-7.9-8.5-8.5 5.2-.6 7.9-3.4 8.5-8.6z" /></svg></span>)}</div></div>
          <div class="fx-band b1"><div class="fx-track">{[...ribbonWords, ...ribbonWords, ...ribbonWords, ...ribbonWords].map((w) => <span>{w}<svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.2 3.3 8 8.5 8.6-5.2.6-7.9 3.3-8.5 8.5-.6-5.2-3.3-7.9-8.5-8.5 5.2-.6 7.9-3.4 8.5-8.6z" /></svg></span>)}</div></div>
        </div>
          <MotionToggle />
        </div>
      )}
      {demo.facts && !factsInHero && (
        <section class="facts" aria-label="At a glance">
          <div class="wrap"><ul>{demo.facts.map((f) => <li style={`--ch:${factCh(f.value)}`}><strong>{f.value}</strong><span>{f.label}</span></li>)}</ul>{st.facts === 'ticker' && <ul aria-hidden="true">{demo.facts.map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}</ul>}</div>{st.facts === 'ticker' && <MotionToggle />}
        </section>
      )}

      <Sections demo={demo} />

      <section class={`section visit ${demo.sections.length % 2 === 1 ? 'alt' : ''}`} id="visit">
        <div class="wrap">
          <div class="section-head">
            <div class="eyebrow">Get in touch</div>
            <h2 set:html={title(demo.visit?.title || 'Come *see us*')} />
            {demo.visit?.intro && <p>{demo.visit.intro}</p>}
          </div>
          <div class={`grid ${!mapSrc && demo.visit?.hideForm ? 'solo' : ''}`}>
            <div class="info">
              {contact.phone && (
                <div class="row"><Icon name="phone" size={22} /><div>
                  <h3>{contact.phoneLabel || 'Call'}</h3>
                  <a class="big" href={telHref(contact.phone)} data-call>{contact.phone}</a>
                  {contact.phone2 && <p style="margin-top:6px">{contact.phone2Label || 'Also'}: <a class="tel2" href={telHref(contact.phone2)}>{contact.phone2}</a></p>}
                </div></div>
              )}
              {contact.email && (
                <div class="row"><Icon name="mail" size={22} /><div>
                  <h3>Email</h3><a class="mail" href={`mailto:${contact.email}`}>{contact.email.split('@')[0]}@<wbr />{contact.email.split('@')[1]}</a>
                </div></div>
              )}
              {contact.address && (
                <div class="row"><Icon name="map-pin" size={22} /><div>
                  <h3>Find us</h3>
                  <p>{contact.address.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
                  {(directions || contact.address) && <div class="chips">
                    {directions && <a class="chip" href={directions} target="_blank" rel="noopener" data-directions={contact.mapQuery}><Icon name="navigation" size={17} stroke={2.2} />Get directions</a>}
                    <button class="chip desk-only" type="button" data-copy={contact.address.join(', ')} data-copied="Address copied"><Icon name="copy" size={17} stroke={2.1} />Copy address</button>
                  </div>}
                </div></div>
              )}
              {contact.hours && (
                <div class="row"><Icon name="clock" size={22} /><div>
                  <div class="hours-head"><h3>Hours</h3>{hoursSpec && <p class="open-now" data-open-now hidden></p>}</div>
                  <table class="hours"><tbody>{contact.hours.map(([d, h]) => <tr data-days={d}><td>{d}</td><td>{h.split(/\s+·\s+/).map((part) => <span class={part.length > 22 ? 'long' : undefined}>{part}</span>)}</td></tr>)}</tbody></table>
                  {contact.hoursNote && <p class="footnote">{contact.hoursNote}</p>}
                </div></div>
              )}
              {(contact.facebook || contact.instagram) && (
                <div class="row"><Icon name="share-2" size={22} /><div>
                  <h3>Follow</h3>
                  <div class="chips">
                    {contact.facebook && <a class="chip" href={contact.facebook} target="_blank" rel="noopener">Facebook<Icon name="arrow-up-right" size={16} stroke={2.2} /></a>}
                    {contact.instagram && <a class="chip" href={contact.instagram} target="_blank" rel="noopener">Instagram<Icon name="arrow-up-right" size={16} stroke={2.2} /></a>}
                  </div>
                </div></div>
              )}
              <div class="row keep"><Icon name="user-plus" size={22} /><div>
                <h3>Keep us handy</h3>
                <div class="chips">
                  <a class="chip" href={vcard} download={vcardName}><Icon name="contact" size={17} stroke={2.1} />Save to contacts</a>
                  <button class="chip" type="button" data-share><Icon name="share-2" size={17} stroke={2.1} />Share</button>
                </div>
              </div></div>
              <div class="send-phone desk-only">
                <span class="send-qr" set:html={phoneQr} role="img" aria-label={`QR code that opens this page on a phone`}></span>
                <p><b>Open it on your phone</b> Scan to call or get directions in one tap.</p>
              </div>
            </div>
            <div>
              {mapSrc && streets && (
                <div class="map map-drawn" data-map>
                  <span class="map-ph" aria-hidden="true"><StreetMap data={streets} id={`map-${demo.slug}`} /><span class="map-pin"><Icon name="map-pin" size={30} stroke={2} /></span>{contact.address && <span class="map-addr">{contact.address[0]}</span>}</span>
                  <button class="map-live" type="button" data-map-src={mapSrc} data-map-title={`Map to ${demo.name}`}><Icon name="map" size={17} stroke={2.1} />Interactive map</button>
                  <a class="map-credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a>
                </div>
              )}
              {mapSrc && !streets && <div class="map"><span class="map-ph" aria-hidden="true"><i class="road a"></i><i class="road b"></i><i class="road c"></i><i class="road d"></i><span class="map-pin"><Icon name="map-pin" size={30} stroke={2} /></span>{contact.address && <span class="map-addr">{contact.address[0]}</span>}</span><iframe src={mapSrc} title={`Map to ${demo.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>}
              {!demo.visit?.hideForm && (
                <form class="form" data-form data-to={contact.email || ""} data-biz={short} novalidate>
                  <h3>{demo.visit?.formTitle || 'Send us a message'}</h3>
                  <div class="two">
                    <label>Name<input type="text" name="name" autocomplete="name" /></label>
                    <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
                  </div>
                  <label>Email<input type="email" name="email" autocomplete="email" /></label>
                  {demo.visit?.formTopics && (
                    <label>What can we help with?<select name="topic">{demo.visit.formTopics.map((t) => <option>{t}</option>)}</select></label>
                  )}
                  <label>Message<textarea name="message"></textarea></label>
                  <button class="btn" type="submit">Send message</button>
                  <p class="form-missing" role="alert" data-form-missing hidden>Add your name and a phone number or email, so we can get back to you.</p>
                  <p class="sent" role="status" data-form-sent>Thanks! In the live site this lands in your inbox. (Preview only: nothing was sent.)</p>
                  <p class="note">Preview form: it is not connected and collects nothing.</p>
                </form>
              )}
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="top">
          <div>
            <div class="word"><span class="foot-mark"><Icon name={demo.icon} size={20} /><span class="glint"></span></span>{demo.name}</div>
            <p style="margin-top:12px;max-width:28em">{hero.lede.split(/(?<!\b(?:Dr|Drs|Mr|Mrs|Ms|St|Jr|Sr|Mt|No|vs|Inc|Co|[A-Z])\.)(?<=[.!?])\s/)[0]}</p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              {contact.phone && <li><a href={telHref(contact.phone)}>{contact.phone}</a></li>}
              {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
              {contact.address && <li>{contact.address.join(', ')}</li>}
