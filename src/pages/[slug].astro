---
// One redesign concept per business: /<slug>/
import '../styles/demo.css';
import '../styles/personality.css';
import '../styles/vivid.css';
import Icon from '../components/Icon.astro';
import Seal from '../components/demo/Seal.astro';
import Sections from '../components/demo/Sections.astro';
import Hero from '../components/demo/Hero.astro';
import Decor from '../components/demo/Decor.astro';
import { demos, fonts, telHref, title, sectionId, srcset, cinematicHero, offerWords, type Demo } from '../lib/demos';
import { site } from '../lib/site';
import { businessLd } from '../lib/schema';
import { accessible, ratio } from '../lib/contrast';

export function getStaticPaths() {
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}
interface Props { demo: Demo }
const { demo } = Astro.props;
const { contact, hero, colors } = demo;

const display = fonts[demo.fonts.display];
const body = fonts[demo.fonts.body];
const accentFont = demo.fonts.accent ? fonts[demo.fonts.accent] : undefined;
const faces = [...new Map([display, body, accentFont].filter(Boolean).map((f) => [f!.family, f!])).values()];
const fontCss = faces.map((f) =>
  `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}` +
  (f.italic ? `@font-face{font-family:"${f.family}";src:url(${f.italic}) format("woff2");font-weight:100 900;font-style:italic;font-display:swap}` : '')
).join('');
const safe = accessible(colors);
const vars = [
  `--bg:${colors.bg}`, `--surface:${colors.surface}`, `--ink:${colors.ink}`, `--muted:${colors.muted}`,
  `--primary:${colors.primary}`, `--on-primary:${colors.onPrimary}`, `--accent:${colors.accent}`, `--line:${colors.line}`,
  `--radius:${demo.radius ?? 10}px`,
  `--font-display:"${display.family}",${display.fallback}`, `--font-body:"${body.family}",${body.fallback}`,
  ...(accentFont ? [`--font-accent:"${accentFont.family}",${accentFont.fallback}`] : []),
  ...Object.entries(safe).map(([k, v]) => `${k}:${v}`),
].join(';');

const nav = [
  ...demo.sections.map((s, i) => ('nav' in s && s.nav ? { label: s.nav, href: `#${sectionId(s, i)}` } : null)).filter(Boolean),
  { label: 'Contact', href: '#visit' },
] as { label: string; href: string }[];
const variant = hero.variant || (hero.image ? 'split' : 'banner');
// Cinematic concepts (photo-heavy) get a full-screen, scroll-driven hero.
const cine = !!demo.cinematic;
// Personality: a hero archetype and section treatments chosen per concept.
const st = demo.style || {};
const archetype = !cine ? st.hero : undefined;
// The blueprint and magazine heroes already set out the key facts.
const factsInHero = archetype === 'blueprint' || archetype === 'magazine';
const cineImg = cine ? cinematicHero(demo) : undefined;
// A slanted ribbon of what they offer, in their colours (the poster hero and the
// facts ticker already scroll, so they skip it).
const ribbonWords = offerWords(demo, 6);
const ribbon = ribbonWords.length >= 2 && archetype !== 'poster' && st.facts !== 'ticker';
const short = demo.short || demo.name;
const sealBottom = [demo.town.replace(/,?\s*SC$/i, ', South Carolina'), demo.established ? `Est. ${demo.established}` : ''].filter(Boolean).join(' · ');
const mapSrc = contact.mapQuery ? `https://www.google.com/maps?q=${encodeURIComponent(contact.mapQuery)}&output=embed` : '';
const directions = contact.mapQuery ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(contact.mapQuery)}` : '';
const sourceHost = new URL(demo.source.url).hostname.replace(/^www\./, '');
const after = demo.source.after || [
  'Designed phone-first: reads and taps comfortably on any screen',
  'One-tap call, directions and email from every page',
  'Served over HTTPS with no plugins to patch or break',
  'Loads in well under a second: static pages, optimised images, self-hosted fonts',
  'Clear headings, alt text and contrast for accessibility and for Google',
  'Hours, address and services in one obvious place',
];
const year = new Date().getFullYear();

// The business details Google reads (schema.org). Part of what the real site would ship.
const ld = businessLd(demo, site.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${demo.name} — website concept`}</title>
    <meta name="description" content={`A redesign concept for ${demo.name} in ${demo.town}. Not the business's official website.`} />
    <meta name="theme-color" content={colors.primary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${demo.name}: a website concept`} />
    <meta property="og:description" content={hero.lede} />
    {site.url && <meta property="og:url" content={`${site.url}/${demo.slug}/`} />}
    {site.url && <meta property="og:image" content={`${site.url}/shots/${demo.slug}-after.jpg`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="${colors.primary}"/><text x="16" y="22" font-size="17" font-family="Georgia,serif" font-weight="700" text-anchor="middle" fill="${colors.onPrimary}">${short.replace(/^the\s+/i, '').charAt(0)}</text></svg>`)}`} />
    <link rel="preload" href={display.normal} as="font" type="font/woff2" crossorigin />
    {body.normal !== display.normal && <link rel="preload" href={body.normal} as="font" type="font/woff2" crossorigin />}
    <style set:html={fontCss} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="demo" data-look={demo.look} data-cinematic={demo.cinematic ? '' : undefined} data-hero={archetype} data-frame={st.frame} data-flip={st.flip ? '' : undefined} data-services={st.services} data-facts={st.facts} data-pattern={st.pattern} data-divider={st.divider} data-heads={st.heads} data-motion={st.motion} data-buttons={st.buttons} style={vars}>
    <a class="skip" href="#main">Skip to content</a>

    <aside class="concept" aria-label="About this preview">
      <div class="wrap">
        <span class="dot"></span>
        <span class="grow"><b>Concept preview.</b> <span class="long">{demo.source.none ? `A first-website idea for ${demo.name}, which has no site of its own yet.` : `A redesign idea for ${demo.name}, not their live website (${sourceHost}).`}</span><span class="short">Not the live site.</span></span>
        <button type="button" data-open-notes>What changed?</button>
        <a href="/">{site.name}</a>
      </div>
    </aside>

    <header class="site-head" data-head>
      <div class="wrap">
        <a class="brand" href="#top" aria-label={`${demo.name} home`}>
          {demo.logo
            ? <span class="logo" style={`--logo:url(${demo.logo.src})`}><img src={demo.logo.src} alt={demo.logo.alt} width={demo.logo.width} height={demo.logo.height} /><span class="glint" aria-hidden="true"></span></span>
            : <><span class="mark"><Icon name={demo.icon} size={22} /><span class="glint" aria-hidden="true"></span></span><span class="word">{short}<small>{demo.town}</small></span></>}
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        {contact.phone && (
          <a class="head-cta" href={telHref(contact.phone)}>
            <Icon name="phone" size={18} stroke={2.2} /><span class="long">Call </span>{contact.phone}
          </a>
        )}
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" data-menu><Icon name="menu" size={22} /></button>
      </div>
    </header>

    <main id="main">
      {archetype ? <Hero demo={demo} kind={archetype} /> : cine && cineImg ? (
        <section class="cine-hero" id="top" data-cine-hero>
          <div class="cine-stick">
            <img class="cine-bg" src={cineImg.src} srcset={srcset(cineImg)} sizes="100vw" alt="" width={cineImg.width} height={cineImg.height} fetchpriority="high" />
            <div class="cine-wash" aria-hidden="true"></div>
            <div class="cine-grain" aria-hidden="true"></div>
            <div class="wrap cine-copy">
              {hero.eyebrow && <div class="cine-eyebrow">{hero.eyebrow}</div>}
              <h1 set:html={title(hero.title)} />
              <p class="lede">{hero.lede}</p>
              <div class="actions">
                {hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}
                {hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}
              </div>
            </div>
            <a class="cine-cue" href="#main-content" aria-label="Scroll to the content"><span>Scroll</span><i></i></a>
          </div>
        </section>
      ) : (
      <section class="hero" id="top" data-variant={variant}>
        <Decor demo={demo} kind={variant} tone={variant === 'photo' || (variant === 'banner' && ratio('#ffffff', colors.primary) >= ratio('#111111', colors.primary)) ? 'dark' : 'light'} />
        {/* Behind a dark overlay on phones, so the 640px copy is plenty: a 50vw hint makes high-density phones pick it. */}
        {variant === 'photo' && hero.image && <img class="bg" src={hero.image.src} srcset={srcset(hero.image)} sizes="(max-width: 860px) 50vw, 100vw" alt="" width={hero.image.width} height={hero.image.height} fetchpriority="high" />}
        <div class="wrap">
          <div>
            {hero.eyebrow && <div class="eyebrow">{hero.eyebrow}</div>}
            <h1 set:html={title(hero.title)} />
            <p class="lede">{hero.lede}</p>
            <div class="actions">
              {hero.cta && <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>}
              {hero.cta2 && <a class="btn ghost" href={hero.cta2.href}>{hero.cta2.label}</a>}
            </div>
            {hero.points && (
              <ul class="points">
                {hero.points.map((p) => <li><Icon name="check" size={18} stroke={2.6} />{p}</li>)}
              </ul>
            )}
          </div>
          {variant !== 'photo' && (
            <div class="hero-visual">
              {hero.image ? (
                <>
                  <div class={`frame ${hero.image.fit === 'contain' ? 'contain' : ''}`}>
                    <img src={hero.image.src} srcset={srcset(hero.image)} sizes="(max-width: 860px) 85vw, 42vw" alt={hero.image.alt} width={hero.image.width} height={hero.image.height} fetchpriority="high" />
                  </div>
                  {demo.established && (
                    <div class="chip"><Icon name="award" size={26} /><span><strong>Since {demo.established}</strong>{demo.town}</span></div>
                  )}
                </>
              ) : (
                <div class="panel"><Seal top={short} bottom={sealBottom} icon={demo.icon} id={`seal-${demo.slug}`} /></div>
              )}
            </div>
          )}
        </div>
      </section>
      )}

      <span id="main-content"></span>
      {ribbon && (
        <div class="fx-ribbon" aria-hidden="true">
          <div class="fx-band b2"><div class="fx-track">{[...ribbonWords, ...ribbonWords, ...ribbonWords, ...ribbonWords].map((w) => <span>{w}<svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.2 3.3 8 8.5 8.6-5.2.6-7.9 3.3-8.5 8.5-.6-5.2-3.3-7.9-8.5-8.5 5.2-.6 7.9-3.4 8.5-8.6z" /></svg></span>)}</div></div>
          <div class="fx-band b1"><div class="fx-track">{[...ribbonWords, ...ribbonWords, ...ribbonWords, ...ribbonWords].map((w) => <span>{w}<svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.2 3.3 8 8.5 8.6-5.2.6-7.9 3.3-8.5 8.5-.6-5.2-3.3-7.9-8.5-8.5 5.2-.6 7.9-3.4 8.5-8.6z" /></svg></span>)}</div></div>
        </div>
      )}
      {demo.facts && !factsInHero && (
        <section class="facts" aria-label="At a glance">
          <div class="wrap"><ul>{demo.facts.map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}</ul>{st.facts === 'ticker' && <ul aria-hidden="true">{demo.facts.map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}</ul>}</div>
        </section>
      )}

      <Sections demo={demo} />

      <section class={`section visit ${demo.sections.length % 2 === 1 ? 'alt' : ''}`} id="visit">
        <div class="wrap">
          <div class="section-head">
            <div class="eyebrow">Get in touch</div>
            <h2 set:html={title(demo.visit?.title || 'Come *see us*')} />
            {demo.visit?.intro && <p>{demo.visit.intro}</p>}
          </div>
          <div class={`grid ${!mapSrc && demo.visit?.hideForm ? 'solo' : ''}`}>
            <div class="info">
              {contact.phone && (
                <div class="row"><Icon name="phone" size={22} /><div>
                  <h3>{contact.phoneLabel || 'Call'}</h3>
                  <a class="big" href={telHref(contact.phone)}>{contact.phone}</a>
                  {contact.phone2 && <p style="margin-top:6px">{contact.phone2Label || 'Also'}: <a href={telHref(contact.phone2)}>{contact.phone2}</a></p>}
                </div></div>
              )}
              {contact.email && (
                <div class="row"><Icon name="mail" size={22} /><div>
                  <h3>Email</h3><a href={`mailto:${contact.email}`}>{contact.email}</a>
                </div></div>
              )}
              {contact.address && (
                <div class="row"><Icon name="map-pin" size={22} /><div>
                  <h3>Find us</h3>
                  <p>{contact.address.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
                  {directions && <p><a href={directions} target="_blank" rel="noopener">Get directions</a></p>}
                </div></div>
              )}
              {contact.hours && (
                <div class="row"><Icon name="clock" size={22} /><div>
                  <h3>Hours</h3>
                  <table class="hours"><tbody>{contact.hours.map(([d, h]) => <tr data-days={d}><td>{d}</td><td>{h}</td></tr>)}</tbody></table>
                  {contact.hoursNote && <p class="footnote">{contact.hoursNote}</p>}
                </div></div>
              )}
              {(contact.facebook || contact.instagram) && (
                <div class="row"><Icon name="share-2" size={22} /><div>
                  <h3>Follow</h3>
                  <p>
                    {contact.facebook && <a href={contact.facebook} target="_blank" rel="noopener">Facebook</a>}
                    {contact.facebook && contact.instagram && ' · '}
                    {contact.instagram && <a href={contact.instagram} target="_blank" rel="noopener">Instagram</a>}
                  </p>
                </div></div>
              )}
            </div>
            <div>
              {mapSrc && <div class="map"><iframe src={mapSrc} title={`Map to ${demo.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>}
              {!demo.visit?.hideForm && (
                <form class="form" data-form novalidate>
                  <h3>{demo.visit?.formTitle || 'Send us a message'}</h3>
                  <div class="two">
                    <label>Name<input type="text" name="name" autocomplete="name" /></label>
                    <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
                  </div>
                  <label>Email<input type="email" name="email" autocomplete="email" /></label>
                  {demo.visit?.formTopics && (
                    <label>What can we help with?<select name="topic">{demo.visit.formTopics.map((t) => <option>{t}</option>)}</select></label>
                  )}
                  <label>Message<textarea name="message"></textarea></label>
                  <button class="btn" type="submit">Send message</button>
                  <p class="sent" role="status">Thanks! In the live site this lands in your inbox. (Preview only: nothing was sent.)</p>
                  <p class="note">Preview form: it is not connected and collects nothing.</p>
                </form>
              )}
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="top">
          <div>
            <div class="word"><span class="foot-mark"><Icon name={demo.icon} size={20} /><span class="glint"></span></span>{demo.name}</div>
            <p style="margin-top:12px;max-width:28em">{hero.lede.split(/(?<=[.!?])\s/)[0]}</p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              {contact.phone && <li><a href={telHref(contact.phone)}>{contact.phone}</a></li>}
              {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
              {contact.address && <li>{contact.address.join(', ')}</li>}
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {year} {demo.name}</span>
          <span>Website concept by {site.name}. Not affiliated with or endorsed by {demo.name.replace(/\.$/, '')}.</span>
        </div>
      </div>
    </footer>

    {contact.phone && (
      <div class="callbar">
        <a href={telHref(contact.phone)}><Icon name="phone" size={18} stroke={2.4} />Call now</a>
        {directions && <a class="alt" href={directions} target="_blank" rel="noopener"><Icon name="navigation" size={18} stroke={2.2} />Directions</a>}
      </div>
    )}

    <dialog class="notes" data-notes aria-labelledby="notes-title">
      <header>
        <h2 id="notes-title">What this concept changes</h2>
        <button class="close" type="button" data-close-notes aria-label="Close">×</button>
      </header>
      <div class="cols">
        <div><h3>{demo.source.none ? 'Today' : 'The current site'}</h3><ul>{demo.source.before.map((b) => <li>{b}</li>)}</ul></div>
        <div class="after"><h3>This concept</h3><ul>{after.map((b) => <li>{b}</li>)}</ul></div>
      </div>
      <p class="fine" style="padding-bottom:10px"><a href={`/${demo.slug}/report/`}><b>See the one-page website checkup →</b></a></p>
      {(site.contactPhone || site.contactEmail) && (
        <p class="notes-contact">Like it? Talk to {site.name}:{site.contactPhone && <> <a href={telHref(site.contactPhone)}>{site.contactPhone}</a></>}{site.contactPhone && site.contactEmail && ' · '}{site.contactEmail && <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(`Website concept for ${demo.name}`)}`}>{site.contactEmail}</a>}</p>
      )}
      <p class="fine">
        Words, hours and photos here come from {demo.source.none ? `the public listing for ${demo.name}` : `${demo.name}'s own public pages`} (<a href={demo.source.url} target="_blank" rel="noopener nofollow">{sourceHost}</a>) and would be confirmed with the owner before anything goes live.
      </p>
    </dialog>

    <script is:inline>
      (() => {
        const head = document.querySelector('[data-head]');
        const btn = document.querySelector('[data-menu]');
        btn?.addEventListener('click', () => { const open = head.classList.toggle('open'); btn.setAttribute('aria-expanded', String(open)); });
        head?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => { head.classList.remove('open'); btn?.setAttribute('aria-expanded', 'false'); }));

        const dlg = document.querySelector('[data-notes]');
        document.querySelector('[data-open-notes]')?.addEventListener('click', () => dlg.showModal());
        document.querySelector('[data-close-notes]')?.addEventListener('click', () => dlg.close());
        dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

        document.querySelector('[data-form]')?.addEventListener('submit', (e) => { e.preventDefault(); e.currentTarget.classList.add('done'); });

        // Highlight today's row in the hours table.
        const names = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
        const today = new Date().getDay();
        document.querySelectorAll('.hours tr[data-days]').forEach((tr) => {
          const d = tr.dataset.days.toLowerCase();
          const hit = d.match(/(sun|mon|tue|wed|thu|fri|sat)\w*\s*(?:[-–—]|to|through)\s*(sun|mon|tue|wed|thu|fri|sat)/);
          let on = false;
          if (/daily|every day|7 days/.test(d)) on = true;
          else if (hit) { const a = names.indexOf(hit[1]), b = names.indexOf(hit[2]); on = a <= b ? today >= a && today <= b : today >= a || today <= b; }
          else on = d.split(/[,&/]|\band\b/).some((p) => names[today] && p.trim().startsWith(names[today]));
          if (on) tr.classList.add('today');
        });

        // Motion: sections rise in as they scroll into view, and cards get a
        // spotlight that follows the pointer. Skipped for reduced motion and
        // for automated browsers (screenshots and page tests see the final state).
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && !navigator.webdriver) {
          document.documentElement.classList.add('motion');
          const io = new IntersectionObserver((entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }), { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('main > .section .section-head, .cine-gallery .section-head, .cards > li, .gallery figure, .steps li, .quotes figure, .faq details, .menu-group, .story .wrap > *, .band .wrap > *, .visit .wrap > *').forEach((el) => {
            const i = Array.prototype.indexOf.call(el.parentElement.children, el);
            el.style.setProperty('--d', `${(i % 6) * 70}ms`);
            el.classList.add('reveal');
            io.observe(el);
          });

          // The hero photo tilts a little toward the pointer.
          const visual = document.querySelector('.hero-visual');
          const frameEl = visual?.querySelector('.frame');
          if (frameEl && matchMedia('(hover: hover)').matches) {
            visual.addEventListener('pointermove', (e) => {
              const r = visual.getBoundingClientRect();
              frameEl.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 8}deg`);
              frameEl.style.setProperty('--rx', `${(0.5 - (e.clientY - r.top) / r.height) * 8}deg`);
            });
            visual.addEventListener('pointerleave', () => { frameEl.style.setProperty('--rx', '0deg'); frameEl.style.setProperty('--ry', '0deg'); });
          }

          // Facts that start with a number count up when they come into view.
          const counters = [...document.querySelectorAll('.facts strong')].filter((el) => /^\d{1,3}(?!\d)/.test(el.textContent.trim()));
          if (counters.length) {
            const cio = new IntersectionObserver((entries) => entries.forEach((e) => {
              if (!e.isIntersecting) return;
              cio.unobserve(e.target);
              const el = e.target, full = el.textContent, m = full.match(/^(\d{1,3})/), end = Number(m[1]), rest = full.slice(m[1].length), t0 = performance.now();
              const step = (t) => { const k = Math.min(1, (t - t0) / 1400); el.textContent = `${Math.round(end * (1 - Math.pow(1 - k, 3)))}${rest}`; if (k < 1) requestAnimationFrame(step); else el.textContent = full; };
              requestAnimationFrame(step);
            }), { threshold: 0.6 });
            counters.forEach((el) => cio.observe(el));
          }

          // Cinematic scroll engine: one rAF per scroll, only for what is near
          // the screen. --p is 0..1 progress; scenes get --e (entering) and
          // --c (covered by the next scene).
          const hero = document.querySelector('[data-cine-hero]');
          const tracks = [...document.querySelectorAll('[data-cine-track]')].map((t) => ({ t, scenes: [...t.querySelectorAll('.scene')] }));
          const pars = [...document.querySelectorAll('[data-par]')];
          if (hero || tracks.length || pars.length) {
            const clamp = (x) => (x < 0 ? 0 : x > 1 ? 1 : x);
            let queued = false;
            // Pinned panels sit below the sticky header (--head), so each is h - head tall.
            const head = parseFloat(getComputedStyle(document.body).getPropertyValue('--head')) || 0;
            const frame = () => {
              queued = false;
              const h = innerHeight, H = Math.max(1, h - head);
              if (hero) {
                const r = hero.getBoundingClientRect();
                if (r.bottom > 0) hero.style.setProperty('--p', clamp((head - r.top) / Math.max(1, r.height - H)).toFixed(4));
              }
              for (const { t, scenes } of tracks) {
                const r = t.getBoundingClientRect();
                if (r.top > h * 1.5 || r.bottom < -h * 0.5) continue;
                const s = (h - r.top) / H; // scene i is fully in when s reaches i + 1
                scenes.forEach((el, i) => {
                  el.style.setProperty('--e', clamp(s - i).toFixed(4));
                  el.style.setProperty('--c', clamp(s - i - 1).toFixed(4));
                });
              }
              for (const el of pars) {
                const r = el.getBoundingClientRect();
                if (r.bottom < -200 || r.top > h + 200) continue;
                el.style.setProperty('--p', clamp((h - r.top) / (h + r.height)).toFixed(4));
              }
            };
            addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(frame); } }, { passive: true });
            addEventListener('resize', frame);
            frame();
          }
        }
        const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
        const moving = document.documentElement.classList.contains('motion');
        document.querySelectorAll('.card').forEach((card) => card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const x = e.clientX - r.left, y = e.clientY - r.top;
          card.style.setProperty('--mx', `${x}px`);
          card.style.setProperty('--my', `${y}px`);
          // A gentle 3D tilt toward the pointer, with a glare that follows it.
          if (moving && fine) { card.style.setProperty('--ry', `${(x / r.width - 0.5) * 9}deg`); card.style.setProperty('--rx', `${(0.5 - y / r.height) * 9}deg`); }
        }));
        document.querySelectorAll('.card').forEach((card) => card.addEventListener('pointerleave', () => { card.style.setProperty('--rx', '0deg'); card.style.setProperty('--ry', '0deg'); }));

        if (moving) {
          // Headline: each word settles in from a soft blur, one after another.
          document.querySelectorAll('.hero h1, .cine-hero h1').forEach((h) => {
            let i = 0;
            const walk = (node) => [...node.childNodes].forEach((n) => {
              if (n.nodeType === 3) {
                const frag = document.createDocumentFragment();
                n.textContent.split(/(\s+)/).forEach((part) => {
                  if (!part) return;
                  if (/^\s+$/.test(part)) { frag.append(part); return; }
                  const w = document.createElement('span'); w.className = 'fx-w'; w.style.setProperty('--i', i++); w.textContent = part; frag.append(w);
                });
                n.replaceWith(frag);
              } else if (n.nodeType === 1) walk(n);
            });
            walk(h);
            h.classList.add('fx-split');
          });

          // Hero depth: badges, rings and sparkles drift at their own speed as
          // the page scrolls, lean toward the pointer, and a glow follows it.
          document.querySelectorAll('[data-fx]').forEach((fx) => {
            const host = fx.parentElement;
            let q = false, px = 0, py = 0, gx = 0, gy = 0;
            const paint = () => {
              q = false;
              const r = host.getBoundingClientRect();
              if (r.bottom < 0 || r.top > innerHeight) return;
              host.style.setProperty('--sy', String(Math.round(-r.top)));
              host.style.setProperty('--px', px.toFixed(3));
              host.style.setProperty('--py', py.toFixed(3));
              host.style.setProperty('--gx', `${gx}px`);
              host.style.setProperty('--gy', `${gy}px`);
            };
            const ask = () => { if (!q) { q = true; requestAnimationFrame(paint); } };
            addEventListener('scroll', ask, { passive: true });
            if (fine) host.addEventListener('pointermove', (e) => {
              const r = host.getBoundingClientRect();
              gx = Math.round(e.clientX - r.left); gy = Math.round(e.clientY - r.top);
              px = gx / r.width - 0.5; py = gy / r.height - 0.5; ask();
            });
            host.classList.add('fx-live');
            paint();
          });

          // Buttons lean toward the pointer a little (magnetic).
          if (fine) document.querySelectorAll('.hero .btn, .cine-hero .btn, .band .btn').forEach((b) => {
            b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.setProperty('--bx', `${((e.clientX - r.left) / r.width - 0.5) * 10}px`); b.style.setProperty('--by', `${((e.clientY - r.top) / r.height - 0.5) * 8}px`); });
            b.addEventListener('pointerleave', () => { b.style.setProperty('--bx', '0px'); b.style.setProperty('--by', '0px'); });
          });

          // Decorative loops start on the first interaction (see vivid.css).
          // Chrome sends synthetic pointer moves after layout changes (to update
          // hover), so a move only counts when the pointer really moved.
          const kinds = ['pointermove', 'pointerdown', 'wheel', 'keydown', 'touchstart'];
          const wake = (e) => {
            if (e.type === 'pointermove' && !(e.isTrusted && (e.movementX || e.movementY))) return;
            document.documentElement.classList.add('awake');
            kinds.forEach((t) => removeEventListener(t, wake));
          };
          kinds.forEach((t) => addEventListener(t, wake, { passive: true }));

          // The header settles into a tinted glass bar once the page scrolls.
          const sh = document.querySelector('[data-head]');
          const tick = () => sh?.classList.toggle('scrolled', scrollY > 24);
          addEventListener('scroll', tick, { passive: true }); tick();
        }
      })();
    </script>
  </body>
</html>
