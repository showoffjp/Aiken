          </div>
        </div>
        <div class="legal">
          <span>© {year} {demo.name}</span>
          <span>Website concept by <a href="/">{site.name}</a>. Not affiliated with or endorsed by {demo.name.replace(/\.$/, '')}.</span>
          <MotionToggle variant="link" />
        </div>
      </div>
    </footer>

    {contact.phone && (
      <nav class="callbar" aria-label="Quick contact">
        <a href={telHref(contact.phone)}><Icon name="phone" size={18} stroke={2.4} />Call now</a>
        {directions && <a class="alt" href={directions} target="_blank" rel="noopener" data-directions={contact.mapQuery}><Icon name="navigation" size={18} stroke={2.2} />Directions</a>}
      </nav>
    )}

    <a class="to-top" href="#top" aria-label="Back to top" data-to-top tabindex="-1"><Icon name="arrow-up" size={22} stroke={2.2} /></a>
    <div class="toast" role="status" aria-live="polite" data-toast><span data-toast-text></span></div>
    <aside class="tour" aria-label="Guided tour of this concept" data-tour hidden data-food={demo.group === 'Food & Drink' ? '' : undefined} data-studio={site.contactName ? `${site.contactName} at ${site.name}` : site.name} data-studio-phone={site.contactPhone || undefined}>
      <div class="tour-ring" data-tour-ring aria-hidden="true"></div>
      <div class="tour-pop" role="dialog" aria-labelledby="tour-title" aria-describedby="tour-text" data-tour-pop>
        <p class="tour-count" data-tour-count></p>
        <p class="tour-title" id="tour-title" tabindex="-1" data-tour-title></p>
        <p class="tour-text" id="tour-text" data-tour-text></p>
        <div class="tour-actions">
          <button type="button" class="tour-close" data-tour-close>Close tour</button>
          <span class="tour-nav">
            <button type="button" class="tour-back" data-tour-back>Back</button>
            <button type="button" class="tour-next" data-tour-next>Next</button>
          </span>
        </div>
      </div>
    </aside>
    {hasPhotos && (
      <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
        <figure><figcaption><span data-lb-cap></span><span class="lb-count" data-lb-count></span></figcaption></figure>
        <button class="lb-btn lb-close" type="button" aria-label="Close photo viewer" data-lb-close><Icon name="x" size={24} stroke={2} /></button>
        <button class="lb-btn lb-prev" type="button" aria-label="Previous photo" data-lb-prev><Icon name="chevron-left" size={28} stroke={2} /></button>
        <button class="lb-btn lb-next" type="button" aria-label="Next photo" data-lb-next><Icon name="chevron-right" size={28} stroke={2} /></button>
      </dialog>
    )}

    <dialog class="notes" data-notes aria-labelledby="notes-title">
      <header>
        <h2 id="notes-title">What this concept changes</h2>
        <button class="close" type="button" data-close-notes aria-label="Close">×</button>
      </header>
      {beforeShot && afterShot && (
        <figure class="nc">
          <figcaption>Slide to compare today’s site with this concept</figcaption>
          <div class="nc-box" style="--pos:50%">
            <img src={afterShot} alt={`This concept for ${demo.name}`} width="1120" height="753" loading="lazy" decoding="async" />
            <img class="nc-before" src={beforeShot} alt={`${demo.name}'s current website`} width="1120" height="753" loading="lazy" decoding="async" />
            <span class="nc-line" aria-hidden="true"></span>
            <span class="nc-tag nc-l" aria-hidden="true">Today</span>
            <span class="nc-tag nc-r" aria-hidden="true">Concept</span>
            <input type="range" min="0" max="100" value="50" aria-label="Show more of today's site or of this concept" data-nc />
          </div>
        </figure>
      )}
      {nums.length > 0 && (
        <table class="nums">
          <caption>By the numbers: the current home page and this concept, measured the same way</caption>
          <thead><tr><th scope="col">Test</th><th scope="col">Today</th><th scope="col">Concept</th></tr></thead>
          <tbody>{nums.map((m) => <tr><th scope="row">{m.label}</th><td class="old">{m.today}</td><td class="new">{m.concept}</td></tr>)}</tbody>
        </table>
      )}
      <div class="cols">
        <div><h3>{demo.source.none ? 'Today' : 'The current site'}</h3><ul>{demo.source.before.map((b) => <li>{b}</li>)}</ul></div>
        <div class="after"><h3>This concept</h3><ul>{after.map((b) => <li>{b}</li>)}</ul><h3 class="also">Built in for customers</h3><ul>{builtIn(demo).map((b) => <li>{b}</li>)}</ul></div>
      </div>
      <p class="fine" style="padding-bottom:10px"><a href={`/${demo.slug}/report/`}><b>See the one-page website checkup →</b></a></p>
      {(site.contactPhone || site.contactEmail) && (
        <p class="notes-contact">Like it? Talk to {site.name}:{site.contactPhone && <> <a href={telHref(site.contactPhone)}>{site.contactPhone}</a></>}{site.contactPhone && site.contactEmail && ' · '}{site.contactEmail && <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(`Website concept for ${demo.name}`)}`}>{site.contactEmail}</a>}</p>
      )}
      <p class="fine">
        Words, hours and photos here come from {demo.source.none ? `the public listing for ${demo.name}` : `${demo.name}'s own public pages`} (<a href={demo.source.url} target="_blank" rel="noopener nofollow">{sourceHost}</a>) and would be confirmed with the owner before anything goes live.
      </p>
    </dialog>

    <script is:inline define:vars={{ swUrl: `/${demo.slug}/sw.js` }}>
      // Keep an offline copy of this page once it has loaded (see sw.js).
      if ('serviceWorker' in navigator) addEventListener('load', () => setTimeout(() => navigator.serviceWorker.register(swUrl).catch(() => {}), 1500));
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const head = document.querySelector('[data-head]');
        const btn = document.querySelector('[data-menu]');
        // Phone menu: a full-height sheet under the header, with call and directions at hand.
        const setMenu = (open) => {
          if (!head) return;
          if (open) head.style.setProperty('--menu-top', `${Math.max(0, Math.round(head.getBoundingClientRect().bottom))}px`);
          head.classList.toggle('open', open);
          root.classList.toggle('menu-open', open);
          btn?.setAttribute('aria-expanded', String(open));
          btn?.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
        };
        btn?.addEventListener('click', () => setMenu(!head.classList.contains('open')));
        head?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && head?.classList.contains('open')) { setMenu(false); btn?.focus(); } });
        matchMedia('(min-width: 941px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

        // A long menu on a narrow laptop: tighten the header (closer links, call button as an icon)
        // rather than let the menu slide under the logo.
        const brandEl = head?.querySelector('.brand');
        const fit = () => {
          if (!head || !brandEl) return;
          head.classList.remove('tight', 'tighter');
          const over = () => brandEl.scrollWidth > brandEl.clientWidth + 1;
          if (innerWidth > 940 && over()) { head.classList.add('tight'); if (over()) head.classList.add('tighter'); }
        };
        fit(); addEventListener('resize', fit); document.fonts?.ready.then(fit);

        // Open now? Checked against the clock in Aiken, whatever the visitor's time zone.
        const spec = JSON.parse(document.body.dataset.hours || 'null');
        if (spec) {
          const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
          const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).map((x) => [x.type, x.value]));
          // Holidays when regular hours often don't apply: say so rather than promise "Open now".
          const holiday = (offset) => {
            const t = new Date(Date.UTC(+parts.year, +parts.month - 1, +parts.day + offset));
            const y = t.getUTCFullYear(), m = t.getUTCMonth() + 1, d = t.getUTCDate(), wd = t.getUTCDay();
            const nth = (n) => Math.ceil(d / 7) === n, last = d + 7 > new Date(Date.UTC(y, m, 0)).getUTCDate();
            if (m === 1 && d === 1) return 'New Year’s Day';
            if (m === 5 && wd === 1 && last) return 'Memorial Day';
            if (m === 7 && d === 4) return 'Independence Day';
            if (m === 9 && wd === 1 && nth(1)) return 'Labor Day';
            if (m === 11 && wd === 4 && nth(4)) return 'Thanksgiving';
            if (m === 12 && d === 24) return 'Christmas Eve';
            if (m === 12 && d === 25) return 'Christmas Day';
            return '';
          };
          const day = DAYS.indexOf(parts.weekday), now = (+parts.hour % 24) * 60 + +parts.minute;
          const mins = (t) => +t.slice(0, 2) * 60 + +t.slice(3, 5);
          const fmt = (t) => { const h = +t.slice(0, 2), m = t.slice(3, 5); return `${h % 12 || 12}${m === '00' ? '' : `:${m}`} ${h < 12 ? 'am' : 'pm'}`; };
          const spans = (d) => spec.filter((x) => x.dayOfWeek.includes(DAYS[d])).sort((a, b) => mins(a.opens) - mins(b.opens));
          let state = 'closed', text = '';
          const cur = day < 0 ? null : spans(day).find((x) => now >= mins(x.opens) && now < mins(x.closes));
          if (holiday(0) && day >= 0 && spans(day).length) {
            state = 'holiday';
            text = `${holiday(0)} · hours may differ, call ahead`;
          } else if (cur) {
            const left = mins(cur.closes) - now;
            state = left <= 60 ? 'soon' : 'open';
            text = left <= 60 ? `Closing soon · ${fmt(cur.closes)}` : `Open now · until ${fmt(cur.closes)}`;
          } else if (day >= 0) {
            const later = spans(day).find((x) => mins(x.opens) > now);
            if (later) text = `Closed now · opens at ${fmt(later.opens)}`;
            else for (let k = 1; k < 8; k++) {
              const d = (day + k) % 7, first = spans(d)[0];
              if (!first) continue;
              const when = k === 1 ? 'tomorrow' : DAYS[d];
              text = holiday(k) ? `Closed now · ${holiday(k)} ${when}, call ahead` : `Closed now · opens ${when} ${fmt(first.opens)}`;
              break;
            }
          }
          if (text) {
            const heroActions = document.querySelector('#top .actions');
            if (heroActions) { const p = document.createElement('p'); p.className = 'open-now hero-open'; p.setAttribute('data-open-now', ''); heroActions.after(p); }
            document.querySelectorAll('[data-open-now]').forEach((el) => { el.textContent = text; el.dataset.state = state; el.hidden = false; });
          }
        }

        // Pause or play the page's animations; every toggle shares one setting.
        const motionSync = () => {
          const paused = root.classList.contains('motion-paused');
          document.querySelectorAll('[data-motion-toggle]').forEach((b) => {
            b.setAttribute('aria-pressed', String(paused));
            if (b.classList.contains('motion-link')) b.textContent = paused ? 'Play animations' : 'Pause animations';
            else { b.setAttribute('aria-label', paused ? 'Play animations' : 'Pause animations'); b.title = b.getAttribute('aria-label'); }
          });
        };
        motionSync();
        document.querySelectorAll('[data-motion-toggle]').forEach((b) => b.addEventListener('click', () => {
          const paused = root.classList.toggle('motion-paused');
          try { localStorage.setItem('motion', paused ? 'paused' : 'on'); } catch {}
          motionSync();
        }));

        // Google's interactive map loads only when asked for: the drawn map is
        // already there, and nothing is fetched from Google before the tap.
        document.querySelectorAll('[data-map-src]').forEach((b) => b.addEventListener('click', () => {
          const box = b.closest('[data-map]');
          const f = document.createElement('iframe');
          f.src = b.dataset.mapSrc; f.title = b.dataset.mapTitle || 'Map'; f.referrerPolicy = 'no-referrer-when-downgrade';
          box.append(f); box.classList.add('live'); b.remove(); f.focus();
        }));

        // Directions open Apple Maps on iPhones and iPads.
        if (/iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
          document.querySelectorAll('[data-directions]').forEach((a) => { if (a.dataset.directions) a.href = `https://maps.apple.com/?daddr=${encodeURIComponent(a.dataset.directions)}`; });
        }

        // Share: the phone's share sheet, or copy the link on a computer.
        const toast = document.querySelector('[data-toast]');
        let toastT = 0;
        const say = (msg, link) => {
          if (!toast) return;
          toast.querySelector('[data-toast-text]').textContent = msg;
          // The action link exists only while the notice offers one (no empty link in the page).
          toast.querySelector('[data-toast-link]')?.remove();
          if (link) { const a = document.createElement('a'); a.setAttribute('data-toast-link', ''); a.href = link.href; a.textContent = link.label; toast.append(a); }
          toast.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => toast.classList.remove('show'), link ? 5200 : 2600);
        };
        const copy = async (text) => { try { await navigator.clipboard.writeText(text); return true; } catch { return false; } };

        // On a computer a phone link copies the number (most desktops cannot dial it),
        // with a link to call from the computer anyway, e.g. through a paired phone.
        const desk = matchMedia('(hover: hover) and (pointer: fine)').matches && !navigator.maxTouchPoints;
        if (desk) document.querySelectorAll('a[href^="tel:"]').forEach((a) => a.addEventListener('click', async (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey) return;
          e.preventDefault();
          const num = a.getAttribute('href').replace(/^tel:\+?1?/, '').replace(/^(\d{3})(\d{3})(\d{4})$/, '($1) $2-$3');
          const ok = await copy(num);
          say(ok ? `Number copied: ${num}` : num, { href: a.getAttribute('href'), label: 'Call from this computer' });
        }));
        document.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
          say((await copy(b.dataset.copy)) ? b.dataset.copied || 'Copied' : b.dataset.copy);
        }));
        document.querySelectorAll('[data-share]').forEach((b) => b.addEventListener('click', async () => {
          const data = { title: document.title, url: location.href.split('#')[0] };
          if (navigator.share) { try { await navigator.share(data); } catch {} return; }
          try { await navigator.clipboard.writeText(data.url); say('Link copied'); } catch { say(data.url); }
        }));

        // Reading progress in the header, a way back to the top, and the
        // menu link for the section on screen.
        const toTop = document.querySelector('[data-to-top]');
        let pq = false, lastY = scrollY, up = false;
        const progress = () => {
          pq = false;
          const max = root.scrollHeight - innerHeight;
          head?.style.setProperty('--progress', max > 0 ? Math.min(1, scrollY / max).toFixed(4) : '0');
          // Offered once the reader is well down the page and heads back up (or reaches the end).
          const dy = scrollY - lastY; lastY = scrollY;
          if (dy < -4) up = true; else if (dy > 4) up = false;
          const show = scrollY > innerHeight * 1.4 && (up || scrollY >= max - 4);
          if (toTop && toTop.classList.contains('show') !== show) { toTop.classList.toggle('show', show); toTop.tabIndex = show ? 0 : -1; }
        };
        addEventListener('scroll', () => { if (!pq) { pq = true; requestAnimationFrame(progress); } }, { passive: true });
        progress();
        const spyLinks = [...document.querySelectorAll('.nav > a[href^="#"]')];
        if ('IntersectionObserver' in window && spyLinks.length) {
          const spy = new IntersectionObserver((entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            spyLinks.forEach((a) => (a.getAttribute('href') === `#${e.target.id}` ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
          }), { rootMargin: '-45% 0px -50% 0px' });
          [document.getElementById('top'), ...spyLinks.map((a) => document.querySelector(a.getAttribute('href')))].forEach((t) => t && spy.observe(t));
        }

        // Menu chips: the group on screen is marked, and the bar scrolls to keep it in view.
        document.querySelectorAll('[data-menu-jump]').forEach((bar) => {
          const links = [...bar.querySelectorAll('a')];
          const groups = links.map((a) => document.querySelector(a.getAttribute('href'))).filter(Boolean);
          if (!('IntersectionObserver' in window) || !groups.length) return;
          const mark = (id) => links.forEach((a) => {
            const on = a.getAttribute('href') === `#${id}`;
            if (on) { a.setAttribute('aria-current', 'true'); bar.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' }); } else a.removeAttribute('aria-current');
          });
          const gio = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) mark(e.target.id); }), { rootMargin: '-35% 0px -55% 0px' });
          groups.forEach((g) => gio.observe(g));
        });

        // Print just the menu (or price list), headed with the business's name, phone and address.
        document.querySelectorAll('[data-print-menu]').forEach((b) => b.addEventListener('click', () => {
          const sec = b.closest('section');
          sec.classList.add('print-this'); root.classList.add('print-menu');
          const done = () => { sec.classList.remove('print-this'); root.classList.remove('print-menu'); removeEventListener('afterprint', done); };
          addEventListener('afterprint', done);
          print();
        }));

        // Photos open full screen: arrows, swipe and the keyboard move between them.
        const lb = document.querySelector('[data-lightbox]');
        if (lb) {
          const pics = [...document.querySelectorAll('.gallery img, .cine-mosaic img, .scene img, .story-media img')].filter((img) => !img.closest('[aria-hidden="true"]'));
          // The big image is made when the viewer first opens, so the page never holds an <img> without a source.
          let big = null;
          const cap = lb.querySelector('[data-lb-cap]'), count = lb.querySelector('[data-lb-count]');
          let at = 0, x0 = null, swiped = false;
          const show = (i) => {
            at = (i + pics.length) % pics.length;
            const src = pics[at];
            if (!big) { big = document.createElement('img'); big.draggable = false; big.decoding = 'async'; lb.querySelector('figure').prepend(big); }
            // The original file (the largest), so its real size is known and small photos are not over-enlarged.
            big.src = src.getAttribute('src');
            big.alt = src.alt; cap.textContent = src.alt; count.textContent = pics.length > 1 ? `${at + 1} / ${pics.length}` : '';
            // Keeps the last size until the next photo has loaded, so it never flashes at its raw size.
            if (big.complete) fit(); else big.onload = fit;
          };
          // Fill the screen, but never blow a small photo up more than 1.6 times.
          const fit = () => {
            const box = big.parentElement.getBoundingClientRect(), capH = big.nextElementSibling.getBoundingClientRect().height + 14;
            const nw = big.naturalWidth, nh = big.naturalHeight;
            if (!nw || !nh) return;
            const k = Math.min(box.width / nw, (box.height - capH) / nh, 1.6);
            big.style.width = `${Math.round(nw * k)}px`; big.style.height = `${Math.round(nh * k)}px`;
          };
          addEventListener('resize', () => { if (lb.open) fit(); });
          pics.forEach((img, i) => {
            img.tabIndex = 0; img.setAttribute('role', 'button'); img.setAttribute('aria-label', `View larger: ${img.alt}`); img.classList.add('zoomable');
            const open = () => { lb.showModal(); show(i); };
            img.addEventListener('click', open);
            img.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
          });
          if (pics.length < 2) lb.classList.add('single');
          lb.querySelector('[data-lb-close]').addEventListener('click', () => lb.close());
          lb.querySelector('[data-lb-prev]').addEventListener('click', () => show(at - 1));
          lb.querySelector('[data-lb-next]').addEventListener('click', () => show(at + 1));
          lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); else if (e.key === 'ArrowRight') show(at + 1); });
          lb.addEventListener('pointerdown', (e) => { x0 = e.clientX; swiped = false; });
          lb.addEventListener('pointerup', (e) => { if (x0 !== null && Math.abs(e.clientX - x0) > 50 && pics.length > 1) { swiped = true; show(at + (e.clientX < x0 ? 1 : -1)); } x0 = null; });
          lb.addEventListener('click', (e) => { if (!swiped && (e.target === lb || e.target.tagName === 'FIGURE')) lb.close(); swiped = false; });
        }

        const dlg = document.querySelector('[data-notes]');
        document.querySelector('[data-open-notes]')?.addEventListener('click', () => dlg.showModal());
        document.querySelector('[data-close-notes]')?.addEventListener('click', () => dlg.close());
        document.querySelectorAll('[data-nc]').forEach((r) => r.addEventListener('input', () => r.parentElement.style.setProperty('--pos', `${r.value}%`)));
        dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

        // Preview form: checks it has enough to reply to, then says where a real message would go.
        document.querySelector('[data-form]')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const f = e.currentTarget, v = (n) => (f.elements[n]?.value || '').trim();
          const missing = f.querySelector('[data-form-missing]');
          const gap = !v('name') ? f.elements.name : !v('phone') && !v('email') ? f.elements.phone : null;
          missing.hidden = !gap;
          if (gap) { f.classList.remove('done'); gap.focus(); return; }
          const first = v('name').split(/\s+/)[0], topic = v('topic');
          f.querySelector('[data-form-sent]').textContent = `Thanks, ${first}! On the live site, your ${topic ? `"${topic}" ` : ''}message would go straight to ${f.dataset.to || f.dataset.biz}, with your ${v('phone') ? 'number' : 'email'} to reply to. (Preview only: nothing was sent.)`;
          f.classList.add('done');
        });

        // Package tracking: guess the carrier from the number's shape and point
        // each carrier link at its own tracking page.
        document.querySelectorAll('[data-track]').forEach((box) => {
          const input = box.querySelector('[data-track-input]'), guess = box.querySelector('[data-track-guess]');
          const names = { ups: 'UPS', fedex: 'FedEx', usps: 'USPS', dhl: 'DHL' };
          const url = {
            ups: (n) => (n ? `https://www.ups.com/track?tracknum=${n}` : 'https://www.ups.com/track'),
            fedex: (n) => (n ? `https://www.fedex.com/fedextrack/?trknbr=${n}` : 'https://www.fedex.com/en-us/tracking.html'),
            usps: (n) => (n ? `https://tools.usps.com/go/TrackConfirmAction?tLabels=${n}` : 'https://tools.usps.com/go/TrackConfirmAction_input'),
            dhl: (n) => (n ? `https://www.dhl.com/us-en/home/tracking/tracking-express.html?submit=1&tracking-id=${n}` : 'https://www.dhl.com/us-en/home/tracking.html'),
          };
          const carrierOf = (n) => /^1Z[0-9A-Z]{16}$/.test(n) ? 'ups'
            : /^(9[1-5]\d{18,24}|[A-Z]{2}\d{9}US)$/.test(n) ? 'usps'
            : /^(\d{12}|\d{15}|\d{20}|\d{22})$/.test(n) ? 'fedex'
            : /^(\d{10}|JJD\d{10,}|JVGL\d+)$/.test(n) ? 'dhl' : '';
          const update = () => {
            const n = input.value.toUpperCase().replace(/[^0-9A-Z]/g, ''), c = n ? carrierOf(n) : '';
            box.querySelectorAll('[data-carrier]').forEach((a) => { a.href = url[a.dataset.carrier](encodeURIComponent(n)); a.classList.toggle('likely', a.dataset.carrier === c); });
            guess.textContent = !n ? 'Paste a number and we’ll point you to the right carrier.' : c ? `That looks like a ${names[c]} number.` : 'We can’t tell the carrier from that number: try each one below.';
          };
          input.addEventListener('input', update); update();
        });

        // Highlight today's row in the hours table.
        const names = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
        const today = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(new Date()));
        document.querySelectorAll('.hours tr[data-days]').forEach((tr) => {
          const d = tr.dataset.days.toLowerCase();
          const hit = d.match(/(sun|mon|tue|wed|thu|fri|sat)\w*\s*(?:[-–—]|to|through)\s*(sun|mon|tue|wed|thu|fri|sat)/);
          let on = false;
          if (/daily|every day|7 days/.test(d)) on = true;
          else if (hit) { const a = names.indexOf(hit[1]), b = names.indexOf(hit[2]); on = a <= b ? today >= a && today <= b : today >= a || today <= b; }
          else on = d.split(/[,&/]|\band\b/).some((p) => names[today] && p.trim().startsWith(names[today]));
          if (on) tr.classList.add('today');
        });

        // Motion: sections rise in as they scroll into view, and cards get a
        // spotlight that follows the pointer. Skipped for reduced motion and
        // for automated browsers (screenshots and page tests see the final state).
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && !navigator.webdriver) {
          document.documentElement.classList.add('motion');
          const io = new IntersectionObserver((entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }), { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('main > .section .section-head, .cine-gallery .section-head, .cards > li, .gallery figure, .steps li, .quotes figure, .faq details, .menu-group, .story .wrap > *, .band .wrap > *, .visit .wrap > *').forEach((el) => {
            const i = Array.prototype.indexOf.call(el.parentElement.children, el);
            el.style.setProperty('--d', `${(i % 6) * 70}ms`);
            el.classList.add('reveal');
            io.observe(el);
          });

          // The hero photo tilts a little toward the pointer.
          const visual = document.querySelector('.hero-visual');
          const frameEl = visual?.querySelector('.frame');
          if (frameEl && matchMedia('(hover: hover)').matches) {
            visual.addEventListener('pointermove', (e) => {
              const r = visual.getBoundingClientRect();
              frameEl.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 8}deg`);
              frameEl.style.setProperty('--rx', `${(0.5 - (e.clientY - r.top) / r.height) * 8}deg`);
            });
            visual.addEventListener('pointerleave', () => { frameEl.style.setProperty('--rx', '0deg'); frameEl.style.setProperty('--ry', '0deg'); });
          }

          // Facts that start with a number count up when they come into view.
          const counters = [...document.querySelectorAll('.facts strong')].filter((el) => /^\d{1,3}(?!\d)/.test(el.textContent.trim()));
          if (counters.length) {
            const cio = new IntersectionObserver((entries) => entries.forEach((e) => {
              if (!e.isIntersecting) return;
              cio.unobserve(e.target);
              const el = e.target, full = el.textContent, m = full.match(/^(\d{1,3})/), end = Number(m[1]), rest = full.slice(m[1].length), t0 = performance.now();
              const step = (t) => { const k = Math.min(1, (t - t0) / 1400); el.textContent = `${Math.round(end * (1 - Math.pow(1 - k, 3)))}${rest}`; if (k < 1) requestAnimationFrame(step); else el.textContent = full; };
              requestAnimationFrame(step);
            }), { threshold: 0.6 });
            counters.forEach((el) => cio.observe(el));
          }

          // Cinematic scroll engine: one rAF per scroll, only for what is near
          // the screen. --p is 0..1 progress; scenes get --e (entering) and
          // --c (covered by the next scene).
          const hero = document.querySelector('[data-cine-hero]');
          const tracks = [...document.querySelectorAll('[data-cine-track]')].map((t) => ({ t, scenes: [...t.querySelectorAll('.scene')] }));
          const pars = [...document.querySelectorAll('[data-par]')];
          if (hero || tracks.length || pars.length) {
            const clamp = (x) => (x < 0 ? 0 : x > 1 ? 1 : x);
            let queued = false;
            // Pinned panels sit below the sticky header (--head), so each is h - head tall.
            const head = parseFloat(getComputedStyle(document.body).getPropertyValue('--head')) || 0;
            const frame = () => {
              queued = false;
              const h = innerHeight, H = Math.max(1, h - head);
              if (hero) {
                const r = hero.getBoundingClientRect();
                if (r.bottom > 0) hero.style.setProperty('--p', clamp((head - r.top) / Math.max(1, r.height - H)).toFixed(4));
              }
              for (const { t, scenes } of tracks) {
                const r = t.getBoundingClientRect();
                if (r.top > h * 1.5 || r.bottom < -h * 0.5) continue;
                const s = (h - r.top) / H; // scene i is fully in when s reaches i + 1
                scenes.forEach((el, i) => {
                  el.style.setProperty('--e', clamp(s - i).toFixed(4));
                  el.style.setProperty('--c', clamp(s - i - 1).toFixed(4));
                });
              }
              for (const el of pars) {
                const r = el.getBoundingClientRect();
                if (r.bottom < -200 || r.top > h + 200) continue;
                el.style.setProperty('--p', clamp((h - r.top) / (h + r.height)).toFixed(4));
              }
            };
            addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(frame); } }, { passive: true });
            addEventListener('resize', frame);
            frame();
          }
        }
        const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
        const moving = document.documentElement.classList.contains('motion');
        document.querySelectorAll('.card').forEach((card) => card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const x = e.clientX - r.left, y = e.clientY - r.top;
          card.style.setProperty('--mx', `${x}px`);
          card.style.setProperty('--my', `${y}px`);
          // A gentle 3D tilt toward the pointer, with a glare that follows it.
          if (moving && fine) { card.style.setProperty('--ry', `${(x / r.width - 0.5) * 9}deg`); card.style.setProperty('--rx', `${(0.5 - y / r.height) * 9}deg`); }
        }));
        document.querySelectorAll('.card').forEach((card) => card.addEventListener('pointerleave', () => { card.style.setProperty('--rx', '0deg'); card.style.setProperty('--ry', '0deg'); }));

        // Backdrop: decorative layers behind the hero (not over a hero photo) and the call-to-action band.
        const bdKind = document.body.dataset.backdrop;
        const bdCount = { bokeh: 9, beams: 4, ripple: 3, contour: 1 }[bdKind] || 0;
        if (bdCount) document.querySelectorAll('.hero:not([data-variant="photo"]), .band').forEach((host) => {
          const bd = document.createElement('div');
          bd.className = `bd bd-${bdKind}`;
          bd.setAttribute('aria-hidden', 'true');
          for (let i = 0; i < bdCount; i++) bd.append(document.createElement('i'));
          host.prepend(bd);
        });
        // A soft spotlight follows the pointer across menu groups, steps and quotes (cards have their own glare).
        if (fine && moving) document.querySelectorAll('.menu-group, .steps > li, .quotes figure').forEach((el) => {
          const glow = document.createElement('span');
          glow.className = 'spot';
          glow.setAttribute('aria-hidden', 'true');
          el.classList.add('has-spot');
          el.prepend(glow);
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });

        if (moving) {
          // Headline: each word settles in from a soft blur, one after another.
          document.querySelectorAll('.hero h1, .cine-hero h1').forEach((h) => {
            let i = 0;
            const walk = (node) => [...node.childNodes].forEach((n) => {
              if (n.nodeType === 3) {
                const frag = document.createDocumentFragment();
                n.textContent.split(/(\s+)/).forEach((part) => {
                  if (!part) return;
                  if (/^\s+$/.test(part)) { frag.append(part); return; }
                  const w = document.createElement('span'); w.className = 'fx-w'; w.style.setProperty('--i', i++); w.textContent = part; frag.append(w);
                });
                n.replaceWith(frag);
              } else if (n.nodeType === 1) walk(n);
            });
            walk(h);
            h.classList.add('fx-split');
          });

          // Hero depth: badges, rings and sparkles drift at their own speed as
          // the page scrolls, lean toward the pointer, and a glow follows it.
          document.querySelectorAll('[data-fx]').forEach((fx) => {
            const host = fx.parentElement;
            let q = false, px = 0, py = 0, gx = 0, gy = 0;
            const paint = () => {
              q = false;
              const r = host.getBoundingClientRect();
              if (r.bottom < 0 || r.top > innerHeight) return;
              host.style.setProperty('--sy', String(Math.round(-r.top)));
              host.style.setProperty('--px', px.toFixed(3));
              host.style.setProperty('--py', py.toFixed(3));
              host.style.setProperty('--gx', `${gx}px`);
              host.style.setProperty('--gy', `${gy}px`);
            };
            const ask = () => { if (!q) { q = true; requestAnimationFrame(paint); } };
            addEventListener('scroll', ask, { passive: true });
            if (fine) host.addEventListener('pointermove', (e) => {
              const r = host.getBoundingClientRect();
              gx = Math.round(e.clientX - r.left); gy = Math.round(e.clientY - r.top);
              px = gx / r.width - 0.5; py = gy / r.height - 0.5; ask();
            });
            host.classList.add('fx-live');
            paint();
          });

          // Buttons lean toward the pointer a little (magnetic).
          if (fine) document.querySelectorAll('.hero .btn, .cine-hero .btn, .band .btn').forEach((b) => {
            b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.setProperty('--bx', `${((e.clientX - r.left) / r.width - 0.5) * 10}px`); b.style.setProperty('--by', `${((e.clientY - r.top) / r.height - 0.5) * 8}px`); });
            b.addEventListener('pointerleave', () => { b.style.setProperty('--bx', '0px'); b.style.setProperty('--by', '0px'); });
          });

          // Decorative loops start on the first interaction (see vivid.css).
          // Chrome sends synthetic pointer moves after layout changes (to update
          // hover), so a move only counts when the pointer really moved.
          const kinds = ['pointermove', 'pointerdown', 'wheel', 'keydown', 'touchstart'];
          const wake = (e) => {
            if (e.type === 'pointermove' && !(e.isTrusted && (e.movementX || e.movementY))) return;
            document.documentElement.classList.add('awake');
            kinds.forEach((t) => removeEventListener(t, wake));
          };
          kinds.forEach((t) => addEventListener(t, wake, { passive: true }));

          // The header settles into a tinted glass bar once the page scrolls.
          const sh = document.querySelector('[data-head]');
          const tick = () => sh?.classList.toggle('scrolled', scrollY > 24);
          addEventListener('scroll', tick, { passive: true }); tick();
        }
      })();
    </script>
    <script is:inline>
      // Guided tour: a few stops that point out what the concept does for
      // customers. Started from the preview bar, or with ?tour in the address.
      (() => {
        const root = document.querySelector('[data-tour]');
        const start = document.querySelector('[data-tour-start]');
        if (!root || !start) return;
        const ring = root.querySelector('[data-tour-ring]'), pop = root.querySelector('[data-tour-pop]');
        const $ = (sel) => root.querySelector(sel);
        const shown = (el) => !!el && el.getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden';
        const first = (...sels) => { for (const sel of sels) for (const el of document.querySelectorAll(sel)) if (shown(el)) return el; return null; };
        const food = root.hasAttribute('data-food');
        const studio = root.dataset.studio, studioPhone = root.dataset.studioPhone;
        const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('motion-paused');

        const stops = () => [
          { el: first('.callbar a'), title: 'One tap to call', text: 'On a phone this button stays on screen while people scroll, so calling you is always one tap away. Directions sit right beside it.' },
          { el: first('.head-cta'), title: 'Your number, always in view', text: 'On a computer the number stays in the header. Clicking it offers to call from the computer, or copies the number to dial on a phone.' },
          { el: first('.menu-sec .menu-jump', '.menu-sec'), title: food ? 'The whole menu, with prices' : `${(document.querySelector(`.nav a[href="#${document.querySelector('.menu-sec')?.id}"]`)?.textContent || 'Your prices').trim()}, easy to find`, text: `Customers jump straight to the part they want${document.querySelector('[data-print-menu]') ? ', and can print it' : ''}, with no PDF to download.` },
          { el: first('.gallery', '.cine-mosaic', '.cine-gallery'), title: 'Photos that open full screen', text: 'Tap any photo to see it large, then swipe through the rest.' },
          { el: first('[data-track]'), title: 'Track a package', text: 'Paste any tracking number: the page works out whether it’s UPS, FedEx, USPS or DHL, and opens that carrier’s tracking.' },
          (() => {
            const row = first('.hours')?.closest('.row') || null, sign = row && shown(row.querySelector('[data-open-now]'));
            return sign
              ? { el: row, title: 'Hours, with an “Open now” sign', text: 'The sign checks your hours against the time in Aiken and updates itself through the day, so nobody drives over to a locked door.' }
              : { el: row, title: 'Hours where people look', text: 'Your hours sit right beside your number and address, so nobody has to hunt for them.' };
          })(),
          { el: first('[data-map]', '.map'), title: 'A map drawn in your colors', text: 'Directions are one tap away. The full Google map loads only when someone asks for it, which keeps the page fast.' },
          { el: first('.row.keep'), title: 'Saved to their phone', text: 'One tap adds you to a customer’s contacts, with your number and address, or shares your page with a friend.' },
          { el: first('[data-form]'), title: 'Questions and quote requests', text: 'A short form that sends messages straight to you, with a phone number or email to reply to. (In this preview it doesn’t send anything.)' },
          { el: first('[data-open-notes]'), top: true, title: 'That’s the tour', text: `It’s built to load fast on phones and to pass automated accessibility checks. “What changed?” compares it with the current site.${studioPhone ? ` Questions? Call ${studio}: ${studioPhone}.` : ''}` },
        ].filter((s) => s.el);

        let list = [], at = 0, frame = 0, opener = null;
        const place = () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const el = list[at]?.el; if (!el) return;
            const r = el.getBoundingClientRect(), vw = innerWidth, vh = innerHeight, pad = 8;
            const top = Math.max(4, r.top - pad), bottom = Math.min(vh - 4, r.bottom + pad);
            Object.assign(ring.style, { top: `${top}px`, left: `${Math.max(4, r.left - pad)}px`, width: `${Math.min(vw - 8, r.width + pad * 2)}px`, height: `${Math.max(0, bottom - top)}px` });
            const pw = Math.min(380, vw - 24); pop.style.width = `${pw}px`;
            const ph = pop.offsetHeight, gap = 14;
            const bar = first('.callbar'); const low = bar ? vh - bar.getBoundingClientRect().top + 12 : 12;
            let y;
            if (vw <= 700) y = r.top + r.height / 2 > vh / 2 ? 12 : vh - low - ph;
            else if (r.bottom + gap + ph <= vh - 12) y = r.bottom + gap;
            else if (r.top - gap - ph >= 12) y = r.top - gap - ph;
            else y = vh - ph - 16;
            const x = vw <= 700 ? (vw - pw) / 2 : Math.min(Math.max(12, r.left), vw - pw - 12);
            pop.style.transform = `translate(${Math.round(x)}px, ${Math.round(Math.max(12, y))}px)`;
          });
        };
        const show = (i) => {
          at = Math.max(0, Math.min(list.length - 1, i));
          const s = list[at];
          $('[data-tour-count]').textContent = `Step ${at + 1} of ${list.length}`;
          $('[data-tour-title]').textContent = s.title;
          $('[data-tour-text]').textContent = s.text;
          $('[data-tour-back]').hidden = at === 0;
          $('[data-tour-next]').textContent = at === list.length - 1 ? 'Finish' : 'Next';
          const r = s.el.getBoundingClientRect(), tall = r.height > innerHeight * 0.6;
          const fixed = getComputedStyle(s.el).position === 'fixed' || !!s.el.closest('.callbar');
          // Short hops glide; long jumps move at once, so the card never points at a moving target.
          const far = Math.abs(r.top + r.height / 2 - innerHeight / 2) > innerHeight * 1.5;
          if (s.top) scrollTo({ top: 0, behavior: still() || far ? 'instant' : 'smooth' });
          else if (!fixed) s.el.scrollIntoView({ block: tall ? 'start' : 'center', behavior: still() || far ? 'instant' : 'smooth' });
          place();
          setTimeout(place, 350); setTimeout(place, 800);
          $('[data-tour-title]').focus({ preventScroll: true });
        };
        const close = () => {
          root.hidden = true; document.documentElement.classList.remove('touring');
          removeEventListener('scroll', place); removeEventListener('scrollend', place); removeEventListener('resize', place); removeEventListener('keydown', key);
          if (new URLSearchParams(location.search).has('tour')) history.replaceState(null, '', location.pathname + location.hash);
          (opener || start).focus({ preventScroll: true });
        };
        const key = (e) => {
          if (e.key === 'Escape') { e.preventDefault(); close(); }
          else if (e.key === 'ArrowRight' && pop.contains(document.activeElement)) { e.preventDefault(); at < list.length - 1 ? show(at + 1) : close(); }
          else if (e.key === 'ArrowLeft' && pop.contains(document.activeElement)) { e.preventDefault(); show(at - 1); }
        };
        const open = (from) => {
          list = stops(); if (!list.length) return;
          opener = from || null;
          document.querySelector('dialog[open]')?.close();
          root.hidden = false; document.documentElement.classList.add('touring');
          addEventListener('scroll', place, { passive: true }); addEventListener('scrollend', place); addEventListener('resize', place); addEventListener('keydown', key);
          show(0);
        };
        start.addEventListener('click', () => open(start));
        $('[data-tour-next]').addEventListener('click', () => (at < list.length - 1 ? show(at + 1) : close()));
        $('[data-tour-back]').addEventListener('click', () => show(at - 1));
        $('[data-tour-close]').addEventListener('click', close);
        if (new URLSearchParams(location.search).has('tour')) addEventListener('load', () => setTimeout(() => open(null), 400));
      })();
    </script>
  </body>
