---
// Portfolio index: every redesign concept in one place.
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import Icon from '../components/Icon.astro';
import { demos, fonts } from '../lib/demos';
import { site } from '../lib/site';
import { ensure } from '../lib/contrast';

const pub = path.join(process.cwd(), 'public');
const shot = (name: string) => (existsSync(path.join(pub, 'shots', `${name}.jpg`)) ? `/shots/${name}.jpg` : '');
// What kind of pitch each concept is, from the research data.
let tiers: Record<string, string> = {};
try {
  const rows = JSON.parse(readFileSync(path.join(process.cwd(), 'data', 'prospects.json'), 'utf8'));
  tiers = Object.fromEntries(rows.map((r: { slug: string; tier: string }) => [r.slug, r.tier]));
} catch {}
const kindOf = (d: (typeof demos)[number]) => (d.source.none ? 'First website' : tiers[d.prospect || d.slug] === 'broken' ? 'Replaces a broken site' : 'Redesign');

const cards = demos.map((d) => ({
  ...d,
  kind: kindOf(d),
  after: shot(`${d.slug}-after`),
  before: shot(`${d.prospect || d.slug}-before`),
  host: new URL(d.source.url).hostname.replace(/^www\./, ''),
}));
const groups = [...new Set(cards.map((c) => c.group))].sort();
const towns = new Set(cards.map((c) => c.town));

// A colour per filter group, held to 4.5:1 for its label (white on the solid
// chip, the dark shade on the tinted one).
const HUES = ['#e0572f', '#7c4dcc', '#c98a12', '#1f6fb5', '#d6407a', '#0e8a7c', '#b8432b', '#3f8a2e', '#a0522d', '#2e8b57', '#4a5bd4', '#0f7fa8', '#b04aa8'];
const groupColor = Object.fromEntries(groups.map((g, k) => {
  const c = HUES[k % HUES.length];
  return [g, { solid: ensure(c, '#ffffff', '#000000'), text: ensure(c, '#ece3d8', '#000000'), raw: c }];
}));

// The showcase wall in the banner: a spread of styles, in three drifting columns.
const WALL = ['apizza-di-napoli', 'flanigans-ice-cream', 'antonios-italian-eatery', 'bloom-salon', 'augusta-ready-mix', 'big-house-outpost', 'farm-dog', 'glassworks', 'veg-out', 'durban-laird-insurance', 'empire-tree', 'carolina-hvac', 'toki-jr', 'smoothie-groove', 'aiken-pet-sitters'];
const thumb = (slug: string) => (existsSync(path.join(pub, 'shots', 'thumbs', `${slug}.webp`)) ? `/shots/thumbs/${slug}.webp` : '');
const wall = WALL.map((slug) => cards.find((c) => c.slug === slug)).filter((c) => c && thumb(c.slug));
const cols = [0, 1, 2].map((k) => wall.filter((_, i) => i % 3 === k));
// The ribbon: what kinds of businesses and where.
const kinds = [...new Set(cards.map((c) => c.category.split(/[,&·(]/)[0].trim()))].slice(0, 16);

// Headline numbers come straight from the research data.
let researched = 0, needWork = 0;
try {
  const rows = JSON.parse(readFileSync(path.join(process.cwd(), 'data', 'prospects.json'), 'utf8'));
  researched = rows.length;
  needWork = rows.filter((r: { tier: string }) => ['rebuild', 'broken', 'dated'].includes(r.tier)).length;
} catch {}

const display = fonts['bricolage-grotesque'];
const body = fonts.inter;
const fontCss = [display, body].map((f) => `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}`).join('');
const features = [
  { icon: 'smartphone', title: 'Phone-first', text: 'Most local searches happen on a phone. Every page is designed for a thumb before a mouse.' },
  { icon: 'zap', title: 'Fast', text: 'Static pages, optimised photos and self-hosted fonts. No page builders, no plugin bloat.' },
  { icon: 'lock', title: 'Secure by default', text: 'HTTPS everywhere and nothing to patch, so no "Not secure" warnings.' },
  { icon: 'phone-call', title: 'Built to get the call', text: 'Tap-to-call, directions and hours where people actually look for them.' },
  { icon: 'search', title: 'Easy to find', text: 'Clean headings, real text instead of images of text, and descriptions written for search.' },
  { icon: 'accessibility', title: 'Readable by everyone', text: 'Strong contrast, keyboard access and alt text on every photo.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <title>{`${site.name} — website concepts for Aiken-area businesses`}</title>
    <meta name="description" content={site.tagline} />
    <meta name="theme-color" content="#0b2a20" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name}: website concepts for Aiken-area businesses`} />
    <meta property="og:description" content={site.tagline} />
    {site.url && <meta property="og:url" content={`${site.url}/`} />}
    {site.url && <meta property="og:image" content={`${site.url}/og.jpg`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#143d2f"/><path d="M9 22 16 9l7 13" fill="none" stroke="#f3e9c9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>')}`} />
    <link rel="preload" href={display.normal} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={body.normal} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <header class="top" data-top>
      <div class="wrap">
        <a class="brand" href="/"><span class="glyph"><svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true"><path d="M7 24 16 7l9 17" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg><i class="glint" aria-hidden="true"></i></span><span class="word">{site.name}</span></a>
        <nav aria-label="Main">
          <a href="#concepts">Concepts</a>
          <a href="#included">What's included</a>
          <a href="#how">How it works</a>
        </nav>
        <a class="top-cta" href="#how">Get yours</a>
      </div>
    </header>

    <main>
      <section class="hero" data-hero>
        <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="sparks" aria-hidden="true">{[0, 1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.2 3.3 8 8.5 8.6-5.2.6-7.9 3.3-8.5 8.5-.6-5.2-3.3-7.9-8.5-8.5 5.2-.6 7.9-3.4 8.5-8.6z" /></svg>)}</div>
        <div class="wrap hero-in">
          <div class="hero-copy">
            <p class="kicker"><span class="live"></span>{cards.length} live concepts · Aiken · North Augusta · Jackson · Beech Island</p>
            <h1>Your business is better than <em>its website.</em></h1>
            <p class="lede">{site.tagline} We built {cards.length} working concepts for local businesses so owners can see the difference before spending a dollar. Find yours below.</p>
            <div class="hero-actions">
              <a class="btn shine" href="#concepts">Browse the concepts<Icon name="arrow-down" size={18} stroke={2.4} /></a>
              <a class="btn glass" href="#how">How it works</a>
            </div>
            <dl class="stats">
              <div><dt data-count>{cards.length}</dt><dd>working concepts</dd></div>
              <div><dt data-count>{towns.size}</dt><dd>towns so far</dd></div>
              {researched > 0 && <div><dt data-count>{researched}</dt><dd>local businesses reviewed</dd></div>}
              {needWork > 0 && <div><dt data-count>{needWork}</dt><dd>with sites that are down, broken or dated</dd></div>}
            </dl>
          </div>
          <div class="wall" aria-hidden="true">
            <div class="wall-tilt">
              {cols.map((col, k) => (
                <div class={`wcol c${k}`}>
                  <div class="wtrack">
                    {[...col, ...col].map((c, i) => <figure style={`--tone:${c!.colors.primary}`}><img src={thumb(c!.slug)} alt="" width="440" height="296" loading={i < col.length ? 'eager' : 'lazy'} decoding="async" fetchpriority="low" /><figcaption>{c!.short || c!.name}</figcaption></figure>)}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50 C 240 100 480 0 720 40 S 1200 100 1440 30 V90 H0 Z" /></svg>
      </section>

      <div class="ribbon" aria-hidden="true">
        <div class="band b2"><div class="track">{[...towns, ...towns, ...towns, ...towns, ...towns, ...towns].map((t) => <span>{t}<i>✦</i></span>)}</div></div>
        <div class="band b1"><div class="track">{[...kinds, ...kinds].map((k) => <span>{k}<i>✦</i></span>)}</div></div>
      </div>

      <section class="concepts" id="concepts">
        <div class="wrap">
          <div class="bar">
            <h2>The <em>concepts</em></h2>
            <div class="chips" role="group" aria-label="Filter by type">
              <button type="button" class="chip on" data-filter="all">All <span>{cards.length}</span></button>
              {groups.map((g) => <button type="button" class="chip" data-filter={g} style={`--c:${groupColor[g].raw};--cs:${groupColor[g].solid};--ct:${groupColor[g].text}`}>{g} <span>{cards.filter((c) => c.group === g).length}</span></button>)}
            </div>
            <input class="search" type="search" data-search placeholder="Search name, type or town" aria-label="Search concepts" />
            <label class="switch"><input type="checkbox" data-before /><span></span>Show the current sites</label>
          </div>

          <ul class="grid" data-grid>
            {cards.map((c) => (
              <li class="card" style={`--tone:${c.colors.primary};--tone2:${c.colors.accent}`} data-group={c.group} data-text={`${c.name} ${c.category} ${c.town} ${c.group} ${c.kind}`.toLowerCase()}>
                <a href={`/${c.slug}/`} aria-label={`${c.name}: view the concept`}>
                  <div class="shot" style={`--tone:${c.colors.primary}`}>
                    {c.after ? <img class="after" src={c.after} alt={`Concept redesign for ${c.name}`} width="1120" height="753" loading="lazy" /> : <div class="blank">{c.short || c.name}</div>}
                    {c.before && <img class="before" src={c.before} alt={`${c.name}'s current website`} width="1120" height="753" loading="lazy" />}
                    <span class="tag after-tag">Concept</span>
                    {c.before && <span class="tag before-tag">Current site</span>}
                  </div>
                  <div class="meta">
                    <div>
                      <h3><span class="dots" aria-hidden="true"><i style={`background:${c.colors.primary}`}></i><i style={`background:${c.colors.accent}`}></i></span>{c.name}</h3>
                      <p>{c.category} · {c.town}</p>
                      {c.kind !== 'Redesign' && <span class="kind">{c.kind}</span>}
                    </div>
                    <span class="go"><Icon name="arrow-up-right" size={18} stroke={2.2} /></span>
                  </div>
                </a>
                <a class="report-link" href={`/${c.slug}/report/`}>See the website checkup<Icon name="arrow-right" size={14} stroke={2.2} /></a>
              </li>
            ))}
          </ul>
          <p class="empty" data-empty hidden>No concepts match that search.</p>
        </div>
      </section>

      <section class="included" id="included">
        <div class="wrap">
          <div class="aurora soft" aria-hidden="true"><i></i><i></i><i></i></div>
          <h2>What every concept <em>includes</em></h2>
          <ul class="features">
            {features.map((f, k) => <li style={`--c:${HUES[(k * 2 + 1) % HUES.length]}`}><span class="ico"><Icon name={f.icon} size={22} /><i class="glint" aria-hidden="true"></i></span><h3>{f.title}</h3><p>{f.text}</p></li>)}
          </ul>
        </div>
      </section>

      <section class="how" id="how">
        <div class="wrap">
          <h2>How it <em>works</em></h2>
          <ol>
            <li><h3>Look at your concept</h3><p>It is already built with your own words, hours and photos. Open it on your phone and tap around.</p></li>
            <li><h3>Tell us what to change</h3><p>New photos, a different colour, another page, an updated menu. We revise until it is right.</p></li>
            <li><h3>Go live on your own address</h3><p>We move it to your domain, so customers land on the new site at the address they already know.</p></li>
          </ol>
          <div class="cta">
            <h3>See your business here and want to talk?</h3>
            {site.contactEmail || site.contactPhone ? (
              <p>
                {site.contactEmail && <a class="btn" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
                {site.contactPhone && <a class="btn ghost" href={`tel:${site.contactPhone.replace(/[^\d+]/g, '')}`}>{site.contactPhone}</a>}
              </p>
            ) : (
              <p>Reply to the note that brought you here and we will take it from there.</p>
            )}
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <p class="foot-brand"><span class="glyph"><svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path d="M7 24 16 7l9 17" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg><i class="glint" aria-hidden="true"></i></span><strong>{site.name}</strong></p>
        <p>{site.tagline}</p>
        <p class="fine">These are unsolicited design concepts. Business names, logos, words and photographs belong to their respective owners and are shown only to illustrate a proposed redesign. No concept is the official website of the business it depicts.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const grid = document.querySelector('[data-grid]');
        const chips = [...document.querySelectorAll('[data-filter]')];
        const search = document.querySelector('[data-search]');
        const empty = document.querySelector('[data-empty]');
        let group = 'all';
        const apply = () => {
          const q = (search?.value || '').trim().toLowerCase();
          let shown = 0;
          grid.querySelectorAll('.card').forEach((card) => {
            const ok = (group === 'all' || card.dataset.group === group) && (!q || card.dataset.text.includes(q));
            card.hidden = !ok;
            if (ok) shown++;
          });
          if (empty) empty.hidden = shown > 0;
        };
        chips.forEach((chip) => chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.toggle('on', c === chip));
          group = chip.dataset.filter;
          apply();
        }));
        search?.addEventListener('input', apply);
        document.querySelector('[data-before]')?.addEventListener('change', (e) => grid.classList.toggle('show-before', e.target.checked));

        // The header turns to tinted glass once the page scrolls.
        const top = document.querySelector('[data-top]');
        const onScroll = () => top?.classList.toggle('scrolled', scrollY > 30);
        addEventListener('scroll', onScroll, { passive: true }); onScroll();

        // Cards after the first row rise in as they scroll into view.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && !navigator.webdriver) {
          document.documentElement.classList.add('motion');
          // The aurora and the showcase wall start moving on the first real
          // interaction (Chrome's synthetic pointer moves ignored), so the first
          // paint and a phone's processor go to the content.
          const kinds = ['pointermove', 'pointerdown', 'wheel', 'keydown', 'touchstart'];
          const wake = (e) => {
            if (e.type === 'pointermove' && !(e.isTrusted && (e.movementX || e.movementY))) return;
            document.documentElement.classList.add('awake');
            kinds.forEach((t) => removeEventListener(t, wake));
          };
          kinds.forEach((t) => addEventListener(t, wake, { passive: true }));
          // A soft light follows the pointer across the banner.
          const hero = document.querySelector('[data-hero]');
          if (hero && matchMedia('(hover: hover)').matches) hero.addEventListener('pointermove', (e) => {
            const r = hero.getBoundingClientRect();
            hero.style.setProperty('--gx', `${Math.round(e.clientX - r.left)}px`);
            hero.style.setProperty('--gy', `${Math.round(e.clientY - r.top)}px`);
          });
          // The numbers count up once.
          document.querySelectorAll('[data-count]').forEach((el) => {
            const end = Number(el.textContent), t0 = performance.now() + 250;
            if (!end) return;
            const step = (t) => { const k = Math.max(0, Math.min(1, (t - t0) / 1400)); el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
            el.textContent = '0'; requestAnimationFrame(step);
          });
          const io = new IntersectionObserver((entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }), { rootMargin: '0px 0px -6% 0px' });
          grid.querySelectorAll('.card').forEach((card, i) => {
            if (i < 3) return;
            card.style.setProperty('--d', `${(i % 3) * 80}ms`);
            card.classList.add('reveal');
            io.observe(card);
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f3ea; --surface: #ffffff; --ink: #14181a; --muted: #4f5a60; --line: #e5dfd1;
    --green: #143d2f; --green-2: #1f6a50; --cream: #f3e9c9;
    --night: #06201a; --em: #12b886; --teal: #14a3b8; --gold: #f2b33d; --coral: #ff6b4a; --violet: #7c5cff;
    --wrap: 1240px; --gutter: clamp(20px, 4.5vw, 44px);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { isolation: isolate; margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.6 "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-family: "Bricolage Grotesque", "Inter", system-ui, sans-serif; margin: 0; line-height: 1.05; letter-spacing: -.025em; text-wrap: balance; }
  p { margin: 0; text-wrap: pretty; }
  a { color: inherit; }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }
  .wrap { width: min(100% - var(--gutter) * 2, var(--wrap)); margin-inline: auto; }

  /* A slow wash of colour behind the light sections. */
  body::before { content: ""; position: fixed; inset: -20vmax; z-index: -1; pointer-events: none; background: radial-gradient(36vmax 36vmax at 10% 20%, rgb(18 184 134 / .13), transparent 70%), radial-gradient(34vmax 34vmax at 90% 30%, rgb(242 179 61 / .16), transparent 70%), radial-gradient(40vmax 40vmax at 60% 95%, rgb(255 107 74 / .1), transparent 70%), radial-gradient(30vmax 30vmax at 30% 70%, rgb(124 92 255 / .07), transparent 70%); }
  .awake body::before { animation: ix-ambient 34s ease-in-out infinite alternate; }
  @keyframes ix-ambient { 0% { transform: translate3d(0, 0, 0) rotate(0deg) scale(1); } 50% { transform: translate3d(4%, -3%, 0) rotate(8deg) scale(1.06); } 100% { transform: translate3d(-4%, 3%, 0) rotate(-6deg) scale(1.03); } }
  @supports (animation-timeline: scroll()) {
    body::after { content: ""; position: fixed; z-index: 60; inset: 0 0 auto 0; height: 3px; transform-origin: 0 50%; background: linear-gradient(90deg, var(--em), var(--gold), var(--coral)); animation: ix-progress linear both; animation-timeline: scroll(root); pointer-events: none; }
    @keyframes ix-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }

  /* ---------------------------------------------------------------- header */
  .top { position: sticky; top: 0; z-index: 30; color: #fff; background: rgb(6 32 26 / .94); backdrop-filter: blur(14px) saturate(1.5); overflow-x: clip; transition: background .3s ease, box-shadow .3s ease; }
  .top.scrolled { background: rgb(6 32 26 / .97); box-shadow: 0 12px 30px -18px rgb(0 0 0 / .6); }
  .top::after { content: ""; position: absolute; left: 0; bottom: 0; width: 200%; height: 2px; background: linear-gradient(90deg, var(--em), var(--teal), var(--gold), var(--coral), var(--em), var(--teal), var(--gold), var(--coral), var(--em)); animation: ix-line 16s linear infinite; }
  @keyframes ix-line { to { transform: translateX(-50%); } }
  .top .wrap { display: flex; align-items: center; min-height: 66px; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; font: 700 1.1rem/1 "Bricolage Grotesque", sans-serif; letter-spacing: -.02em; text-decoration: none; margin-right: auto; }
  .glyph { position: relative; overflow: hidden; flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: #fff; background: linear-gradient(140deg, var(--em), var(--teal) 55%, var(--gold)); box-shadow: 0 8px 20px -8px rgb(18 184 134 / .8), inset 0 1px 0 rgb(255 255 255 / .35); transition: transform .5s cubic-bezier(.3, 1.6, .5, 1), box-shadow .3s ease; }
  .glyph svg { position: relative; z-index: 1; filter: drop-shadow(0 1px 1px rgb(0 0 0 / .25)); }
  .glint { position: absolute; inset: 0; z-index: 2; overflow: hidden; border-radius: inherit; pointer-events: none; }
  .glint::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 60%; background: linear-gradient(105deg, transparent, rgb(255 255 255 / .15) 30%, rgb(255 255 255 / .95) 50%, rgb(255 255 255 / .15) 70%, transparent); transform: translateX(-130%) skewX(-14deg); animation: ix-sweep 6s ease-in-out infinite 1.2s; }
  @keyframes ix-sweep { 0%, 80% { transform: translateX(-130%) skewX(-14deg); } 100% { transform: translateX(270%) skewX(-14deg); } }
  .brand:hover .glyph { transform: rotate(-10deg) scale(1.1); box-shadow: 0 12px 26px -8px rgb(18 184 134 / .95), 0 0 0 4px rgb(242 179 61 / .35); }
  .brand:hover .glint::before { animation: ix-sweep-now .8s ease-out; }
  @keyframes ix-sweep-now { from { transform: translateX(-130%) skewX(-14deg); } to { transform: translateX(270%) skewX(-14deg); } }
  .brand .word { position: relative; }
  .brand:hover .word { background: linear-gradient(100deg, #fff 0 36%, var(--gold) 46%, #fff8e1 50%, var(--gold) 54%, #fff 64% 100%) 0 0 / 300% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: ix-word 1s ease-out both; }
  @keyframes ix-word { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .top nav { display: flex; gap: 26px; font-size: .93rem; font-weight: 500; }
  .top nav a { text-decoration: none; color: rgb(255 255 255 / .82); position: relative; }
  .top nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--gold), var(--coral)); transform: scaleX(0); transform-origin: left; transition: transform .3s ease; }
  .top nav a:hover { color: #fff; }
  .top nav a:hover::after { transform: scaleX(1); }
  .top-cta { text-decoration: none; font-weight: 700; font-size: .9rem; padding: 10px 18px; border-radius: 999px; color: #1b1205; background: linear-gradient(120deg, var(--gold), #ffc96b); box-shadow: 0 8px 20px -10px rgb(242 179 61 / .9); transition: transform .2s ease, box-shadow .2s ease; }
  .top-cta:hover { transform: translateY(-2px); box-shadow: 0 12px 24px -10px rgb(242 179 61 / 1); }
  @media (max-width: 720px) { .top nav { display: none; } }

  /* ---------------------------------------------------------------- banner */
  .hero { position: relative; isolation: isolate; overflow: clip; color: #fff; background: linear-gradient(160deg, #06201a 0%, #0a2e24 45%, #0b2536 100%); padding-block: clamp(48px, 7vw, 96px) clamp(96px, 10vw, 140px); }
  .aurora { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .aurora i { position: absolute; width: 62vmax; aspect-ratio: 1; border-radius: 50%; }
  .aurora i:nth-child(1) { left: -18vmax; top: -26vmax; background: radial-gradient(closest-side, rgb(18 184 134 / .5), transparent 72%); }
  .aurora i:nth-child(2) { right: -20vmax; top: -18vmax; background: radial-gradient(closest-side, rgb(20 163 184 / .42), transparent 72%); }
  .aurora i:nth-child(3) { right: 0; bottom: -34vmax; background: radial-gradient(closest-side, rgb(242 179 61 / .32), transparent 72%); }
  .aurora i:nth-child(4) { left: 26%; bottom: -40vmax; background: radial-gradient(closest-side, rgb(255 107 74 / .26), transparent 72%); }
  .awake .aurora i:nth-child(1) { animation: ix-drift1 26s ease-in-out infinite alternate; }
  .awake .aurora i:nth-child(2) { animation: ix-drift2 30s ease-in-out infinite alternate; }
  .awake .aurora i:nth-child(3) { animation: ix-drift1 34s ease-in-out infinite alternate-reverse; }
  .awake .aurora i:nth-child(4) { animation: ix-drift2 28s ease-in-out infinite alternate-reverse; }
  @keyframes ix-drift1 { to { transform: translate3d(12vmax, 8vmax, 0) scale(1.15); } }
  @keyframes ix-drift2 { to { transform: translate3d(-10vmax, 10vmax, 0) scale(.9); } }
  .hero-grid { position: absolute; left: -10%; right: -10%; bottom: -10%; height: 55%; z-index: -1; pointer-events: none; background: linear-gradient(rgb(255 255 255 / .07) 1px, transparent 1px) 0 0 / 56px 56px, linear-gradient(90deg, rgb(255 255 255 / .07) 1px, transparent 1px) 0 0 / 56px 56px; transform: perspective(700px) rotateX(62deg); transform-origin: 50% 100%; -webkit-mask: linear-gradient(transparent, #000 70%); mask: linear-gradient(transparent, #000 70%); }
  .hero-glow { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(420px circle at var(--gx, 70%) var(--gy, 30%), rgb(242 179 61 / .16), transparent 65%); }
  .sparks svg { position: absolute; z-index: 0; width: 16px; height: 16px; fill: var(--gold); filter: drop-shadow(0 0 6px rgb(242 179 61 / .8)); opacity: .8; pointer-events: none; }
  .sparks svg:nth-child(1) { left: 6%; top: 18%; } .sparks svg:nth-child(2) { left: 44%; top: 10%; width: 11px; height: 11px; } .sparks svg:nth-child(3) { left: 52%; bottom: 22%; width: 20px; height: 20px; fill: #fff; }
  .sparks svg:nth-child(4) { right: 4%; top: 40%; width: 12px; height: 12px; } .sparks svg:nth-child(5) { left: 30%; bottom: 14%; width: 10px; height: 10px; fill: var(--em); } .sparks svg:nth-child(6) { right: 30%; top: 6%; width: 14px; height: 14px; fill: var(--coral); }
  .awake .sparks svg { animation: ix-twinkle 3.4s ease-in-out infinite; }
  .awake .sparks svg:nth-child(2n) { animation-delay: -1.2s; } .awake .sparks svg:nth-child(3n) { animation-delay: -2.1s; }
  @keyframes ix-twinkle { 0%, 100% { transform: scale(.5) rotate(0deg); opacity: .4; } 50% { transform: scale(1.15) rotate(90deg); opacity: 1; } }

  .hero-in { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .kicker { display: inline-flex; align-items: center; gap: 10px; font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: rgb(255 255 255 / .9); padding: 9px 14px; border-radius: 999px; background: rgb(255 255 255 / .08); border: 1px solid rgb(255 255 255 / .16); margin-bottom: 26px; }
  .live { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--em); flex: none; }
  .live::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--em); animation: ix-pulse 2s ease-out infinite; }
  @keyframes ix-pulse { from { transform: scale(1); opacity: .7; } to { transform: scale(3.2); opacity: 0; } }
  .hero h1 { font-size: clamp(2.7rem, 6.6vw, 5.8rem); font-weight: 750; letter-spacing: -.045em; line-height: .95; color: #fff; }
  .hero h1 em { font-style: normal; background: linear-gradient(100deg, #ffd27a 0%, var(--gold) 30%, var(--coral) 60%, #ffb38a 80%, #ffd27a 100%) 0 0 / 200% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .awake .hero h1 em { animation: ix-shine 6s ease-in-out infinite alternate; }
  @keyframes ix-shine { to { background-position: 100% 0; } }
  .lede { font-size: clamp(1.08rem, 1.5vw, 1.3rem); color: rgb(255 255 255 / .84); max-width: 36em; margin-top: 26px; line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .btn { position: relative; overflow: hidden; isolation: isolate; display: inline-flex; align-items: center; gap: 10px; padding: 15px 24px; border-radius: 999px; font-weight: 700; text-decoration: none; border: 2px solid transparent; transition: transform .2s ease, box-shadow .25s ease; }
  .btn::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 50%; z-index: -1; background: linear-gradient(105deg, transparent, rgb(255 255 255 / .55), transparent); transform: translateX(-140%) skewX(-14deg); transition: transform .7s ease; }
  .btn:hover { transform: translateY(-2px); }
  .btn:hover::after { transform: translateX(260%) skewX(-14deg); }
  .btn.shine { color: #1b1205; background: linear-gradient(120deg, #ffd27a, var(--gold) 45%, #ff9a5a); box-shadow: 0 14px 30px -14px rgb(242 179 61 / .95); }
  .btn.glass { color: #fff; background: rgb(255 255 255 / .08); border-color: rgb(255 255 255 / .32); }
  .btn.glass:hover { border-color: #fff; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 10px; margin: 38px 0 0; max-width: 640px; }
  .stats div { padding: 14px 16px; border-radius: 18px; min-width: 0; background: linear-gradient(150deg, rgb(255 255 255 / .1), rgb(255 255 255 / .03)); border: 1px solid rgb(255 255 255 / .15); transition: transform .3s ease, border-color .3s ease; }
  .stats div:hover { transform: translateY(-3px); border-color: rgb(242 179 61 / .6); }
  .stats dt { font: 750 2.1rem/1 "Bricolage Grotesque", sans-serif; letter-spacing: -.03em; font-variant-numeric: tabular-nums; color: #fff; }
  .stats div:nth-child(2) dt { color: #ffd27a; } .stats div:nth-child(3) dt { color: #7ee8c4; } .stats div:nth-child(4) dt { color: #ffb38a; }
  .stats dd { margin: 6px 0 0; color: rgb(255 255 255 / .78); font-size: .82rem; line-height: 1.3; }

  /* The showcase wall: real concepts drifting in tilted columns. */
  .wall { position: relative; height: clamp(420px, 44vw, 600px); perspective: 1400px; -webkit-mask: linear-gradient(transparent, #000 14%, #000 86%, transparent); mask: linear-gradient(transparent, #000 14%, #000 86%, transparent); }
  .wall-tilt { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; height: 140%; margin-top: -20%; transform: rotateX(14deg) rotateY(-16deg) rotateZ(-8deg); transform-style: preserve-3d; }
  .wtrack { display: grid; gap: 16px; }
  .wcol.c1 { margin-top: -90px; } .wcol.c2 { margin-top: -30px; }
  .awake .wcol.c0 .wtrack { animation: ix-up 46s linear infinite; }
  .awake .wcol.c1 .wtrack { animation: ix-down 54s linear infinite; }
  .awake .wcol.c2 .wtrack { animation: ix-up 40s linear infinite; }
  .wall:hover .wtrack { animation-play-state: paused; }
  @keyframes ix-up { to { transform: translateY(-50%); } }
  @keyframes ix-down { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  .wall figure { position: relative; margin: 0; border-radius: 14px; overflow: hidden; aspect-ratio: 440 / 296; background: var(--tone); box-shadow: 0 24px 40px -22px rgb(0 0 0 / .8), 0 0 0 1px rgb(255 255 255 / .1); transition: transform .4s cubic-bezier(.2, .7, .2, 1), box-shadow .4s ease; }
  .wall figure img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .wall figure:hover { transform: scale(1.06) translateZ(30px); box-shadow: 0 30px 50px -20px rgb(0 0 0 / .85), 0 0 0 2px var(--gold); }
  .wall figcaption { position: absolute; left: 8px; bottom: 8px; font-size: .68rem; font-weight: 700; letter-spacing: .04em; padding: 4px 8px; border-radius: 999px; color: #fff; background: rgb(6 32 26 / .78); backdrop-filter: blur(4px); }
  .hero-wave { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(46px, 6vw, 90px); fill: var(--bg); z-index: 1; }

  @media (max-width: 980px) {
    .hero-in { grid-template-columns: minmax(0, 1fr); }
    .wall { height: 340px; margin-inline: calc(var(--gutter) * -1); overflow: hidden; }
    .wall-tilt { width: 130%; margin-left: -15%; grid-template-columns: repeat(3, minmax(0, 1fr)); transform: rotateX(12deg) rotateZ(-6deg); }
  }

  /* The ribbon: what kinds of businesses, and where. */
  .ribbon { position: relative; z-index: 2; height: clamp(110px, 11vw, 140px); margin-top: -46px; overflow: hidden; pointer-events: none; }
  .ribbon .band { position: absolute; left: -4%; right: -4%; top: 50%; overflow: hidden; box-shadow: 0 18px 40px -22px rgb(0 0 0 / .5); }
  .ribbon .b1 { transform: translateY(-50%) rotate(-2.4deg); background: linear-gradient(100deg, var(--gold), #ff9a5a, var(--coral)); color: #1b1205; }
  .ribbon .b2 { transform: translateY(-50%) rotate(1.8deg); background: linear-gradient(100deg, #0b5e47, #0e6f7d); color: #fff; }
  .ribbon .track { display: flex; width: max-content; }
  .awake .ribbon .b1 .track { animation: ix-marquee 44s linear infinite; }
  .awake .ribbon .b2 .track { animation: ix-marquee 60s linear infinite reverse; }
  @keyframes ix-marquee { to { transform: translateX(-50%); } }
  .ribbon span { display: inline-flex; align-items: center; gap: 18px; padding: 14px 18px; white-space: nowrap; font: 750 clamp(.95rem, 1.5vw, 1.2rem)/1 "Bricolage Grotesque", sans-serif; text-transform: uppercase; letter-spacing: .04em; }
  .ribbon .b2 span { font-size: clamp(.78rem, 1.1vw, .92rem); letter-spacing: .14em; padding-block: 11px; }
  .ribbon i { font-style: normal; opacity: .8; }

  /* ------------------------------------------------------------- concepts */
  .concepts { position: relative; padding-block: clamp(28px, 4vw, 56px) clamp(64px, 8vw, 112px); }
  .concepts::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(50% 40% at 0% 10%, rgb(18 184 134 / .1), transparent 70%), radial-gradient(45% 35% at 100% 30%, rgb(255 107 74 / .09), transparent 70%), radial-gradient(40% 30% at 20% 80%, rgb(124 92 255 / .07), transparent 70%), radial-gradient(50% 35% at 90% 95%, rgb(242 179 61 / .12), transparent 70%); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-bottom: 30px; }
  .bar h2, .included h2, .how h2 { font-size: clamp(1.9rem, 3.4vw, 2.9rem); font-weight: 750; }
  .bar h2 em, .how h2 em { font-style: normal; background: linear-gradient(100deg, #0d7a5b, #0e7489 55%, #9a5a0a); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .bar h2 { margin-right: auto; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; flex: 1 1 100%; order: 3; }
  .chip { font: 600 .88rem/1 "Inter", sans-serif; color: var(--ct, var(--ink)); background: color-mix(in srgb, var(--c, #8a8f92) 11%, #fff); border: 1.5px solid color-mix(in srgb, var(--c, #8a8f92) 38%, transparent); border-radius: 999px; padding: 10px 14px; cursor: pointer; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .chip span { opacity: .75; margin-left: 4px; font-variant-numeric: tabular-nums; }
  .chip:hover { transform: translateY(-2px); box-shadow: 0 8px 18px -10px var(--c, #444); }
  .chip.on { background: var(--cs, var(--ink)); color: #fff; border-color: var(--cs, var(--ink)); box-shadow: 0 8px 20px -10px var(--c, #000); }
  .chip.on span { color: #fff; opacity: .85; }
  .search { font: 400 .95rem/1 "Inter", sans-serif; color: var(--ink); background: var(--surface); border: 1.5px solid var(--line); border-radius: 999px; padding: 11px 16px; min-width: min(100%, 260px); }
  .search:focus { outline: 3px solid var(--em); outline-offset: 2px; border-color: transparent; }
  .empty { color: var(--muted); padding: 28px 0; }
  .switch { display: inline-flex; align-items: center; gap: 10px; font-size: .9rem; font-weight: 600; cursor: pointer; user-select: none; }
  .switch input { position: absolute; opacity: 0; pointer-events: none; }
  .switch span { width: 44px; height: 25px; border-radius: 999px; background: #cfc9bb; position: relative; transition: background .2s; flex: none; }
  .switch span::after { content: ""; position: absolute; top: 3px; left: 3px; width: 19px; height: 19px; border-radius: 50%; background: #fff; transition: translate .25s cubic-bezier(.3, 1.4, .5, 1); box-shadow: 0 1px 3px rgb(0 0 0 / .3); }
  .switch input:checked + span { background: linear-gradient(120deg, var(--coral), var(--gold)); }
  .switch input:checked + span::after { translate: 19px 0; }
  .switch input:focus-visible + span { outline: 3px solid var(--em); outline-offset: 3px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr)); gap: 30px 24px; }
  .card { position: relative; }
  .card[hidden] { display: none; }
  .card a { display: block; text-decoration: none; }
  .shot { position: relative; aspect-ratio: 1120 / 753; border-radius: 16px; overflow: hidden; background: var(--tone, #ddd); border: 1px solid var(--line); box-shadow: 0 1px 2px rgb(0 0 0 / .04), 0 14px 34px -18px rgb(0 0 0 / .3); transition: translate .3s cubic-bezier(.2, .7, .2, 1), box-shadow .3s ease; }
  .card a:hover .shot { translate: 0 -6px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--tone) 40%, transparent), 0 30px 50px -22px color-mix(in srgb, var(--tone) 80%, transparent), 0 10px 40px -12px color-mix(in srgb, var(--tone2) 55%, transparent); }
  @property --ring { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  .shot::after { content: ""; position: absolute; inset: 0; z-index: 3; border-radius: inherit; padding: 2.5px; background: conic-gradient(from var(--ring), var(--tone), var(--tone2), var(--gold), var(--tone)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s ease; animation: ix-ring 3.5s linear infinite paused; pointer-events: none; }
  .card a:hover .shot::after, .card a:focus-visible .shot::after { opacity: 1; animation-play-state: running; }
  @keyframes ix-ring { to { --ring: 360deg; } }
  .shot::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 45%; z-index: 2; pointer-events: none; background: linear-gradient(105deg, transparent, rgb(255 255 255 / .35), transparent); transform: translateX(-140%) skewX(-14deg); transition: transform .8s ease; }
  .card a:hover .shot::before { transform: translateX(300%) skewX(-14deg); }
  .shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: opacity .35s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
  .card a:hover .shot img { transform: scale(1.05); }
  .shot .before { opacity: 0; }
  .show-before .shot .before { opacity: 1; }
  .shot .blank { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font: 700 1.5rem/1.1 "Bricolage Grotesque", sans-serif; text-align: center; padding: 20px; }
  .tag { position: absolute; left: 12px; bottom: 12px; z-index: 4; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; background: rgb(20 24 26 / .82); color: #fff; backdrop-filter: blur(6px); transition: opacity .35s ease; }
  .before-tag { opacity: 0; background: rgb(150 60 30 / .92); }
  .show-before .before-tag { opacity: 1; }
  .show-before .after-tag { opacity: 0; }
  .meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; padding: 16px 4px 0; }
  .meta h3 { font-size: 1.16rem; font-weight: 700; letter-spacing: -.015em; line-height: 1.2; display: flex; align-items: center; gap: 9px; }
  .dots { display: inline-flex; flex: none; }
  .dots i { width: 13px; height: 13px; border-radius: 50%; box-shadow: 0 0 0 2px var(--bg); }
  .dots i + i { margin-left: -4px; }
  .meta p { color: var(--muted); font-size: .9rem; margin-top: 5px; }
  .kind { display: inline-block; margin-top: 8px; font-size: .72rem; font-weight: 700; letter-spacing: .04em; padding: 4px 10px; border-radius: 999px; background: linear-gradient(120deg, rgb(18 184 134 / .16), rgb(20 163 184 / .14)); color: #0b5a43; }
  .report-link { display: inline-flex; align-items: center; gap: 6px; margin: 10px 4px 0; font-size: .86rem; font-weight: 700; color: #0b5a43; text-decoration: none; }
  .report-link:hover { text-decoration: underline; }
  .report-link .icon { transition: transform .25s ease; }
  .report-link:hover .icon { transform: translateX(4px); }
  .go { width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid var(--line); display: grid; place-items: center; flex: none; background: var(--surface); transition: background .25s, color .25s, border-color .25s, transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .card a:hover .go { background: var(--ink); color: #fff; border-color: var(--ink); transform: rotate(45deg); }
  .motion .card.reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s cubic-bezier(.2, .7, .2, 1) var(--d, 0ms), transform .8s cubic-bezier(.2, .7, .2, 1) var(--d, 0ms); }
  .motion .card.reveal.in { opacity: 1; transform: none; }

  /* ------------------------------------------------------- what's included */
  .included { position: relative; isolation: isolate; overflow: clip; color: #eef6f2; padding-block: clamp(72px, 9vw, 124px); background: linear-gradient(150deg, #0a3a2c 0%, #0b4a44 50%, #13324a 100%); }
  .aurora.soft i { width: 46vmax; }
  .aurora.soft i:nth-child(1) { left: -12vmax; top: -20vmax; background: radial-gradient(closest-side, rgb(18 184 134 / .38), transparent 72%); }
  .aurora.soft i:nth-child(2) { right: -14vmax; top: 10%; background: radial-gradient(closest-side, rgb(124 92 255 / .28), transparent 72%); }
  .aurora.soft i:nth-child(3) { left: 30%; bottom: -30vmax; right: auto; background: radial-gradient(closest-side, rgb(242 179 61 / .22), transparent 72%); }
  .included h2 em { font-style: normal; color: #ffd27a; }
  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 18px; margin-top: 44px; }
  .features li { padding: 26px; border-radius: 20px; background: linear-gradient(150deg, rgb(255 255 255 / .09), rgb(255 255 255 / .03)); border: 1px solid rgb(255 255 255 / .13); transition: transform .35s cubic-bezier(.2, .7, .2, 1), border-color .35s ease, box-shadow .35s ease; }
  .features li:hover { transform: translateY(-6px); border-color: color-mix(in srgb, var(--c) 70%, transparent); box-shadow: 0 24px 44px -24px color-mix(in srgb, var(--c) 90%, transparent); }
  .features .ico { position: relative; overflow: hidden; width: 50px; height: 50px; border-radius: 14px; display: grid; place-items: center; margin-bottom: 18px; color: #fff; background: linear-gradient(140deg, var(--c), color-mix(in srgb, var(--c) 60%, #000)); box-shadow: 0 10px 22px -10px var(--c), inset 0 1px 0 rgb(255 255 255 / .3); }
  .features .ico .icon { position: relative; z-index: 1; }
  .features .ico .glint::before { animation: none; }
  .features li:hover .ico .glint::before { animation: ix-sweep-now .8s ease-out; }
  .features h3 { font-size: 1.24rem; font-weight: 700; margin-bottom: 8px; color: #fff; }
  .features p { color: rgb(238 246 242 / .82); font-size: .98rem; }

  /* ---------------------------------------------------------- how it works */
  .how { position: relative; padding-block: clamp(72px, 9vw, 124px); }
  .how ol { counter-reset: n; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 22px; margin-top: 44px; }
  .how li { counter-increment: n; position: relative; padding: 28px 26px 26px; border-radius: 20px; background: rgb(255 255 255 / .75); border: 1px solid var(--line); box-shadow: 0 18px 40px -30px rgb(0 0 0 / .4); transition: transform .35s cubic-bezier(.2, .7, .2, 1), box-shadow .35s ease; }
  .how li:hover { transform: translateY(-6px); box-shadow: 0 26px 50px -28px rgb(0 0 0 / .45); }
  .how li::before { content: counter(n, decimal-leading-zero); display: block; font: 800 3.2rem/1 "Bricolage Grotesque", sans-serif; letter-spacing: -.04em; background: linear-gradient(120deg, #0d7a5b, #0e7489 45%, #c2410c); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .how li::after { content: ""; position: absolute; left: 26px; right: 26px; top: 0; height: 4px; border-radius: 0 0 4px 4px; background: linear-gradient(90deg, var(--em), var(--teal), var(--gold), var(--coral)); }
  .how li h3 { font-size: 1.28rem; font-weight: 700; margin: 14px 0 8px; }
  .how li p { color: var(--muted); }
