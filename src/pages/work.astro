---
// Other sites and apps the studio is building, beyond the business concepts.
// Add a project to src/data/work.json and drop a 960x600 screenshot in public/work/<slug>.webp.
import { site } from '../lib/site';
import fonts from '../lib/fonts.json';
import work from '../data/work.json';

const display = (fonts as Record<string, { family: string; normal: string }>)['bricolage-grotesque'];
const body = (fonts as Record<string, { family: string; normal: string }>).inter;
const fontCss = [display, body].map((f) => `@font-face{font-family:"${f.family}";src:url(${f.normal}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}`).join('');
const host = (u: string) => new URL(u).hostname;
const title = `Work in progress · ${site.name}`;
const description = `Other sites and apps ${site.contactName || site.name} is building, alongside the website concepts for Aiken-area businesses.`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b2a20" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {site.url && <link rel="canonical" href={`${site.url}/work/`} />}
    {site.url && <meta property="og:url" content={`${site.url}/work/`} />}
    {site.url && <meta property="og:image" content={`${site.url}/og.jpg`} />}
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#143d2f"/><path d="M9 22 16 9l7 13" fill="none" stroke="#f3e9c9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>')}`} />
    <link rel="preload" href={display.normal} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={body.normal} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/"><span class="glyph"><svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true"><path d="M7 24 16 7l9 17" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{site.name}</span></a>
        <a class="back" href="/#concepts">All business concepts</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow">Work in progress</p>
          <h1>Other things <em>I'm building</em></h1>
          <p class="lede">Apps and sites in the works alongside the {site.name} concepts. Every one is live, and some are early demos, so expect rough edges.</p>
        </div>
      </section>

      <section class="list" aria-label="Projects">
        <div class="wrap">
          <ul class="grid">
            {work.map((p, i) => (
              <li class="card" style={`--i:${i}`}>
                <a href={p.url} target="_blank" rel="noopener">
                  <span class="shot"><img src={`/work/${p.slug}.webp`} width="960" height="600" alt={`The ${p.name} home page`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></span>
                  <span class="meta">
                    <span class="kind">{p.kind}</span>
                    <span class="name">{p.name}</span>
                    <span class="blurb">{p.blurb}</span>
                    <span class="host">{host(p.url)}</span>
                    <span class="visit">Visit the site<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr"> (opens in a new tab)</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <p><strong>{site.name}</strong>: {site.tagline}</p>
        {(site.contactPhone || site.contactEmail) && <p>{site.contactPhone && <a href={`tel:+1${site.contactPhone.replace(/\D/g, '').slice(-10)}`}>{site.contactPhone}</a>}{site.contactPhone && site.contactEmail && <span aria-hidden="true"> · </span>}{site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</p>}
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root { --bg: #f7f3ea; --surface: #ffffff; --ink: #14181a; --muted: #4f5a60; --line: #e5dfd1; --night: #06201a; --em: #12b886; --gold: #f2b33d; --coral: #ff6b4a; --cream: #f3e9c9; --wrap: 1180px; --gutter: clamp(20px, 4.5vw, 44px); }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.6 "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
  h1 { font-family: "Bricolage Grotesque", "Inter", system-ui, sans-serif; margin: 0; line-height: 1.02; letter-spacing: -.035em; text-wrap: balance; }
  p { margin: 0; }
  a { color: inherit; }
  img { display: block; max-width: 100%; height: auto; }
  ul { list-style: none; margin: 0; padding: 0; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }
  .wrap { width: min(100% - var(--gutter) * 2, var(--wrap)); margin-inline: auto; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .top { position: sticky; top: 0; z-index: 10; color: #fff; background: rgb(6 32 26 / .95); backdrop-filter: blur(12px); }
  .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font: 700 1.05rem/1 "Bricolage Grotesque", sans-serif; text-decoration: none; }
  .glyph { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; color: var(--night); background: linear-gradient(135deg, var(--cream), var(--gold)); }
  .back { font-weight: 600; font-size: .95rem; text-underline-offset: 4px; text-decoration-color: var(--em); text-decoration-thickness: 2px; min-height: 44px; display: inline-flex; align-items: center; }

  .hero { color: #fff; background: radial-gradient(60vmax 40vmax at 15% 0%, rgb(18 184 134 / .35), transparent 70%), radial-gradient(50vmax 40vmax at 95% 20%, rgb(242 179 61 / .22), transparent 70%), linear-gradient(160deg, #06201a, #0a2e24 55%, #0b2536); padding-block: clamp(56px, 9vw, 112px) clamp(64px, 9vw, 120px); }
  .eyebrow { display: inline-block; font: 700 .78rem/1 "Inter", sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--night); background: var(--gold); border-radius: 999px; padding: 8px 12px; margin-bottom: 18px; }
  .hero h1 { font-size: clamp(2.4rem, 6.4vw, 4.6rem); max-width: 16ch; }
  .hero h1 em { font-style: normal; background: linear-gradient(100deg, #ffd27a, #f2b33d 45%, #ff8a5a); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { margin-top: 18px; max-width: 56ch; font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: rgb(255 255 255 / .86); }

  .list { margin-top: clamp(-56px, -5vw, -36px); padding-bottom: clamp(56px, 8vw, 96px); }
  .grid { display: grid; gap: clamp(18px, 2.4vw, 28px); grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .card a { display: flex; flex-direction: column; height: 100%; text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; box-shadow: 0 24px 48px -32px rgb(6 32 26 / .55); transition: transform .25s ease, box-shadow .25s ease; }
  .card a:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -30px rgb(6 32 26 / .6); }
  .shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--line); background: #e9e4d8; }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s ease; }
  .card a:hover .shot img { transform: scale(1.035); }
  .meta { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 22px; flex: 1; }
  .kind { align-self: flex-start; font: 700 .74rem/1 "Inter", sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #0d5c44; background: rgb(18 184 134 / .12); border-radius: 999px; padding: 6px 10px; }
  .name { font: 700 1.45rem/1.1 "Bricolage Grotesque", sans-serif; letter-spacing: -.02em; }
  .blurb { color: var(--muted); }
  .host { margin-top: auto; padding-top: 6px; font-size: .86rem; color: var(--muted); overflow-wrap: anywhere; }
  .visit { padding-top: 2px; display: inline-flex; align-items: center; gap: 6px; font-weight: 650; text-decoration: underline; text-decoration-color: var(--em); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .card { animation: rise .7s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 80ms); }
  @keyframes rise { from { transform: translateY(16px); } }

  .foot { background: var(--night); color: rgb(255 255 255 / .86); padding-block: 36px; font-size: .95rem; }
  .foot .wrap { display: grid; gap: 8px; }
  .foot a { color: #fff; text-underline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
