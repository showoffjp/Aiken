---
import { site } from '../lib/site';
import { client } from '../lib/client';
import { demos } from '../lib/demos';
// On a launched business site the way back is that business's home page.
const biz = client ? demos[0] : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found</title>
    <meta name="description" content={biz ? `This page does not exist. Go back to ${biz.name}.` : 'This page does not exist. Browse the website concepts from the home page.'} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 24px; isolation: isolate; overflow: hidden; color: #fff; background: linear-gradient(160deg, #06201a 0%, #0a2e24 45%, #0b2536 100%); font: 400 1.05rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      body::before { content: ""; position: fixed; inset: -20vmax; z-index: -1; pointer-events: none; background: radial-gradient(36vmax 36vmax at 18% 22%, rgb(18 184 134 / .4), transparent 70%), radial-gradient(32vmax 32vmax at 84% 30%, rgb(20 163 184 / .32), transparent 70%), radial-gradient(38vmax 38vmax at 60% 92%, rgb(242 179 61 / .24), transparent 70%); animation: drift 24s ease-in-out infinite alternate; }
      @keyframes drift { to { transform: translate3d(4%, -3%, 0) rotate(8deg) scale(1.06); } }
      h1 { font-size: clamp(2.2rem, 7vw, 4rem); letter-spacing: -.04em; line-height: 1; margin: 0 0 14px; }
      h1 em { font-style: normal; background: linear-gradient(100deg, #ffd27a, #f2b33d 40%, #ff6b4a); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
      p { color: rgb(255 255 255 / .85); margin: 0 0 28px; }
      a { position: relative; overflow: hidden; isolation: isolate; display: inline-block; padding: 15px 24px; border-radius: 999px; color: #1b1205; font-weight: 700; text-decoration: none; background: linear-gradient(120deg, #ffd27a, #f2b33d 45%, #ff9a5a); box-shadow: 0 14px 30px -14px rgb(242 179 61 / .95); transition: transform .2s ease; }
      a::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 50%; z-index: -1; background: linear-gradient(105deg, transparent, rgb(255 255 255 / .55), transparent); transform: translateX(-140%) skewX(-14deg); transition: transform .7s ease; }
      a:hover { transform: translateY(-2px); }
      a:hover::after { transform: translateX(260%) skewX(-14deg); }
      main > * { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
      p { animation-delay: .08s; } a { animation-delay: .16s; }
      @keyframes rise { from { transform: translateY(18px); } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <main>
      <h1>That page <em>isn't here.</em></h1>
      <p>{biz ? 'It may have moved, or the link may be old.' : 'The concept may have been renamed or retired.'}</p>
      <a href="/">{biz ? `Back to ${biz.name}` : `See all concepts from ${site.name}`}</a>
    </main>
  </body>
</html>
