---
import { site } from '../lib/site';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found</title>
    <meta name="description" content="This page does not exist. Browse the website concepts from the home page." />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #faf8f3; color: #14181a; font: 400 1.05rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; text-align: center; padding: 24px; }
      h1 { font-size: clamp(2rem, 6vw, 3.4rem); letter-spacing: -.03em; margin: 0 0 12px; }
      p { color: #5b6468; margin: 0 0 24px; }
      a { position: relative; overflow: hidden; isolation: isolate; display: inline-block; padding: 14px 22px; border-radius: 999px; background: #143d2f; color: #f3e9c9; font-weight: 600; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
      a::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / .25) 50%, transparent 70%); translate: -120% 0; transition: translate .7s ease; }
      a:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -12px rgb(20 61 47 / .7); }
      a:hover::after { translate: 120% 0; }
      body { isolation: isolate; overflow: hidden; }
      body::before { content: ""; position: fixed; inset: -25vmax; z-index: -1; pointer-events: none; background: radial-gradient(38vmax 38vmax at 15% 20%, rgb(31 106 80 / .16), transparent 70%), radial-gradient(34vmax 34vmax at 85% 30%, rgb(214 168 72 / .18), transparent 70%), radial-gradient(44vmax 44vmax at 50% 90%, rgb(20 61 47 / .1), transparent 70%); animation: drift 22s ease-in-out infinite alternate; }
      @keyframes drift { 0% { transform: translate3d(0, 0, 0) rotate(0deg) scale(1); } 50% { transform: translate3d(5%, -4%, 0) rotate(10deg) scale(1.08); } 100% { transform: translate3d(-5%, 4%, 0) rotate(-8deg) scale(1.04); } }
      h1 { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
      p { animation: rise .8s cubic-bezier(.2, .7, .2, 1) .1s both; }
      a { animation: rise .8s cubic-bezier(.2, .7, .2, 1) .2s both; }
      @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <main>
      <h1>That page isn't here.</h1>
      <p>The concept may have been renamed or retired.</p>
      <a href="/">See all concepts from {site.name}</a>
    </main>
  </body>
</html>
